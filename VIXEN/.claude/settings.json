{
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ninja:*)",
      "Bash(msbuild:*)",
      "Bash(conan:*)",
      "Bash(vcpkg:*)",
      "Bash(glslc:*)",
      "Bash(spirv-val:*)",
      "Bash(glslangValidator:*)",
      "Bash(/c/VulkanSDK/:*)",
      "Bash(C:/VulkanSDK/:*)",
      "Bash(taskkill /F /IM MSBuild.exe:*)",
      "Bash(taskkill /F /IM cl.exe:*)",
      "Bash(taskkill /F /IM ninja.exe:*)",
      "Bash(taskkill /F /IM cmake.exe:*)",
      "Bash(taskkill /F /IM glslc.exe:*)",
      "Bash(taskkill /F /IM VIXEN.exe:*)",
      "Bash(taskkill /F /IM vixen_editor.exe:*)",
      "Bash(taskkill /F /IM sccache.exe:*)",
      "Bash(timeout:*)",
      "Bash(./build/:*)",
      "Bash(./binaries/:*)",
      "Bash(./*.exe:*)",
      "Bash(pkill -f vixen_editor*)",
      "Bash(pkill -f vixen_benchmark*)",
      "Bash(pkill -f VIXEN.exe*)",
      "Bash(tasklist:*)",
      "Bash(sccache.exe:*)",
      "Bash(cmd.exe /c:*)",
      "Bash(cmd.exe /C:*)",
      "Bash(codegraph explore:*)",
      "Bash(codegraph:*)",
      "Bash(git worktree list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(pgrep:*)",
      "Bash(ctest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Read(C:/cpp/**)",
      "Edit(C:/cpp/**)",
      "Write(C:/cpp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/cpp/VBVS--VIXEN/VIXEN/.claude/hooks/pre-commit-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/cpp/VBVS--VIXEN/VIXEN/.claude/hooks/permission-request-notify.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "anthropic-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "enabledPlugins": {
    "agent-sdk-dev@anthropic-plugins": true,
    "claude-opus-4-5-migration@anthropic-plugins": true,
    "code-review@anthropic-plugins": true,
    "commit-commands@anthropic-plugins": true,
    "explanatory-output-style@anthropic-plugins": true,
    "feature-dev@anthropic-plugins": true,
    "hookify@anthropic-plugins": true,
    "pr-review-toolkit@anthropic-plugins": true,
    "ralph-wiggum@anthropic-plugins": true,
    "security-guidance@anthropic-plugins": true
  },
  "installedPluginVersions": {
    "agent-sdk-dev@anthropic-plugins": "0.0.0",
    "claude-opus-4-5-migration@anthropic-plugins": "1.0.0",
    "code-review@anthropic-plugins": "1.0.0",
    "commit-commands@anthropic-plugins": "1.0.0",
    "explanatory-output-style@anthropic-plugins": "1.0.0",
    "feature-dev@anthropic-plugins": "1.0.0",
    "hookify@anthropic-plugins": "0.1.0",
    "pr-review-toolkit@anthropic-plugins": "1.0.0",
    "ralph-wiggum@anthropic-plugins": "1.0.0",
    "security-guidance@anthropic-plugins": "1.0.0"
  }
}
