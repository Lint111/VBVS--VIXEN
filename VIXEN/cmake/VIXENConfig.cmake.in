@PACKAGE_INIT@

# ============================================================================
# VIXENConfig.cmake — package config for find_package(VIXEN) (AR#2)
#
# Lets an external CMake project (e.g. the UNDERTOW host) consume a *prebuilt,
# installed* VIXEN as imported Vixen::* targets:
#
#     find_package(VIXEN REQUIRED)
#     target_link_libraries(my_host PRIVATE Vixen::RenderGraph)
#
# This file re-creates VIXEN's external dependencies (so the imported targets'
# INTERFACE_LINK_LIBRARIES resolve) and then pulls in the exported target set.
# ============================================================================

include(CMakeFindDependencyMacro)

# --- External dependencies of the exported targets ---------------------------
# This is a FAT SDK: every vendored/FetchContent dependency (glm, glfw, stb, VMA,
# magic_enum, nlohmann_json, miniz, rmlui_core, ProjectHash) is BUNDLED into
# VixenTargets as a Vixen::* imported target with its headers installed alongside,
# so the consumer does NOT find_dependency() them. Only the genuinely-external,
# find_package-imported deps need resolving from the consumer's environment:
find_dependency(Threads)
find_dependency(Vulkan)
# VIXEN links some Vulkan SDK static libs (vulkan-1, glslang, SPIRV-Tools) by BARE NAME
# plus a link_directories() — which is directory-scoped and does NOT propagate through the
# export. Re-expose that directory, derived from the consumer's own resolved Vulkan loader
# (Vulkan_LIBRARY = .../Lib/vulkan-1.lib), so its linker can find the bare-named libs.
if(Vulkan_LIBRARY)
    get_filename_component(_vixen_vulkan_libdir "${Vulkan_LIBRARY}" DIRECTORY)
    link_directories("${_vixen_vulkan_libdir}")
endif()
find_dependency(TBB)

# gli / freetype / gaia ship their OWN package configs INSIDE this SDK prefix (their
# FetchContent install rules export configs + headers, unlike the deps bundled directly
# into VixenTargets). They resolve from the SDK itself — still no external requirement.
# CONFIG mode forced: these ship configs inside the SDK. Without it, find_package(freetype)
# would hit CMake's built-in module FindFreetype.cmake (case-insensitive match on Windows)
# and look for a system freetype instead of the bundled one.
find_dependency(gli CONFIG)
find_dependency(freetype CONFIG)
# gaia's generated gaia-config.cmake is broken upstream — set_and_check(gaia_INCLUDE_DIR "")
# with an empty path fails the existence check. Its gaia-targets.cmake is fine and
# self-contained (bakes ${_IMPORT_PREFIX}/include), so include it directly to get the
# gaia::gaia imported target without tripping the broken config.
include("${CMAKE_CURRENT_LIST_DIR}/../gaia/gaia-targets.cmake")

# --- The exported VIXEN target set (includes the bundled Vixen::* deps) -------
include("${CMAKE_CURRENT_LIST_DIR}/VixenTargets.cmake")

check_required_components(VIXEN)
