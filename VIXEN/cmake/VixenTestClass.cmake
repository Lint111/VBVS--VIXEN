# VixenTestClass.cmake
#
# Derives each CTest entry's GPU need instead of listing it by hand.
#
#   1. Link closure (this file, at generate time). An executable is `gpu` when its transitive link
#      closure reaches the Vulkan loader, or a library whose own sources create a Vulkan instance or
#      device, allocate device memory or submit to a queue (vkCreateInstance, vkCreateDevice,
#      vkAllocateMemory, vkQueueSubmit*, vmaCreateAllocator). Otherwise it is `cpu`. The result is the
#      VIXEN_TEST_CLASS target property and the exe-classes.tsv table.
#   2. Runtime manifest (tests/gpu-class-manifest.tsv, written by tools/classify-tests-gpu.py). A test
#      the manifest knows, and whose executable sources are unchanged since the manifest was written,
#      takes the manifest's class: what the test did when it ran. VixenTestClassApply.cmake applies
#      it when CTest loads each directory (GoogleTest cases do not exist before then). Tests the
#      manifest does not know, or whose sources changed, keep the link guess.
#
# Every test ends up with a `gpu` or `cpu` label, a `classified-by-run` or `classified-by-link`
# label, and VIXEN_TEST_CLASS in its environment. With the Vulkan witness layer enabled (Linux), a
# `cpu` test that creates a Vulkan instance or device exits with a named diagnostic.

set(VIXEN_TEST_CLASS_DIR "${CMAKE_CURRENT_BINARY_DIR}/vixen-test-classes")
set(VIXEN_TEST_CLASS_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/../tests/gpu-class-manifest.tsv")
get_filename_component(VIXEN_TEST_CLASS_MANIFEST "${VIXEN_TEST_CLASS_MANIFEST}" ABSOLUTE)
set(VIXEN_GPU_WITNESS_LAYER_DIR "${CMAKE_CURRENT_BINARY_DIR}/gpu-witness-layer")
set(_VIXEN_TEST_CLASS_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(_VIXEN_TEST_CLASS_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")

set(_VIXEN_DEVICE_CALL_REGEX "^[^/]*(vkCreateInstance|vkCreateDevice|vkAllocateMemory|vkQueueSubmit|vmaCreateAllocator)[ \t]*\\(")

# Environment entries that load the witness layer into every test process (Linux).
function(vixen_test_class_environment_modification output_variable)
    set(_entries)
    if(UNIX AND NOT APPLE AND TARGET vixen_gpu_witness_layer)
        list(APPEND _entries
            "VIXEN_GPU_WITNESS=set:1"
            "VK_ADD_IMPLICIT_LAYER_PATH=path_list_prepend:${VIXEN_GPU_WITNESS_LAYER_DIR}")
    endif()
    set(${output_variable} "${_entries}" PARENT_SCOPE)
endfunction()

# Labels every case in `list_variable` (set by the target's GoogleTest discovery include) when CTest
# loads the directory.
function(vixen_test_class_register target list_variable)
    file(GENERATE OUTPUT "${VIXEN_TEST_CLASS_DIR}/stub-${target}.cmake" CONTENT
"set(VIXEN_CLASS_TARGET [==[${target}]==])
set(VIXEN_CLASS_LINK [==[$<TARGET_PROPERTY:${target},VIXEN_TEST_CLASS>]==])
set(VIXEN_CLASS_FINGERPRINT [==[$<TARGET_PROPERTY:${target},VIXEN_TEST_SOURCE_FP>]==])
set(VIXEN_CLASS_TESTS \"\${${list_variable}}\")
set(VIXEN_CLASS_MANIFEST [==[${VIXEN_TEST_CLASS_MANIFEST}]==])
include([==[${_VIXEN_TEST_CLASS_MODULE_DIR}/VixenTestClassApply.cmake]==])
")
    set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${VIXEN_TEST_CLASS_DIR}/stub-${target}.cmake")
endfunction()

# Declared by the registration helpers (GPU / GPU_TESTS flags and FIXTURES_REQUIRED) on test targets.
function(vixen_test_class_declare target)
    cmake_parse_arguments(PARSE_ARGV 1 VTD "GPU" "" "FIXTURES_REQUIRED")
    if(VTD_GPU)
        set_property(TARGET ${target} PROPERTY VIXEN_DECLARED_GPU 1)
    endif()
    if(VTD_FIXTURES_REQUIRED)
        set_property(TARGET ${target} APPEND PROPERTY VIXEN_FIXTURES_REQUIRED ${VTD_FIXTURES_REQUIRED})
    endif()
endfunction()

function(_vixen_is_loader_token token output_variable)
    set(_is FALSE)
    if(token MATCHES "^(Vulkan::Vulkan|vulkan|vulkan-1|-lvulkan)$"
       OR token MATCHES "(^|/)libvulkan(-1)?\\.(so|a|dylib)"
       OR token MATCHES "(^|/)vulkan-1\\.(lib|dll)$")
        set(_is TRUE)
    endif()
    set(${output_variable} ${_is} PARENT_SCOPE)
endfunction()

# Project libraries and executables are scanned for device-creating calls in their own sources.
function(_vixen_device_owner_evidence target output_variable)
    get_property(_done GLOBAL PROPERTY VIXEN_OWNER_DONE_${target} SET)
    if(_done)
        get_property(_evidence GLOBAL PROPERTY VIXEN_OWNER_${target})
        set(${output_variable} "${_evidence}" PARENT_SCOPE)
        return()
    endif()
    set(_evidence "")
    get_target_property(_imported ${target} IMPORTED)
    get_target_property(_type ${target} TYPE)
    get_target_property(_source_dir ${target} SOURCE_DIR)
    if(NOT _imported AND NOT _type STREQUAL "INTERFACE_LIBRARY" AND _source_dir
       AND _source_dir MATCHES "^${_VIXEN_TEST_CLASS_ROOT}"
       AND NOT _source_dir MATCHES "^${_VIXEN_TEST_CLASS_ROOT}/dependencies")
        get_target_property(_sources ${target} SOURCES)
        foreach(_source IN LISTS _sources)
            if(_source MATCHES "[$<>]" OR NOT _source MATCHES "\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|inl|ipp)$")
                continue()
            endif()
            get_filename_component(_path "${_source}" ABSOLUTE BASE_DIR "${_source_dir}")
            if(NOT EXISTS "${_path}")
                continue()
            endif()
            file(STRINGS "${_path}" _hit REGEX "${_VIXEN_DEVICE_CALL_REGEX}" LIMIT_COUNT 1)
            if(_hit)
                string(REGEX MATCH "(vkCreateInstance|vkCreateDevice|vkAllocateMemory|vkQueueSubmit|vmaCreateAllocator)" _call "${_hit}")
                file(RELATIVE_PATH _rel "${_VIXEN_TEST_CLASS_ROOT}" "${_path}")
                set(_evidence "${_rel} calls ${_call}")
                break()
            endif()
        endforeach()
    endif()
    set_property(GLOBAL PROPERTY VIXEN_OWNER_DONE_${target} 1)
    set_property(GLOBAL PROPERTY VIXEN_OWNER_${target} "${_evidence}")
    set(${output_variable} "${_evidence}" PARENT_SCOPE)
endfunction()

# Targets named by a link-library list entry (including inside generator expressions).
function(_vixen_link_entry_targets output_variable)
    set(_targets)
    foreach(_entry IN LISTS ARGN)
        string(REGEX MATCHALL "[A-Za-z0-9_.+/-]+(::[A-Za-z0-9_.+-]+)*" _tokens "${_entry}")
        list(APPEND _targets ${_tokens})
    endforeach()
    set(${output_variable} "${_targets}" PARENT_SCOPE)
endfunction()

function(_vixen_target_link_tokens target output_variable)
    get_property(_done GLOBAL PROPERTY VIXEN_EDGES_DONE_${target} SET)
    if(_done)
        get_property(_tokens GLOBAL PROPERTY VIXEN_EDGES_${target})
        set(${output_variable} "${_tokens}" PARENT_SCOPE)
        return()
    endif()
    get_target_property(_type ${target} TYPE)
    set(_entries)
    if(NOT _type STREQUAL "INTERFACE_LIBRARY")
        get_target_property(_direct ${target} LINK_LIBRARIES)
        if(_direct)
            list(APPEND _entries ${_direct})
        endif()
    endif()
    get_target_property(_interface ${target} INTERFACE_LINK_LIBRARIES)
    if(_interface)
        list(APPEND _entries ${_interface})
    endif()
    _vixen_link_entry_targets(_tokens ${_entries})
    list(REMOVE_DUPLICATES _tokens)
    set_property(GLOBAL PROPERTY VIXEN_EDGES_DONE_${target} 1)
    set_property(GLOBAL PROPERTY VIXEN_EDGES_${target} "${_tokens}")
    set(${output_variable} "${_tokens}" PARENT_SCOPE)
endfunction()

# Breadth-first walk of the link closure; reports the first path to a GPU-owning node.
function(_vixen_classify_by_link target class_variable evidence_variable)
    set(_queue "${target}")
    set(_paths "${target}")
    set(_visited)
    while(_queue)
        list(POP_FRONT _queue _node)
        list(POP_FRONT _paths _path)
        if(_node IN_LIST _visited)
            continue()
        endif()
        list(APPEND _visited ${_node})

        _vixen_device_owner_evidence(${_node} _owner)
        if(_owner)
            set(${class_variable} gpu PARENT_SCOPE)
            set(${evidence_variable} "link: ${_path} [${_owner}]" PARENT_SCOPE)
            return()
        endif()

        _vixen_target_link_tokens(${_node} _tokens)
        foreach(_token IN LISTS _tokens)
            _vixen_is_loader_token("${_token}" _is_loader)
            if(_is_loader)
                set(${class_variable} gpu PARENT_SCOPE)
                set(${evidence_variable} "link: ${_path} -> ${_token} [Vulkan loader]" PARENT_SCOPE)
                return()
            endif()
            if(TARGET ${_token})
                get_target_property(_aliased ${_token} ALIASED_TARGET)
                if(_aliased)
                    set(_token ${_aliased})
                endif()
                if(NOT _token IN_LIST _visited)
                    list(APPEND _queue ${_token})
                    list(APPEND _paths "${_path} -> ${_token}")
                endif()
            endif()
        endforeach()
    endwhile()
    list(LENGTH _visited _count)
    set(${class_variable} cpu PARENT_SCOPE)
    set(${evidence_variable} "link: no Vulkan loader or device-owning library in closure of ${_count} targets" PARENT_SCOPE)
endfunction()

function(_vixen_source_fingerprint target output_variable)
    get_target_property(_sources ${target} SOURCES)
    get_target_property(_source_dir ${target} SOURCE_DIR)
    set(_combined)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "[$<>]")
            continue()
        endif()
        get_filename_component(_path "${_source}" ABSOLUTE BASE_DIR "${_source_dir}")
        if(EXISTS "${_path}")
            file(SHA1 "${_path}" _sha)
            string(APPEND _combined "${_sha}")
        endif()
    endforeach()
    string(SHA1 _fingerprint "${_combined}")
    string(SUBSTRING "${_fingerprint}" 0 12 _fingerprint)
    set(${output_variable} "${_fingerprint}" PARENT_SCOPE)
endfunction()

function(_vixen_collect_directories directory output_variable)
    set(_directories "${directory}")
    get_property(_subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_subdirectory IN LISTS _subdirectories)
        _vixen_collect_directories("${_subdirectory}" _nested)
        list(APPEND _directories ${_nested})
    endforeach()
    set(${output_variable} "${_directories}" PARENT_SCOPE)
endfunction()

# Executable targets a test command launches: `$<TARGET_FILE:x>` or a bare executable target name.
function(_vixen_command_executables output_variable)
    set(_executables)
    foreach(_element IN LISTS ARGN)
        set(_candidate "${_element}")
        if(_element MATCHES "^\\$<TARGET_FILE:([^>]+)>$")
            set(_candidate "${CMAKE_MATCH_1}")
        endif()
        if(TARGET ${_candidate})
            get_target_property(_type ${_candidate} TYPE)
            if(_type STREQUAL "EXECUTABLE")
                list(APPEND _executables ${_candidate})
            endif()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _executables)
    set(${output_variable} "${_executables}" PARENT_SCOPE)
endfunction()

# CMake does not expose a test's COMMAND, so add_test is wrapped to remember it. The original is
# forwarded argument-for-argument.
function(add_test)
    set(_forward)
    math(EXPR _last "${ARGC} - 1")
    foreach(_index RANGE ${_last})
        string(APPEND _forward " [==[${ARGV${_index}}]==]")
    endforeach()
    if("${ARGV0}" STREQUAL "NAME")
        cmake_parse_arguments(_vat "" "NAME;WORKING_DIRECTORY" "COMMAND;CONFIGURATIONS" ${ARGN})
        set(_name "${_vat_NAME}")
        set(_command ${_vat_COMMAND})
    else()
        set(_name "${ARGV0}")
        set(_command ${ARGN})
    endif()
    string(JOIN "\n" _text ${_command})
    set_property(GLOBAL PROPERTY "VIXEN_TEST_COMMAND_${_name}" "${_text}")
    cmake_language(EVAL CODE "_add_test(${_forward})")
endfunction()

# Executable targets named anywhere in a test's command text (`$<TARGET_FILE:x>`, an argument equal
# to the target name, or a path ending in it), so `bash -c 'exec .../x'` and `python gate.py --app x`
# are seen as launching x.
function(_vixen_text_executables output_variable text)
    set(_haystack "\n${text}\n")
    set(_found)
    foreach(_candidate IN LISTS ARGN)
        set(_hit FALSE)
        foreach(_pattern "$<TARGET_FILE:${_candidate}>" "$<TARGET_FILE_NAME:${_candidate}>"
                         "$<TARGET_FILE_DIR:${_candidate}>" "\n${_candidate}\n" "/${_candidate}\n"
                         "/${_candidate}\"" "/${_candidate} " "/${_candidate}'")
            string(FIND "${_haystack}" "${_pattern}" _position)
            if(NOT _position EQUAL -1)
                set(_hit TRUE)
                break()
            endif()
        endforeach()
        if(_hit)
            list(APPEND _found ${_candidate})
        endif()
    endforeach()
    set(${output_variable} "${_found}" PARENT_SCOPE)
endfunction()

# Fingerprint of a plain test: its command with build/source roots normalised, the sources of the
# executables it launches, and the contents of script files it passes.
function(_vixen_plain_fingerprint output_variable text)
    string(REPLACE "${CMAKE_BINARY_DIR}" "@B@" _normal "${text}")
    string(REPLACE "${_VIXEN_TEST_CLASS_ROOT}" "@S@" _normal "${_normal}")
    string(REPLACE "\n" ";" _lines "${_normal}")
    set(_material)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^/")
            continue()
        endif()
        string(APPEND _material "${_line}\n")
    endforeach()
    string(REPLACE "\n" ";" _raw_lines "${text}")
    foreach(_line IN LISTS _raw_lines)
        if(_line MATCHES "^/" AND NOT IS_DIRECTORY "${_line}" AND EXISTS "${_line}"
           AND (_line MATCHES "^${_VIXEN_TEST_CLASS_ROOT}" OR _line MATCHES "^${_VIXEN_TEST_CLASS_ROOT}/\\.\\."))
            file(SHA1 "${_line}" _file_sha)
            string(APPEND _material "${_file_sha}\n")
        endif()
    endforeach()
    foreach(_exe IN LISTS ARGN)
        get_target_property(_exe_fp ${_exe} VIXEN_TEST_SOURCE_FP)
        string(APPEND _material "${_exe}=${_exe_fp}\n")
    endforeach()
    string(SHA1 _digest "${_material}")
    string(SUBSTRING "${_digest}" 0 12 _digest)
    set(${output_variable} "${_digest}" PARENT_SCOPE)
endfunction()

function(_vixen_target_class target output_variable)
    get_target_property(_class ${target} VIXEN_TEST_CLASS)
    if(NOT _class)
        set(_class cpu)
    endif()
    set(${output_variable} "${_class}" PARENT_SCOPE)
endfunction()

function(vixen_finalize_test_classes)
    if(NOT BUILD_TESTS OR CMAKE_VERSION VERSION_LESS 3.28)
        return()
    endif()

    _vixen_collect_directories("${_VIXEN_TEST_CLASS_ROOT}" _directories)
    set(_executables)
    foreach(_directory IN LISTS _directories)
        get_property(_targets DIRECTORY "${_directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(_target IN LISTS _targets)
            get_target_property(_type ${_target} TYPE)
            get_target_property(_source_dir ${_target} SOURCE_DIR)
            if(_type STREQUAL "EXECUTABLE" AND NOT _source_dir MATCHES "^${_VIXEN_TEST_CLASS_ROOT}/dependencies")
                list(APPEND _executables ${_target})
            endif()
        endforeach()
    endforeach()

    # 1. Link-closure class of every executable, plus the GPU a target declares for itself.
    foreach(_exe IN LISTS _executables)
        _vixen_classify_by_link(${_exe} _class _evidence)
        get_target_property(_declared ${_exe} VIXEN_DECLARED_GPU)
        if(_declared AND _class STREQUAL "cpu")
            set(_class gpu)
            set(_evidence "declared: registered with the GPU flag")
        endif()
        set_property(TARGET ${_exe} PROPERTY VIXEN_TEST_CLASS "${_class}")
        set_property(TARGET ${_exe} PROPERTY VIXEN_TEST_CLASS_EVIDENCE "${_evidence}")
        _vixen_source_fingerprint(${_exe} _fingerprint)
        set_property(TARGET ${_exe} PROPERTY VIXEN_TEST_SOURCE_FP "${_fingerprint}")
    endforeach()

    # 2. Plain add_test entries: class from the executable they launch.
    set(_plain_tests)
    foreach(_directory IN LISTS _directories)
        get_property(_tests DIRECTORY "${_directory}" PROPERTY TESTS)
        foreach(_test IN LISTS _tests)
            get_property(_text GLOBAL PROPERTY "VIXEN_TEST_COMMAND_${_test}")
            _vixen_text_executables(_launched "${_text}" ${_executables})
            set(_class cpu)
            set(_evidence "link: command launches no project executable")
            set(_first_exe "")
            foreach(_exe IN LISTS _launched)
                _vixen_target_class(${_exe} _exe_class)
                get_target_property(_exe_evidence ${_exe} VIXEN_TEST_CLASS_EVIDENCE)
                if(NOT _first_exe OR (_exe_class STREQUAL "gpu" AND NOT _class STREQUAL "gpu"))
                    set(_first_exe ${_exe})
                    set(_class ${_exe_class})
                    set(_evidence "${_exe_evidence}")
                endif()
            endforeach()
            _vixen_plain_fingerprint(_plain_fp "${_text}" ${_launched})
            set_property(GLOBAL PROPERTY VIXEN_PLAIN_EXE_${_directory}|${_test} "${_first_exe}")
            set_property(GLOBAL PROPERTY VIXEN_PLAIN_FP_${_directory}|${_test} "${_plain_fp}")
            list(APPEND _plain_tests "${_directory}|${_test}")
            set_property(GLOBAL PROPERTY VIXEN_PLAIN_CLASS_${_directory}|${_test} "${_class}")
            set_property(GLOBAL PROPERTY VIXEN_PLAIN_EVIDENCE_${_directory}|${_test} "${_evidence}")
        endforeach()
    endforeach()

    # 3. A test that needs a GPU fixture's setup test cannot run in the CPU part: it is `gpu` too.
    set(_gpu_fixtures)
    foreach(_entry IN LISTS _plain_tests)
        string(REPLACE "|" ";" _parts "${_entry}")
        list(GET _parts 0 _directory)
        list(GET _parts 1 _test)
        get_property(_class GLOBAL PROPERTY VIXEN_PLAIN_CLASS_${_directory}|${_test})
        get_property(_setup TEST ${_test} DIRECTORY "${_directory}" PROPERTY FIXTURES_SETUP)
        if(_setup AND _class STREQUAL "gpu")
            list(APPEND _gpu_fixtures ${_setup})
        endif()
    endforeach()
    foreach(_exe IN LISTS _executables)
        get_target_property(_required ${_exe} VIXEN_FIXTURES_REQUIRED)
        foreach(_fixture IN LISTS _required)
            if(_fixture IN_LIST _gpu_fixtures)
                set_property(TARGET ${_exe} PROPERTY VIXEN_TEST_CLASS gpu)
                set_property(TARGET ${_exe} PROPERTY VIXEN_TEST_CLASS_EVIDENCE "fixture: requires GPU fixture ${_fixture}")
            endif()
        endforeach()
    endforeach()
    # CTest runs a fixture's setup test with every test that requires it, so the setup of a fixture a
    # gpu executable requires is gpu as well; otherwise it would run in both parts.
    set(_gpu_consumed_fixtures)
    foreach(_exe IN LISTS _executables)
        _vixen_target_class(${_exe} _exe_class)
        get_target_property(_required ${_exe} VIXEN_FIXTURES_REQUIRED)
        if(_exe_class STREQUAL "gpu" AND _required)
            list(APPEND _gpu_consumed_fixtures ${_required})
        endif()
    endforeach()

    # 4. Plain add_test entries exist now, so they take the manifest class (when fresh) or the link
    #    class here; GoogleTest cases are labelled by their stub when CTest loads the directory.
    set(_plain_table)
    set(_manifest "\n")
    if(EXISTS "${VIXEN_TEST_CLASS_MANIFEST}")
        file(READ "${VIXEN_TEST_CLASS_MANIFEST}" _manifest_text)
        string(APPEND _manifest "${_manifest_text}")
    endif()
    foreach(_entry IN LISTS _plain_tests)
        string(REPLACE "|" ";" _parts "${_entry}")
        list(GET _parts 0 _directory)
        list(GET _parts 1 _test)
        get_property(_class GLOBAL PROPERTY VIXEN_PLAIN_CLASS_${_directory}|${_test})
        get_property(_link_evidence GLOBAL PROPERTY VIXEN_PLAIN_EVIDENCE_${_directory}|${_test})
        get_property(_exe GLOBAL PROPERTY VIXEN_PLAIN_EXE_${_directory}|${_test})
        get_property(_required TEST ${_test} DIRECTORY "${_directory}" PROPERTY FIXTURES_REQUIRED)
        foreach(_fixture IN LISTS _required)
            if(_fixture IN_LIST _gpu_fixtures)
                set(_class gpu)
                set(_link_evidence "fixture: requires GPU fixture ${_fixture}")
            endif()
        endforeach()
        get_property(_setup TEST ${_test} DIRECTORY "${_directory}" PROPERTY FIXTURES_SETUP)
        foreach(_fixture IN LISTS _setup)
            if(_fixture IN_LIST _gpu_consumed_fixtures)
                set(_class gpu)
                set(_link_evidence "fixture: setup of GPU fixture ${_fixture}")
            endif()
        endforeach()
        set(_link_class "${_class}")
        get_property(_plain_fp GLOBAL PROPERTY VIXEN_PLAIN_FP_${_directory}|${_test})
        if(NOT _exe)
            set(_exe "-")
        endif()
        set(_source classified-by-link)
        string(FIND "${_manifest}" "\n${_test}\t" _position)
        if(NOT _position EQUAL -1)
            math(EXPR _position "${_position} + 1")
            string(SUBSTRING "${_manifest}" ${_position} 4096 _tail)
            if(_tail MATCHES "^[^\t\n]*\t(gpu|cpu)\t([^\t\n]*)\t([^\t\n]*)\t")
                if("${CMAKE_MATCH_2}" STREQUAL "${_exe}" AND "${CMAKE_MATCH_3}" STREQUAL "${_plain_fp}")
                    set(_class ${CMAKE_MATCH_1})
                    set(_source classified-by-run)
                endif()
            endif()
        endif()
        string(APPEND _plain_table "${_test}\t${_exe}\t${_plain_fp}\t${_link_class}\t${_link_evidence}\n")
        vixen_test_class_environment_modification(_modification)
        set_property(TEST ${_test} DIRECTORY "${_directory}" APPEND PROPERTY LABELS "${_class}" "${_source}")
        set_property(TEST ${_test} DIRECTORY "${_directory}" APPEND PROPERTY ENVIRONMENT_MODIFICATION
            ${_modification} "VIXEN_TEST_CLASS=set:${_class}" "VIXEN_TEST_NAME=set:${_test}")
        if(_class STREQUAL "gpu")
            set_property(TEST ${_test} DIRECTORY "${_directory}" APPEND PROPERTY RESOURCE_LOCK vixen_gpu_device)
        endif()
    endforeach()

    file(WRITE "${VIXEN_TEST_CLASS_DIR}/plain-tests.tsv"
        "# test<TAB>target<TAB>fingerprint<TAB>link class<TAB>link evidence (generated)\n${_plain_table}")

    # 5. Executable table: target, file, link class, source fingerprint, evidence. The classifier
    #    tool maps test commands to targets with it and diffs its link class against measurements.
    set(_table "# target<TAB>file<TAB>class<TAB>source-fingerprint<TAB>evidence (generated)\n")
    foreach(_exe IN LISTS _executables)
        get_target_property(_fingerprint ${_exe} VIXEN_TEST_SOURCE_FP)
        get_target_property(_class ${_exe} VIXEN_TEST_CLASS)
        get_target_property(_evidence ${_exe} VIXEN_TEST_CLASS_EVIDENCE)
        string(APPEND _table "${_exe}\t$<TARGET_FILE:${_exe}>\t${_class}\t${_fingerprint}\t${_evidence}\n")
    endforeach()
    file(GENERATE OUTPUT "${VIXEN_TEST_CLASS_DIR}/exe-classes.tsv" CONTENT "${_table}")
endfunction()

function(vixen_schedule_test_class_finalize)
    if(BUILD_TESTS AND NOT CMAKE_VERSION VERSION_LESS 3.28)
        cmake_language(DEFER DIRECTORY "${_VIXEN_TEST_CLASS_ROOT}" CALL vixen_finalize_test_classes)
    endif()
endfunction()
