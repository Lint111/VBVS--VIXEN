# Shared by CMake, the WSL provisioning shell, and Windows PowerShell.
# Override the selected platform default with the process environment variable
# VIXEN_VULKAN_SDK_VERSION. Keep the capability floors here so configure-time
# checks and CapabilityGraph consume the same requirements.
VIXEN_VULKAN_SDK_VERSION_WINDOWS_DEFAULT=1.4.350.0
VIXEN_VULKAN_SDK_VERSION_WSL_DEFAULT=1.4.350.1
VIXEN_VULKAN_SDK_VERSION_OTHER_DEFAULT=1.4.350.1
VIXEN_VULKAN_MIN_API_VERSION=1.2.0
VIXEN_VULKAN_SYNCHRONIZATION2_CORE_VERSION=1.3.0
VIXEN_VULKAN_MIN_SPIRV_TARGET_VERSION=1.4.0
