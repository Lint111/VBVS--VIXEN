# Run by vixen_source_fingerprint(): -DOUT_HEADER -DCONSTANT -DLIST_FILE -DSALT -P this file.
# Rewrites OUT_HEADER only when its bytes would change, so dependents do not rebuild on a touch.
file(STRINGS "${LIST_FILE}" _files)
set(_accumulated "${SALT}")
foreach(_file IN LISTS _files)
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "source fingerprint input vanished: ${_file}\n"
            "  listed by: ${LIST_FILE}\n"
            "  fix: re-run cmake configure so the input list is regenerated")
    endif()
    file(SHA256 "${_file}" _hash)
    string(APPEND _accumulated "|${_hash}")
endforeach()
string(SHA256 _fingerprint "${_accumulated}")
string(SUBSTRING "${_fingerprint}" 0 16 _fingerprint)

string(REGEX MATCH "^(.*)::([A-Za-z0-9_]+)$" _unused "${CONSTANT}")
set(_namespace "${CMAKE_MATCH_1}")
set(_name "${CMAKE_MATCH_2}")
set(_content "// Generated by cmake/VixenSourceFingerprint.cmake. Do not edit.\n#pragma once\nnamespace ${_namespace} {\ninline constexpr char ${_name}[] = \"${_fingerprint}\";\n}\n")
if(EXISTS "${OUT_HEADER}")
    file(READ "${OUT_HEADER}" _previous)
    if(_previous STREQUAL _content)
        return()
    endif()
endif()
get_filename_component(_parent "${OUT_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${_parent}")
file(WRITE "${OUT_HEADER}" "${_content}")
