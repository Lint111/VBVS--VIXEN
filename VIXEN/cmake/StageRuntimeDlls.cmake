if(NOT VIXEN_RUNTIME_DLLS)
    return()
endif()

string(REPLACE "|" ";" _vixen_runtime_dlls "${VIXEN_RUNTIME_DLLS}")
set(_vixen_runtime_destinations "${VIXEN_RUNTIME_DESTINATION}")
if(VIXEN_RUNTIME_ADDITIONAL_DESTINATIONS)
    string(REPLACE "|" ";" _vixen_additional_destinations "${VIXEN_RUNTIME_ADDITIONAL_DESTINATIONS}")
    list(APPEND _vixen_runtime_destinations ${_vixen_additional_destinations})
endif()

foreach(_vixen_runtime_dll IN LISTS _vixen_runtime_dlls)
    if(NOT EXISTS "${_vixen_runtime_dll}")
        message(FATAL_ERROR "Runtime DLL listed for staging does not exist: ${_vixen_runtime_dll}")
    endif()

    get_filename_component(_vixen_runtime_name "${_vixen_runtime_dll}" NAME)
    file(REAL_PATH "${_vixen_runtime_dll}" _vixen_runtime_source_real)
    string(TOLOWER "${_vixen_runtime_source_real}" _vixen_runtime_source_key)
    foreach(_vixen_runtime_destination IN LISTS _vixen_runtime_destinations)
        file(MAKE_DIRECTORY "${_vixen_runtime_destination}")
        get_filename_component(_vixen_runtime_copy "${_vixen_runtime_destination}/${_vixen_runtime_name}" ABSOLUTE)
        string(TOLOWER "${_vixen_runtime_copy}" _vixen_runtime_copy_key)
        if(NOT _vixen_runtime_source_key STREQUAL _vixen_runtime_copy_key)
            file(COPY_FILE "${_vixen_runtime_dll}" "${_vixen_runtime_copy}" ONLY_IF_DIFFERENT)
        endif()
    endforeach()
endforeach()
