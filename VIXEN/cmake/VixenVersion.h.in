#define VIXEN_VERSION_STRING "@PROJECT_VERSION@"

// Encode a version as a single comparable integer (major*10000 + minor*100 + patch).
#define VIXEN_MAKE_VERSION(major, minor, patch) ((major) * 10000 + (minor) * 100 + (patch))

