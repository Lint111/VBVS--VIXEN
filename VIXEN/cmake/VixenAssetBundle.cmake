# VixenAssetBundle.cmake -- script-mode (cmake -P) worker for vixen_stage_assets (cmake/VixenAssets.cmake).
#
# One immutable, digest-keyed asset bundle per source directory:
#   <ROOT>/<key>/              the bundle (<key> = first 16 hex of sha256 over the sorted per-file digests)
#   <ROOT>/<key>/MANIFEST.txt  "<sha256>  <relative path>" per file, sorted
#   <ROOT>/<key>/assets/       the payload. The directory is named "assets" on purpose: runtime code (e.g.
#                              Text RmlFontEngine::IsBundledFacePath) classifies files by a "/assets/ui/"
#                              segment in the canonical path, which a link would otherwise erase.
#   <ROOT>/current             symlink -> <key> (atomically replaced), the stable runtime path
# Consumers get <exe-dir>/<dest> -> <ROOT>/current/assets (symlink; copy fallback where symlinks are unavailable).
#
# Modes (-DMODE=...):
#   bundle  -DSRC= -DROOT= -DSTAMP= [-DREQUIRE=a;b]   publish the bundle if its key is not already present
#   link    -DROOT= -DDEST= -DSTAMP=                   point DEST at the current bundle
#   verify  -DROOT=                                    re-hash every staged file against MANIFEST.txt
#
# Every failure names the member and the fix; nothing here throws without saying what/where/why.

cmake_minimum_required(VERSION 3.20)

function(_vab_fail what where why fix)
    message(FATAL_ERROR "vixen_asset_bundle: ${what}\n  where: ${where}\n  why:   ${why}\n  fix:   ${fix}")
endfunction()

# Builds MANIFEST text (sorted "<sha256>  <rel>" lines) for <dir> into <out_var>.
function(_vab_manifest dir out_var)
    file(GLOB_RECURSE _files RELATIVE "${dir}" LIST_DIRECTORIES false "${dir}/*")
    list(SORT _files)
    set(_text "")
    foreach(_rel IN LISTS _files)
        if(_rel STREQUAL "MANIFEST.txt")
            continue()
        endif()
        file(SHA256 "${dir}/${_rel}" _h)
        string(APPEND _text "${_h}  ${_rel}\n")
    endforeach()
    set(${out_var} "${_text}" PARENT_SCOPE)
endfunction()

# Re-hashes <bundle_dir> against its MANIFEST.txt; sets <ok_var> and <why_var>.
function(_vab_check_bundle bundle_dir ok_var why_var)
    set(${ok_var} FALSE PARENT_SCOPE)
    if(NOT EXISTS "${bundle_dir}/MANIFEST.txt")
        set(${why_var} "no MANIFEST.txt in ${bundle_dir}" PARENT_SCOPE)
        return()
    endif()
    file(STRINGS "${bundle_dir}/MANIFEST.txt" _lines)
    foreach(_line IN LISTS _lines)
        if(NOT _line MATCHES "^([0-9a-f]+)  (.+)$")
            set(${why_var} "malformed manifest line '${_line}'" PARENT_SCOPE)
            return()
        endif()
        set(_want "${CMAKE_MATCH_1}")
        set(_rel "${CMAKE_MATCH_2}")
        if(NOT EXISTS "${bundle_dir}/assets/${_rel}")
            set(${why_var} "manifest member '${_rel}' is missing from ${bundle_dir}/assets" PARENT_SCOPE)
            return()
        endif()
        file(SHA256 "${bundle_dir}/assets/${_rel}" _got)
        if(NOT _got STREQUAL _want)
            set(${why_var} "manifest member '${_rel}' digest mismatch (manifest ${_want}, on disk ${_got})" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${ok_var} TRUE PARENT_SCOPE)
endfunction()

# Atomically (re)points <link> at <target>; returns TRUE if a symlink now exists.
function(_vab_symlink target link ok_var)
    set(${ok_var} FALSE PARENT_SCOPE)
    set(_tmp "${link}.tmp")
    file(REMOVE_RECURSE "${_tmp}")
    file(CREATE_LINK "${target}" "${_tmp}" SYMBOLIC RESULT _rc)
    if(NOT _rc EQUAL 0)
        file(REMOVE "${_tmp}")
        return()
    endif()
    file(RENAME "${_tmp}" "${link}")
    set(${ok_var} TRUE PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "bundle")
    if(NOT IS_DIRECTORY "${SRC}")
        _vab_fail("source asset directory not found" "${SRC}" "the directory does not exist" "fix the vixen_stage_assets() source argument")
    endif()
    _vab_manifest("${SRC}" _manifest)
    if(_manifest STREQUAL "")
        _vab_fail("source asset directory is empty" "${SRC}" "no files to publish" "add assets or remove the vixen_stage_assets() call")
    endif()
    foreach(_req IN LISTS REQUIRE)
        string(FIND "${_manifest}" "  ${_req}\n" _pos)
        if(_pos EQUAL -1)
            _vab_fail("required asset '${_req}' is missing from the bundle" "${SRC}" "not present in the source directory" "add ${_req} under ${SRC} (typed input of this bundle)")
        endif()
    endforeach()
    string(SHA256 _key "${_manifest}")
    string(SUBSTRING "${_key}" 0 16 _key)
    set(_bundle "${ROOT}/${_key}")

    set(_ok FALSE)
    if(EXISTS "${_bundle}/MANIFEST.txt")
        _vab_check_bundle("${_bundle}" _ok _why)
        if(NOT _ok)
            message(STATUS "vixen_asset_bundle: ${_key} present but invalid (${_why}); republishing")
        endif()
    endif()
    if(NOT _ok)
        set(_tmp "${ROOT}/${_key}.tmp")
        file(REMOVE_RECURSE "${_tmp}" "${_bundle}")
        file(MAKE_DIRECTORY "${_tmp}/assets")
        file(COPY "${SRC}/" DESTINATION "${_tmp}/assets")
        file(WRITE "${_tmp}/MANIFEST.txt" "${_manifest}")
        _vab_check_bundle("${_tmp}" _ok _why)
        if(NOT _ok)
            _vab_fail("staged bundle failed digest verification" "${_tmp}" "${_why}" "rerun the build; if it repeats, the source directory is changing during the build")
        endif()
        file(RENAME "${_tmp}" "${_bundle}")
        message(STATUS "vixen_asset_bundle: published ${_key} (${SRC})")
    endif()

    _vab_symlink("${_key}" "${ROOT}/current" _linked)
    if(NOT _linked)
        # No symlink support: `current` becomes a plain copy of the bundle.
        file(REMOVE_RECURSE "${ROOT}/current.tmp" "${ROOT}/current")
        file(COPY "${_bundle}/" DESTINATION "${ROOT}/current.tmp")
        file(RENAME "${ROOT}/current.tmp" "${ROOT}/current")
    endif()
    file(WRITE "${STAMP}" "${_key}\n")

elseif(MODE STREQUAL "link")
    if(NOT EXISTS "${ROOT}/current/MANIFEST.txt")
        _vab_fail("no published bundle" "${ROOT}/current" "the bundle step has not run" "build the vixen_asset_bundle_* target first")
    endif()
    get_filename_component(_parent "${DEST}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    set(_want "${ROOT}/current/assets")
    set(_have "")
    if(IS_SYMLINK "${DEST}")
        file(READ_SYMLINK "${DEST}" _have)
    endif()
    if(NOT _have STREQUAL _want)
        if(IS_SYMLINK "${DEST}")
            file(REMOVE "${DEST}")
        elseif(IS_DIRECTORY "${DEST}")
            # A real directory is only replaced when it is a stale staged copy: every file in it
            # must also exist in the bundle. Anything else is not ours to delete.
            file(GLOB_RECURSE _present RELATIVE "${DEST}" LIST_DIRECTORIES false "${DEST}/*")
            foreach(_rel IN LISTS _present)
                if(NOT EXISTS "${_want}/${_rel}")
                    _vab_fail("refusing to replace a directory that is not a staged asset copy" "${DEST}" "'${_rel}' is not part of the asset bundle" "move or delete ${DEST} yourself, then rebuild")
                endif()
            endforeach()
            file(REMOVE_RECURSE "${DEST}")
        elseif(EXISTS "${DEST}")
            _vab_fail("destination exists and is not a directory or link" "${DEST}" "a plain file is in the way" "delete ${DEST} and rebuild")
        endif()
        _vab_symlink("${_want}" "${DEST}" _linked)
        if(NOT _linked)
            file(REMOVE_RECURSE "${DEST}.tmp")
            file(COPY "${_want}/" DESTINATION "${DEST}.tmp")
            file(RENAME "${DEST}.tmp" "${DEST}")
        endif()
    endif()
    if(NOT IS_DIRECTORY "${DEST}")
        _vab_fail("runtime asset path does not resolve" "${DEST}" "it is not a directory after linking" "delete ${DEST} and rebuild")
    endif()
    file(WRITE "${STAMP}" "${DEST}\n")

elseif(MODE STREQUAL "verify")
    _vab_check_bundle("${ROOT}/current" _ok _why)
    if(NOT _ok)
        _vab_fail("asset bundle verification failed" "${ROOT}/current" "${_why}" "rebuild the vixen_asset_bundle_* target (deletes nothing else)")
    endif()
    message(STATUS "vixen_asset_bundle: ${ROOT}/current verified")
else()
    message(FATAL_ERROR "vixen_asset_bundle: unknown MODE '${MODE}' (bundle|link|verify)")
endif()
