# USE_CCACHE=OFF clears cached ccache/sccache launchers but keeps unrelated ones.
if(NOT DEFINED VIXEN_CCACHE_TEST_ROOT)
    message(FATAL_ERROR "VIXEN_CCACHE_TEST_ROOT must be inside the caller's build tree")
endif()
get_filename_component(vixen_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(REMOVE_RECURSE "${VIXEN_CCACHE_TEST_ROOT}")
set(src "${VIXEN_CCACHE_TEST_ROOT}/src")
set(bin "${VIXEN_CCACHE_TEST_ROOT}/bin")
file(MAKE_DIRECTORY "${src}")
file(WRITE "${src}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.20)
project(ccache_off NONE)
option(USE_CCACHE \"\" ON)
include(\"${vixen_root}/cmake/VixenCompilerCache.cmake\")
if(NOT USE_CCACHE)
    vixen_clear_cached_compiler_cache_launchers()
endif()
")

function(configure)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${src}" -B "${bin}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "configure failed (${ARGN}): ${out}${err}")
    endif()
    set(configure_output "${out}" PARENT_SCOPE)
endfunction()

function(cached_launcher language out_var)
    file(STRINGS "${bin}/CMakeCache.txt" line REGEX "^CMAKE_${language}_COMPILER_LAUNCHER:")
    string(REGEX REPLACE "^[^=]*=" "" value "${line}")
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

configure(-DCMAKE_C_COMPILER_LAUNCHER=/usr/bin/ccache -DCMAKE_CXX_COMPILER_LAUNCHER=sccache
          -DUSE_CCACHE=ON)
cached_launcher(CXX cxx)
if(NOT cxx STREQUAL "sccache")
    message(FATAL_ERROR "USE_CCACHE=ON must keep the cached launcher, got '${cxx}'")
endif()
configure(-DUSE_CCACHE=OFF)
foreach(language C CXX)
    cached_launcher(${language} value)
    if(NOT value STREQUAL "")
        message(FATAL_ERROR "USE_CCACHE=OFF left CMAKE_${language}_COMPILER_LAUNCHER='${value}'")
    endif()
endforeach()
if(NOT configure_output MATCHES "USE_CCACHE=OFF: clearing cached CMAKE_CXX_COMPILER_LAUNCHER")
    message(FATAL_ERROR "clearing must be reported (what/where/why): ${configure_output}")
endif()
# A non-compiler-cache launcher is the caller's explicit choice.
configure(-DCMAKE_CXX_COMPILER_LAUNCHER=distcc -DUSE_CCACHE=OFF)
cached_launcher(CXX value)
if(NOT value STREQUAL "distcc")
    message(FATAL_ERROR "USE_CCACHE=OFF must not clear a non-ccache launcher, got '${value}'")
endif()
message(STATUS "USE_CCACHE=OFF clears only cached ccache/sccache launchers")
