cmake_minimum_required(VERSION 3.21)

if(NOT PROCESSOR MATCHES "^(x86_64|AMD64|amd64|x64)$")
    if(SVO_COMPILE_OPTIONS MATCHES "avx|x86-64")
        message(FATAL_ERROR "SVO sets x86 ISA flags on ${PROCESSOR}: ${SVO_COMPILE_OPTIONS}")
    endif()
    return()
endif()

if(MSVC)
    set(_floor "/arch:AVX2")
else()
    set(_floor "-march=x86-64-v3")
endif()
if(NOT "${SVO_COMPILE_OPTIONS}" MATCHES "(^|;)${_floor}(;|$)")
    message(FATAL_ERROR "SVO lost its x86-64-v3 ISA floor (${_floor}): ${SVO_COMPILE_OPTIONS}")
endif()
if("${SVO_COMPILE_OPTIONS}" MATCHES "-mavx|-mfma|-mf16c|AVX512")
    message(FATAL_ERROR "SVO carries per-feature ISA flags beside the floor: ${SVO_COMPILE_OPTIONS}")
endif()
message(STATUS "SVO ISA floor checks passed (${_floor})")
