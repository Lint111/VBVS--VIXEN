if(NOT DEFINED VIXEN_SNAPSHOT_TEST_ROOT)
    message(FATAL_ERROR "VIXEN_SNAPSHOT_TEST_ROOT must be inside the caller's build tree")
endif()
get_filename_component(vixen_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(pin "b1576418a1ca4cf29dd22853ff3cd1aba6372c83")
set(VIXEN_KERNEL_CACHE_DIR "${VIXEN_SNAPSHOT_TEST_ROOT}")
set(snapshot "${VIXEN_KERNEL_CACHE_DIR}/sources/yeroket-${pin}")
file(MAKE_DIRECTORY "${snapshot}")
if(VIXEN_SNAPSHOT_TEST_INVALID)
    file(WRITE "${snapshot}/.archive-complete" "invalid stamp\n")
    include("${vixen_root}/cmake/VixenKernelSnapshot.cmake")
    vixen_kernel_snapshot("missing-repository" "${pin}" actual)
    message(FATAL_ERROR "invalid snapshot unexpectedly accepted")
endif()
file(WRITE "${snapshot}/.archive-complete" "${pin}\n")
# Publication is complete even if its creator has not released the writer lock.
file(LOCK "${snapshot}.lock" GUARD PROCESS TIMEOUT 0)
include("${vixen_root}/cmake/VixenKernelSnapshot.cmake")
vixen_kernel_snapshot("missing-repository" "${pin}" actual)
if(NOT actual STREQUAL snapshot)
    message(FATAL_ERROR "completed snapshot was not reused")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DVIXEN_SNAPSHOT_TEST_ROOT=${VIXEN_SNAPSHOT_TEST_ROOT}/invalid"
    -DVIXEN_SNAPSHOT_TEST_INVALID=ON -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "invalid snapshot stamp")
    message(FATAL_ERROR "invalid snapshot did not fail closed: ${output}${error}")
endif()
message(STATUS "Completed snapshot reuse is lock-free; invalid stamps still fail closed")
