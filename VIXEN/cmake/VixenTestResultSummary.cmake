# Summarize CTest JUnit output by result class. Keep result interpretation in the CMake test
# infrastructure rather than adding a second parser to the shell runner.

cmake_minimum_required(VERSION 3.19)

if(NOT DEFINED VIXEN_RESULT_PART)
    message(FATAL_ERROR "VixenTestResultSummary.cmake requires VIXEN_RESULT_PART")
endif()

set(_vixen_xml_files)
if(DEFINED VIXEN_RESULT_XML AND EXISTS "${VIXEN_RESULT_XML}")
    list(APPEND _vixen_xml_files "${VIXEN_RESULT_XML}")
endif()
if(DEFINED VIXEN_RESULT_DIR)
    file(GLOB _vixen_shard_xml LIST_DIRECTORIES FALSE "${VIXEN_RESULT_DIR}/gpu-shards/shard-*.xml")
    list(APPEND _vixen_xml_files ${_vixen_shard_xml})
endif()
list(REMOVE_DUPLICATES _vixen_xml_files)

set(_vixen_total 0)
set(_vixen_failed 0)
set(_vixen_not_built 0)
set(_vixen_skipped 0)
foreach(_vixen_xml IN LISTS _vixen_xml_files)
    file(READ "${_vixen_xml}" _vixen_text)
    string(REPLACE "\n" " " _vixen_flat "${_vixen_text}")
    string(REGEX MATCHALL "<testcase[ >]" _vixen_cases "${_vixen_flat}")
    string(REGEX MATCHALL "<failure[ >]|<error[ >]" _vixen_failures "${_vixen_flat}")
    string(REGEX MATCHALL "<skipped[ >]" _vixen_skipped_elements "${_vixen_flat}")
    string(REGEX MATCHALL "<testcase[^>]*status=[\"'](notrun|skipped)[\"']" _vixen_skipped_status "${_vixen_flat}")
    string(REGEX MATCHALL "<testcase[^>]*name=[\"'][^\"']*_NOT_BUILT[\"']" _vixen_placeholders "${_vixen_flat}")

    list(LENGTH _vixen_cases _vixen_case_count)
    list(LENGTH _vixen_failures _vixen_failure_count)
    list(LENGTH _vixen_skipped_elements _vixen_skipped_element_count)
    list(LENGTH _vixen_skipped_status _vixen_skipped_status_count)
    list(LENGTH _vixen_placeholders _vixen_placeholder_count)
    math(EXPR _vixen_xml_skipped "${_vixen_skipped_element_count}")
    if(_vixen_skipped_status_count GREATER _vixen_xml_skipped)
        set(_vixen_xml_skipped "${_vixen_skipped_status_count}")
    endif()
    math(EXPR _vixen_total "${_vixen_total} + ${_vixen_case_count}")
    math(EXPR _vixen_failed "${_vixen_failed} + ${_vixen_failure_count}")
    math(EXPR _vixen_skipped "${_vixen_skipped} + ${_vixen_xml_skipped}")
    math(EXPR _vixen_not_built "${_vixen_not_built} + ${_vixen_placeholder_count}")
endforeach()

if(_vixen_xml_files)
    math(EXPR _vixen_passed "${_vixen_total} - ${_vixen_failed} - ${_vixen_skipped} - ${_vixen_not_built}")
    if(_vixen_passed LESS 0)
        set(_vixen_passed 0)
    endif()
    message(STATUS "[run-tests-split] ${VIXEN_RESULT_PART}: passed=${_vixen_passed} failed=${_vixen_failed} not-built=${_vixen_not_built} skipped=${_vixen_skipped}")
elseif(DEFINED VIXEN_RESULT_LOG AND EXISTS "${VIXEN_RESULT_LOG}")
    # Some CTest builds accept --output-junit but do not emit the file for an empty or PRE_TEST
    # shard. Use the native summary as a bounded fallback rather than reporting no counts.
    file(READ "${VIXEN_RESULT_LOG}" _vixen_log)
    string(REGEX MATCH "[0-9]+% tests passed, [0-9]+ tests failed out of [0-9]+" _vixen_summary "${_vixen_log}")
    if(_vixen_summary MATCHES "([0-9]+)% tests passed, ([0-9]+) tests failed out of ([0-9]+)")
        set(_vixen_failed "${CMAKE_MATCH_2}")
        set(_vixen_total "${CMAKE_MATCH_3}")
        string(REGEX MATCHALL "\\(Not Run\\)|\\(Skipped\\)" _vixen_skipped_cases "${_vixen_log}")
        list(LENGTH _vixen_skipped_cases _vixen_skipped)
        if(DEFINED VIXEN_RESULT_NOT_BUILT_FILE AND EXISTS "${VIXEN_RESULT_NOT_BUILT_FILE}")
            file(STRINGS "${VIXEN_RESULT_NOT_BUILT_FILE}" _vixen_not_built_cases)
            list(LENGTH _vixen_not_built_cases _vixen_not_built)
        endif()
        math(EXPR _vixen_passed "${_vixen_total} - ${_vixen_failed} - ${_vixen_skipped} - ${_vixen_not_built}")
        if(_vixen_passed LESS 0)
            set(_vixen_passed 0)
        endif()
        message(STATUS "[run-tests-split] ${VIXEN_RESULT_PART}: passed=${_vixen_passed} failed=${_vixen_failed} not-built=${_vixen_not_built} skipped=${_vixen_skipped}")
    else()
        message(STATUS "[run-tests-split] ${VIXEN_RESULT_PART}: result counts unavailable (no JUnit XML or CTest summary)")
    endif()
else()
    message(STATUS "[run-tests-split] ${VIXEN_RESULT_PART}: passed=0 failed=0 not-built=0 skipped=0")
endif()
