# VixenTesting.cmake
#
# Configure-time runtime environment and suite metadata for CTest entries. GoogleTest's
# gtest_discover_tests() creates one CTest entry per case, so labels, fixtures and environment
# belong in its PROPERTIES rather than on the executable target.

include("${CMAKE_CURRENT_LIST_DIR}/VixenTestClass.cmake")

function(vixen_configure_ctest_gpu_environment output_variable)
    set(_environment)
    set(_library_dirs)

    if(VIXEN_WSL_DZN_ICD)
        list(APPEND _environment "VK_ICD_FILENAMES=${VIXEN_WSL_DZN_ICD}")
    endif()
    if(VIXEN_VULKAN_LAYER_PATH)
        list(APPEND _environment "VK_LAYER_PATH=${VIXEN_VULKAN_LAYER_PATH}")
    endif()
    # Tests and captures render and read back; none needs a window on the owner's desktop (stray
    # windows of concurrent lane runs cover each other and the desktop). WindowNode creates its
    # window with GLFW_VISIBLE=false when this is set. Opt back in to watch a test:
    # -DVIXEN_TEST_VISIBLE_WINDOWS=ON.
    if(NOT VIXEN_TEST_VISIBLE_WINDOWS)
        list(APPEND _environment "VIXEN_HIDDEN_WINDOW=1")
    endif()

    if(UNIX)
        if(VIXEN_WSL_DZN_LIBRARY_DIR AND IS_DIRECTORY "${VIXEN_WSL_DZN_LIBRARY_DIR}")
            list(APPEND _library_dirs "${VIXEN_WSL_DZN_LIBRARY_DIR}")
        endif()
        # libvulkan_dzn.so links libxcb-keysyms etc. from the provisioner's extracted deps, which are
        # on no loader path; without them vkCreateInstance returns VK_ERROR_INCOMPATIBLE_DRIVER.
        if(VIXEN_WSL_DZN_DEPS_LIBRARY_DIR AND IS_DIRECTORY "${VIXEN_WSL_DZN_DEPS_LIBRARY_DIR}")
            list(APPEND _library_dirs "${VIXEN_WSL_DZN_DEPS_LIBRARY_DIR}")
        endif()

        if(VIXEN_WINDOWING_CACHE_DIR)
            foreach(_candidate
                "${VIXEN_WINDOWING_CACHE_DIR}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}"
                "${VIXEN_WINDOWING_CACHE_DIR}/usr/lib")
                if(IS_DIRECTORY "${_candidate}")
                    list(APPEND _library_dirs "${_candidate}")
                endif()
            endforeach()
        endif()

        if(VULKAN_PATH)
            foreach(_candidate "${VULKAN_PATH}/lib/VulkanLoader/lib" "${VULKAN_PATH}/lib")
                if(IS_DIRECTORY "${_candidate}")
                    list(APPEND _library_dirs "${_candidate}")
                endif()
            endforeach()
        endif()

        if(DEFINED ENV{LD_LIBRARY_PATH} AND NOT "$ENV{LD_LIBRARY_PATH}" STREQUAL "")
            list(APPEND _library_dirs "$ENV{LD_LIBRARY_PATH}")
        endif()

        list(REMOVE_DUPLICATES _library_dirs)
        if(_library_dirs)
            string(JOIN ":" _ld_library_path ${_library_dirs})
            list(APPEND _environment "LD_LIBRARY_PATH=${_ld_library_path}")
        endif()
    endif()

    set(${output_variable} "${_environment}" PARENT_SCOPE)
endfunction()

# Writes the configured CTest GPU environment as a sourceable shell script, so a harness run outside
# CTest (e.g. tools/appflow_channel_gate.py driven by hand through the GPU queue) reuses the same ICD,
# layer and library paths instead of copying them from CTestTestfile by hand:
#   . <build>/vixen-gpu-env.sh
function(vixen_write_gpu_environment_script path)
    set(_content "# Generated by VixenTesting.cmake: the Vulkan environment CTest gives GPU tests.\n")
    foreach(_entry IN LISTS ARGN)
        string(FIND "${_entry}" "=" _eq)
        if(_eq GREATER 0)
            string(SUBSTRING "${_entry}" 0 ${_eq} _name)
            math(EXPR _value_start "${_eq} + 1")
            string(SUBSTRING "${_entry}" ${_value_start} -1 _value)
            string(REPLACE "'" "'\\''" _value "${_value}")
            string(APPEND _content "export ${_name}='${_value}'\n")
        endif()
    endforeach()
    file(WRITE "${path}" "${_content}")
endfunction()

function(vixen_gtest_discover_tests suite target)
    cmake_parse_arguments(PARSE_ARGV 2 VGT
        "NO_PRETTY_TYPES;NO_PRETTY_VALUES;GPU;HEADLESS"
        "DISCOVERY_MODE;DISCOVERY_TIMEOUT;WORKING_DIRECTORY;TEST_LIST;TEST_PREFIX;TEST_SUFFIX;XML_OUTPUT_DIR;TIMEOUT;PROCESSORS;FIXTURES_REQUIRED"
        "EXTRA_ARGS;TEST_ENVIRONMENT;TEST_ENVIRONMENT_MODIFICATION;GPU_TESTS;BENCHMARK_TESTS;ON_DEMAND_TESTS")

    # POST_BUILD discovery (CMake's default) runs every test binary at build time, so a parallel
    # build launches several freshly linked executables at once and a loaded box misses the timeout
    # (T-6863, T-4349). PRE_TEST defers the --gtest_list_tests call to CTest load time, where it runs
    # serially; the class stub and GPU-lock scripts already read TEST_LIST at that point.
    # Pass DISCOVERY_MODE POST_BUILD explicitly to opt back in.
    if(NOT DEFINED VGT_DISCOVERY_MODE)
        set(VGT_DISCOVERY_MODE PRE_TEST)
    endif()
    # CMake's default discovery timeout is 5 s, which a test binary can miss while the box is loaded.
    if(NOT DEFINED VGT_DISCOVERY_TIMEOUT)
        set(VGT_DISCOVERY_TIMEOUT 60)
    endif()

    set(_gtest_arguments)
    foreach(_option NO_PRETTY_TYPES NO_PRETTY_VALUES)
        if(VGT_${_option})
            list(APPEND _gtest_arguments "${_option}")
        endif()
    endforeach()
    foreach(_argument DISCOVERY_MODE DISCOVERY_TIMEOUT WORKING_DIRECTORY TEST_PREFIX TEST_SUFFIX XML_OUTPUT_DIR)
        if(DEFINED VGT_${_argument})
            list(APPEND _gtest_arguments "${_argument}" "${VGT_${_argument}}")
        endif()
    endforeach()
    if(VGT_EXTRA_ARGS)
        list(APPEND _gtest_arguments EXTRA_ARGS ${VGT_EXTRA_ARGS})
    endif()

    # GoogleTest leaves every discovered case name in a TEST_LIST variable (default <target>_TESTS);
    # the class stub reads it at CTest load time to label each case gpu or cpu.
    set(_test_list_variable "${target}_TESTS")
    if(VGT_TEST_LIST)
        set(_test_list_variable "${VGT_TEST_LIST}")
        list(APPEND _gtest_arguments TEST_LIST "${VGT_TEST_LIST}")
    elseif(VGT_GPU_TESTS)
        set(_test_list_variable "_vixen_gpu_tests_${target}")
        list(APPEND _gtest_arguments TEST_LIST "${_test_list_variable}")
    endif()
    if(VGT_GPU)
        vixen_test_class_declare(${target} GPU FIXTURES_REQUIRED ${VGT_FIXTURES_REQUIRED})
    else()
        vixen_test_class_declare(${target} FIXTURES_REQUIRED ${VGT_FIXTURES_REQUIRED})
    endif()
    vixen_test_class_environment_modification(_class_modification)

    # Classify the target before PRE_TEST discovery. CTest can load its placeholder or discovery
    # include before the per-case class hook sees a registered TEST, so the initial link class keeps
    # selection/build-edge metadata available during --show-only. The deferred hook can replace it
    # with a manifest-backed class once the case exists.
    get_target_property(_class_label ${target} VIXEN_TEST_CLASS)
    if(NOT _class_label OR _class_label MATCHES "-NOTFOUND$")
        get_target_property(_declared_gpu ${target} VIXEN_DECLARED_GPU)
        if(_declared_gpu)
            set(_class_label gpu)
        else()
            _vixen_classify_by_link(${target} _class_label _class_evidence)
        endif()
        set_property(TARGET ${target} PROPERTY VIXEN_TEST_CLASS "${_class_label}")
    endif()

    # The exe: label names the registering executable so a changed target selects its own cases;
    # ctest -L is an unanchored regex, so callers selecting cpu/gpu must anchor (^gpu$).
    # GoogleTest re-expands the property list in a second script: escape the label separator.
    set(_labels "${suite};${_class_label};exe:${target}")
    string(REPLACE ";" "\\\\;" _labels "${_labels}")
    set(_properties LABELS "${_labels}")
    # HEADLESS registers a CPU-only test (document/recipe code) with normal discovery, labels and class
    # stub but without the display / Vulkan loader / ICD environment, so it runs where none exists.
    if(VGT_HEADLESS)
        if(VGT_GPU OR VGT_GPU_TESTS)
            message(FATAL_ERROR "vixen_gtest_discover_tests(${suite} ${target}): HEADLESS cannot be combined with GPU or GPU_TESTS. "
                "Drop HEADLESS for a test that touches the device, or drop GPU/GPU_TESTS for a CPU-only test.")
        endif()
        set(_environment ${VGT_TEST_ENVIRONMENT})
    else()
        set(_environment ${VIXEN_CTEST_GPU_ENVIRONMENT} ${VGT_TEST_ENVIRONMENT})
    endif()
    if(_environment)
        string(JOIN ";" _environment_value ${_environment})
        # GoogleTest serializes properties through a second CMake script, so
        # preserve each semicolon across both list-expansion boundaries.
        string(REPLACE ";" "\\\\;" _environment_value "${_environment_value}")
        list(APPEND _properties ENVIRONMENT "${_environment_value}")
    endif()
    set(_modification_entries ${_class_modification} ${VGT_TEST_ENVIRONMENT_MODIFICATION})
    if(_modification_entries)
        string(JOIN ";" _environment_modification ${_modification_entries})
        string(REPLACE ";" "\\\\;" _environment_modification "${_environment_modification}")
        list(APPEND _properties ENVIRONMENT_MODIFICATION "${_environment_modification}")
    endif()
    if(VGT_FIXTURES_REQUIRED)
        string(REPLACE ";" "\\\\;" _fixtures_required "${VGT_FIXTURES_REQUIRED}")
        list(APPEND _properties FIXTURES_REQUIRED "${_fixtures_required}")
    endif()
    if(VGT_TIMEOUT)
        list(APPEND _properties TIMEOUT "${VGT_TIMEOUT}")
    endif()
    # CPUs the suite needs to run truly concurrent work. tools/run-tests-split.sh reads it from the
    # CTest metadata and passes it to the queue as --cpu-tokens.
    if(VGT_PROCESSORS)
        list(APPEND _properties PROCESSORS "${VGT_PROCESSORS}")
    endif()
    if(VGT_GPU)
        list(APPEND _properties RESOURCE_LOCK "vixen_gpu_device")
    endif()

    # CMake 3.29's TEST_LAUNCHER lets every discovered case make the same device-class decision,
    # including PRE_TEST discovery itself.  The launcher returns 77 for the non-smoke cases on a
    # translated device; CTest then records a skip rather than a pass.  Keep the guard at the test
    # target boundary so the many legacy GPU fixtures do not each grow a copied device probe.
    if((VGT_GPU OR VGT_GPU_TESTS) AND CMAKE_VERSION VERSION_GREATER_EQUAL "3.29")
        set_property(TARGET ${target} PROPERTY TEST_LAUNCHER
            "${CMAKE_COMMAND};-P;${CMAKE_CURRENT_FUNCTION_LIST_DIR}/VixenGpuTestLauncher.cmake")
    endif()

    if(VGT_GPU_TESTS)
        # PRE_TEST discovery creates cases at CTest run time. Its TEST_LIST variable
        # is available to TEST_INCLUDE_FILES, which can apply locks per discovered case.
        set(_gpu_test_lock_script "${CMAKE_CURRENT_BINARY_DIR}/vixen_gpu_test_locks_${target}.cmake")
        set(_gpu_test_lock_content "foreach(_vixen_gpu_test IN LISTS ${_test_list_variable})\n")
        foreach(_pattern IN LISTS VGT_GPU_TESTS)
            string(APPEND _gpu_test_lock_content
                "  if(_vixen_gpu_test MATCHES [==[${_pattern}]==])\n"
                "    set_tests_properties(\"\${_vixen_gpu_test}\" PROPERTIES RESOURCE_LOCK \"vixen_gpu_device\")\n"
                "  endif()\n")
        endforeach()
        string(APPEND _gpu_test_lock_content "endforeach()\n")
        file(WRITE "${_gpu_test_lock_script}" "${_gpu_test_lock_content}")

    endif()

    # Stage imported runtime DLLs before POST_BUILD test discovery launches the
    # executable, so discovery itself also works without a PATH workaround.
    vixen_stage_runtime_dlls_for_target(${target})
    set_property(GLOBAL APPEND PROPERTY VIXEN_REGISTERED_TEST_EXECUTABLES "${target}")
    gtest_discover_tests(${target} ${_gtest_arguments} PROPERTIES ${_properties})

    if(VGT_GPU_TESTS)
        # GoogleTest appends its discovery include while registering the target.
        # Append after it so the per-case TEST_LIST is populated before filtering.
        get_property(_directory_test_include_files DIRECTORY PROPERTY TEST_INCLUDE_FILES)
        if(NOT "${_gpu_test_lock_script}" IN_LIST _directory_test_include_files)
            set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${_gpu_test_lock_script}")
        endif()
    endif()

    if(VGT_BENCHMARK_TESTS OR VGT_ON_DEMAND_TESTS OR VGT_GPU OR VGT_GPU_TESTS)
        # PRE_TEST discovery makes the case list available here.  One generated include applies
        # all policy metadata together, so benchmark/reproduction selection and the translated GPU
        # smoke rule remain attached to the discovered test names rather than to source order.
        set(_policy_script "${CMAKE_CURRENT_BINARY_DIR}/vixen_test_policy_${target}.cmake")
        set(_policy_content "set(_vixen_policy_benchmark_tests)\n")
        string(APPEND _policy_content "set(_vixen_policy_on_demand_tests)\n")
        string(APPEND _policy_content "set(_vixen_policy_gpu_smoke_tests)\n")
        string(APPEND _policy_content "foreach(_vixen_test IN LISTS ${_test_list_variable})\n")

        if(VGT_BENCHMARK_TESTS)
            foreach(_pattern IN LISTS VGT_BENCHMARK_TESTS)
                string(APPEND _policy_content
                    "  if(_vixen_test MATCHES [==[${_pattern}]==])\n"
                    "    list(APPEND _vixen_policy_benchmark_tests \"\${_vixen_test}\")\n"
                    "    if(NOT \"\$ENV{VIXEN_RUN_BENCHMARK}\" STREQUAL \"1\")\n"
                    "      set_tests_properties(\"\${_vixen_test}\" PROPERTIES DISABLED TRUE)\n"
                    "    endif()\n"
                    "  endif()\n")
            endforeach()
        endif()

        if(VGT_ON_DEMAND_TESTS)
            foreach(_pattern IN LISTS VGT_ON_DEMAND_TESTS)
                string(APPEND _policy_content
                    "  if(_vixen_test MATCHES [==[${_pattern}]==])\n"
                    "    list(APPEND _vixen_policy_on_demand_tests \"\${_vixen_test}\")\n"
                    "    if(NOT \"\$ENV{VIXEN_RUN_ON_DEMAND}\" STREQUAL \"1\")\n"
                    "      set_tests_properties(\"\${_vixen_test}\" PROPERTIES DISABLED TRUE)\n"
                    "    endif()\n"
                    "  endif()\n")
            endforeach()
        endif()

        if(VGT_GPU OR VGT_GPU_TESTS)
            string(APPEND _policy_content "  set(_vixen_is_gpu FALSE)\n")
            if(VGT_GPU)
                string(APPEND _policy_content "  set(_vixen_is_gpu TRUE)\n")
            else()
                foreach(_pattern IN LISTS VGT_GPU_TESTS)
                    string(APPEND _policy_content
                        "  if(_vixen_test MATCHES [==[${_pattern}]==])\n"
                        "    set(_vixen_is_gpu TRUE)\n"
                        "  endif()\n")
                endforeach()
            endif()
            string(APPEND _policy_content
                "  set_tests_properties(\"\${_vixen_test}\" PROPERTIES SKIP_RETURN_CODE 77)\n"
                "  if(_vixen_is_gpu AND NOT _vixen_policy_gpu_smoke_tests\n"
                "     AND NOT _vixen_test IN_LIST _vixen_policy_benchmark_tests\n"
                "     AND NOT _vixen_test IN_LIST _vixen_policy_on_demand_tests)\n"
                "    list(APPEND _vixen_policy_gpu_smoke_tests \"\${_vixen_test}\")\n"
                "  endif()\n")
        endif()

        string(APPEND _policy_content "endforeach()\n")
        file(GENERATE OUTPUT "${_policy_script}" CONTENT "${_policy_content}")
        set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${_policy_script}")
    endif()

    # Register after the policy include: the class hook owns the single CTest property write and
    # can append benchmark/on-demand/smoke labels to the class labels and environment it derives.
    vixen_test_class_register(${target} "${_test_list_variable}" "${suite}")
endfunction()

# Plain-main() tests check with assert(); Release defines NDEBUG and compiles those checks out, so the
# test would exit 0 having verified nothing. Target options follow CMAKE_CXX_FLAGS_<CONFIG>, so this wins.
function(vixen_enable_asserts)
    foreach(_target IN LISTS ARGN)
        if(MSVC)
            target_compile_options(${_target} PRIVATE /UNDEBUG)
        else()
            target_compile_options(${_target} PRIVATE -UNDEBUG)
        endif()
    endforeach()
endfunction()

function(vixen_set_suite_properties suite)
    cmake_parse_arguments(PARSE_ARGV 1 VSP "GPU" "" "TESTS;TEST_ENVIRONMENT")
    if(NOT VSP_TESTS)
        return()
    endif()

    set(_properties LABELS "${suite}")
    set(_environment ${VIXEN_CTEST_GPU_ENVIRONMENT} ${VSP_TEST_ENVIRONMENT})
    if(_environment)
        string(JOIN ";" _environment_value ${_environment})
        string(REPLACE ";" "\\;" _environment_value "${_environment_value}")
        list(APPEND _properties ENVIRONMENT "${_environment_value}")
    endif()
    if(VSP_GPU)
        list(APPEND _properties RESOURCE_LOCK "vixen_gpu_device")
        # Plain CTest commands do not pass through a target TEST_LAUNCHER. Translated Dzn is a
        # smoke device for discovered GoogleTest families, not a full native-capture witness, so
        # keep these direct GPU commands out of the translated correctness selection. Native
        # configurations leave them enabled.
        if(VIXEN_WSL_DZN_ICD)
            list(APPEND _properties DISABLED TRUE)
        endif()
    endif()
    set_tests_properties(${VSP_TESTS} PROPERTIES ${_properties})
endfunction()

function(vixen_lock_gpu_tests)
    cmake_parse_arguments(PARSE_ARGV 0 VLG "" "" "TESTS")
    if(NOT VLG_TESTS)
        message(FATAL_ERROR "vixen_lock_gpu_tests requires TESTS")
    endif()
    set_tests_properties(${VLG_TESTS} PROPERTIES RESOURCE_LOCK "vixen_gpu_device")
    # These tests are plain CTest commands and therefore cannot use the discovered-test launcher.
    # On translated Dzn, only one launcher-marked smoke case per GoogleTest family is meaningful;
    # direct application/capture witnesses remain enabled for native configurations.
    if(VIXEN_WSL_DZN_ICD)
        set_tests_properties(${VLG_TESTS} PROPERTIES DISABLED TRUE)
    endif()
endfunction()

function(_vixen_collect_subtree_targets directory output_variable)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_subdirectory IN LISTS _subdirectories)
        get_filename_component(_subdirectory "${_subdirectory}" ABSOLUTE BASE_DIR "${directory}")
        _vixen_collect_subtree_targets("${_subdirectory}" _child_targets)
        list(APPEND _targets ${_child_targets})
    endforeach()
    set(${output_variable} "${_targets}" PARENT_SCOPE)
endfunction()

function(vixen_register_verification_targets directory)
    _vixen_collect_subtree_targets("${directory}" _suite_targets)
    set_property(GLOBAL APPEND PROPERTY VIXEN_RENDERGRAPH_SVO_BUILD_TARGETS ${_suite_targets})
endfunction()

# Writes <build>/test-executables.tsv ("<target><TAB><path>" per registered gtest executable) so a
# queued targeted witness reads the binary path instead of guessing the per-library output layout.
# Call once, after every add_subdirectory() that registers tests.
function(vixen_write_test_executable_manifest)
    get_property(_targets GLOBAL PROPERTY VIXEN_REGISTERED_TEST_EXECUTABLES)
    list(REMOVE_DUPLICATES _targets)
    list(SORT _targets)
    set(_content "")
    foreach(_target IN LISTS _targets)
        string(APPEND _content "${_target}\t$<TARGET_FILE:${_target}>\n")
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/test-executables.tsv" CONTENT "${_content}")
endfunction()
