include_guard(GLOBAL)

# Turns `apt-cache depends gdb` output into the list of gdb's direct dependency packages for the
# host's release. Skips <virtual> packages; keeps every alternative of an "A | B" dependency.
function(vixen_gdb_direct_dependency_packages out_var apt_depends_output)
    string(REPLACE "\r" "" _text "${apt_depends_output}")
    string(REPLACE "\n" ";" _lines "${_text}")
    set(_packages "")
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^[ |]+Depends: ([^<: ][^: ]*)$")
            list(APPEND _packages "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _packages)
    set(${out_var} "${_packages}" PARENT_SCOPE)
endfunction()

# The auto-provisioned gdb is extracted under <cache>/usr, so its shared libraries (libpython, libbabeltrace,
# ...) are not on the loader path and the bare binary exits 127. Writes <cache>/gdb-launcher.sh, which puts the
# cache's library directories on LD_LIBRARY_PATH and execs the provisioned gdb, and returns its path in out_var.
function(vixen_gdb_write_launcher out_var cache_dir)
    set(_launcher "${cache_dir}/gdb-launcher.sh")
    file(WRITE "${_launcher}"
"#!/bin/sh
# Generated by VIXEN ProvisionGdb.cmake: runs the provisioned gdb with its extracted libraries on the loader path.
_vixen_gdb_root=\"${cache_dir}\"
LD_LIBRARY_PATH=\"\${_vixen_gdb_root}/usr/lib/x86_64-linux-gnu:\${_vixen_gdb_root}/usr/lib:\${_vixen_gdb_root}/lib/x86_64-linux-gnu\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\"
export LD_LIBRARY_PATH
exec \"\${_vixen_gdb_root}/usr/bin/gdb\" \"\$@\"
")
    file(CHMOD "${_launcher}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    set(${out_var} "${_launcher}" PARENT_SCOPE)
endfunction()
