# Resolve CTest selection metadata without putting test-selection policy in a shell/Python runner.
#
# EDGES mode reads a CTest json-v1 listing made for the requested suite/class labels. It selects
# matching test names, keeps *_NOT_BUILT placeholders because their real GoogleTest names are not
# known until the target is built, and writes the owning exe: labels to a target list.
# VALIDATE mode checks the final listing after the target build and writes located missing-command
# diagnostics. The split runner only orchestrates these files and the queued build/run steps.

cmake_minimum_required(VERSION 3.19)

if(NOT DEFINED VIXEN_SELECTION_JSON OR NOT EXISTS "${VIXEN_SELECTION_JSON}")
    message(FATAL_ERROR "VixenTestSelection.cmake requires an existing VIXEN_SELECTION_JSON")
endif()
if(NOT DEFINED VIXEN_TARGETS_FILE)
    set(VIXEN_TARGETS_FILE "${VIXEN_SELECTION_JSON}.targets")
endif()
if(NOT DEFINED VIXEN_NOT_BUILT_FILE)
    set(VIXEN_NOT_BUILT_FILE "${VIXEN_SELECTION_JSON}.not-built")
endif()
if(NOT DEFINED VIXEN_MISSING_FILE)
    set(VIXEN_MISSING_FILE "${VIXEN_SELECTION_JSON}.missing")
endif()

file(READ "${VIXEN_SELECTION_JSON}" _vixen_json)
string(JSON _vixen_test_count LENGTH "${_vixen_json}" tests)
set(_vixen_targets)
set(_vixen_not_built)
set(_vixen_missing)
set(_vixen_metadata)
set(_vixen_executable_metadata)
if(DEFINED VIXEN_TARGET_METADATA AND EXISTS "${VIXEN_TARGET_METADATA}")
    file(STRINGS "${VIXEN_TARGET_METADATA}" _vixen_metadata_lines)
    foreach(_vixen_metadata_line IN LISTS _vixen_metadata_lines)
        if(NOT _vixen_metadata_line MATCHES "^#")
            string(REPLACE "\t" ";" _vixen_metadata_fields "${_vixen_metadata_line}")
            list(LENGTH _vixen_metadata_fields _vixen_metadata_field_count)
            if(_vixen_metadata_field_count GREATER 2)
                list(GET _vixen_metadata_fields 0 _vixen_metadata_target)
                list(GET _vixen_metadata_fields 1 _vixen_metadata_suite)
                list(GET _vixen_metadata_fields 2 _vixen_metadata_class)
                if(_vixen_metadata_class STREQUAL "cpu" OR _vixen_metadata_class STREQUAL "gpu")
                    list(APPEND _vixen_metadata "${_vixen_metadata_target}|${_vixen_metadata_suite}|${_vixen_metadata_class}")
                endif()
            endif()
        endif()
    endforeach()
endif()
if(DEFINED VIXEN_EXECUTABLE_METADATA AND EXISTS "${VIXEN_EXECUTABLE_METADATA}")
    file(STRINGS "${VIXEN_EXECUTABLE_METADATA}" _vixen_executable_metadata_lines)
    foreach(_vixen_executable_metadata_line IN LISTS _vixen_executable_metadata_lines)
        if(NOT _vixen_executable_metadata_line MATCHES "^#")
            string(REPLACE "\t" ";" _vixen_executable_metadata_fields "${_vixen_executable_metadata_line}")
            list(LENGTH _vixen_executable_metadata_fields _vixen_executable_metadata_field_count)
            if(_vixen_executable_metadata_field_count GREATER 2)
                list(GET _vixen_executable_metadata_fields 0 _vixen_executable_target)
                list(GET _vixen_executable_metadata_fields 1 _vixen_executable_path)
                list(APPEND _vixen_executable_metadata
                    "${_vixen_executable_target}|${_vixen_executable_path}")
            endif()
        endif()
    endforeach()
endif()

# string(JSON) reparses its complete input for every indexed lookup. That is acceptable for a
# narrow selection, but quadratic for the unfiltered full-suite listing. The configure-time
# registry already contains the same target/class edges, so use it for the full selection and use
# the generated executable table for validation. Filtered selections still inspect CTest JSON so
# discovered case names and per-test labels remain authoritative.
set(_vixen_fast_path FALSE)
if(_vixen_metadata
   AND (NOT DEFINED VIXEN_SUITE_REGEX OR "${VIXEN_SUITE_REGEX}" STREQUAL "")
   AND (NOT DEFINED VIXEN_TEST_REGEX OR "${VIXEN_TEST_REGEX}" STREQUAL ""))
    set(_vixen_fast_path TRUE)
    foreach(_vixen_metadata_entry IN LISTS _vixen_metadata)
        string(REPLACE "|" ";" _vixen_metadata_fields "${_vixen_metadata_entry}")
        list(GET _vixen_metadata_fields 0 _vixen_metadata_target)
        list(GET _vixen_metadata_fields 1 _vixen_metadata_suite)
        list(GET _vixen_metadata_fields 2 _vixen_metadata_class)
        if(DEFINED VIXEN_CLASS_REGEX AND NOT "${VIXEN_CLASS_REGEX}" STREQUAL ""
           AND NOT _vixen_metadata_class MATCHES "${VIXEN_CLASS_REGEX}")
            continue()
        endif()
        if(DEFINED VIXEN_EXCLUDE_SUITE_REGEX AND NOT "${VIXEN_EXCLUDE_SUITE_REGEX}" STREQUAL ""
           AND _vixen_metadata_suite MATCHES "${VIXEN_EXCLUDE_SUITE_REGEX}")
            continue()
        endif()
        set(_vixen_executable_path)
        foreach(_vixen_executable_entry IN LISTS _vixen_executable_metadata)
            string(REPLACE "|" ";" _vixen_executable_fields "${_vixen_executable_entry}")
            list(GET _vixen_executable_fields 0 _vixen_executable_entry_target)
            if(_vixen_executable_entry_target STREQUAL "${_vixen_metadata_target}")
                list(GET _vixen_executable_fields 1 _vixen_executable_path)
                break()
            endif()
        endforeach()
        # A full tree is normally already built. Only hand missing target edges to the queued
        # build; this preserves the exact-target guarantee without reserving a second full build
        # just to prove that existing executables are up to date.
        if(NOT _vixen_executable_path OR NOT EXISTS "${_vixen_executable_path}")
            list(APPEND _vixen_targets "${_vixen_metadata_target}")
        endif()
        if(DEFINED VIXEN_VALIDATE)
            if(NOT _vixen_executable_path OR NOT EXISTS "${_vixen_executable_path}")
                if(_vixen_executable_path)
                    list(APPEND _vixen_missing
                        "${_vixen_metadata_target} -> ${_vixen_executable_path}")
                else()
                    list(APPEND _vixen_missing
                        "${_vixen_metadata_target} -> <executable metadata missing>")
                endif()
            endif()
        endif()
    endforeach()
endif()

if(NOT _vixen_fast_path AND _vixen_test_count GREATER 0)
    math(EXPR _vixen_last_test "${_vixen_test_count} - 1")
    foreach(_vixen_index RANGE 0 ${_vixen_last_test})
        string(JSON _vixen_name GET "${_vixen_json}" tests ${_vixen_index} name)
        set(_vixen_placeholder FALSE)
        if(_vixen_name MATCHES "_NOT_BUILT$")
            set(_vixen_placeholder TRUE)
        endif()

        set(_vixen_labels)
        string(JSON _vixen_property_count LENGTH "${_vixen_json}" tests ${_vixen_index} properties)
        if(_vixen_property_count GREATER 0)
            math(EXPR _vixen_last_property "${_vixen_property_count} - 1")
            foreach(_vixen_property RANGE 0 ${_vixen_last_property})
                string(JSON _vixen_property_name GET "${_vixen_json}" tests ${_vixen_index} properties ${_vixen_property} name)
                if(NOT _vixen_property_name STREQUAL "LABELS")
                    continue()
                endif()

                string(JSON _vixen_label_type TYPE "${_vixen_json}" tests ${_vixen_index} properties ${_vixen_property} value)
                if(_vixen_label_type STREQUAL "ARRAY")
                    string(JSON _vixen_label_count LENGTH "${_vixen_json}" tests ${_vixen_index} properties ${_vixen_property} value)
                    if(_vixen_label_count GREATER 0)
                        math(EXPR _vixen_last_label "${_vixen_label_count} - 1")
                        foreach(_vixen_label_index RANGE 0 ${_vixen_last_label})
                            string(JSON _vixen_label GET "${_vixen_json}" tests ${_vixen_index} properties ${_vixen_property} value ${_vixen_label_index})
                            list(APPEND _vixen_labels "${_vixen_label}")
                        endforeach()
                    endif()
                elseif(_vixen_label_type STREQUAL "STRING")
                    string(JSON _vixen_label_text GET "${_vixen_json}" tests ${_vixen_index} properties ${_vixen_property} value)
                    set(_vixen_labels ${_vixen_label_text})
                endif()
            endforeach()
        endif()

        set(_vixen_metadata_target)
        set(_vixen_metadata_suite)
        set(_vixen_metadata_class)
        if(_vixen_placeholder)
            string(REGEX REPLACE "_NOT_BUILT$" "" _vixen_placeholder_target "${_vixen_name}")
            foreach(_vixen_metadata_entry IN LISTS _vixen_metadata)
                string(REPLACE "|" ";" _vixen_metadata_fields "${_vixen_metadata_entry}")
                list(GET _vixen_metadata_fields 0 _vixen_entry_target)
                if(_vixen_entry_target STREQUAL "${_vixen_placeholder_target}")
                    list(GET _vixen_metadata_fields 1 _vixen_metadata_suite)
                    list(GET _vixen_metadata_fields 2 _vixen_metadata_class)
                    set(_vixen_metadata_target "${_vixen_entry_target}")
                    break()
                endif()
            endforeach()
        endif()

        set(_vixen_selected TRUE)
        if(DEFINED VIXEN_SUITE_REGEX AND NOT "${VIXEN_SUITE_REGEX}" STREQUAL "")
            set(_vixen_suite_selected FALSE)
            if(_vixen_metadata_suite AND _vixen_metadata_suite MATCHES "${VIXEN_SUITE_REGEX}")
                set(_vixen_suite_selected TRUE)
            endif()
            foreach(_vixen_label IN LISTS _vixen_labels)
                if(_vixen_label MATCHES "${VIXEN_SUITE_REGEX}")
                    set(_vixen_suite_selected TRUE)
                endif()
            endforeach()
            if(NOT _vixen_suite_selected)
                set(_vixen_selected FALSE)
            endif()
        endif()
        if(_vixen_selected AND DEFINED VIXEN_CLASS_REGEX AND NOT "${VIXEN_CLASS_REGEX}" STREQUAL "")
            set(_vixen_class_selected FALSE)
            if(_vixen_metadata_class AND _vixen_metadata_class MATCHES "${VIXEN_CLASS_REGEX}")
                set(_vixen_class_selected TRUE)
            endif()
            foreach(_vixen_label IN LISTS _vixen_labels)
                if(_vixen_label MATCHES "${VIXEN_CLASS_REGEX}")
                    set(_vixen_class_selected TRUE)
                endif()
            endforeach()
            if(NOT _vixen_class_selected)
                set(_vixen_selected FALSE)
            endif()
        endif()
        if(_vixen_selected AND DEFINED VIXEN_TEST_REGEX AND NOT "${VIXEN_TEST_REGEX}" STREQUAL "" AND NOT _vixen_placeholder)
            if(NOT _vixen_name MATCHES "${VIXEN_TEST_REGEX}")
                set(_vixen_selected FALSE)
            endif()
        endif()
        if(NOT _vixen_selected)
            continue()
        endif()

        if(_vixen_placeholder)
            list(APPEND _vixen_not_built "${_vixen_name}")
            if(_vixen_metadata_target)
                list(APPEND _vixen_targets "${_vixen_metadata_target}")
            endif()
        endif()

        foreach(_vixen_label IN LISTS _vixen_labels)
            if(_vixen_label MATCHES "^exe:(.+)$")
                list(APPEND _vixen_targets "${CMAKE_MATCH_1}")
            endif()
        endforeach()

        if(DEFINED VIXEN_VALIDATE)
            string(JSON _vixen_command_type ERROR_VARIABLE _vixen_command_error TYPE "${_vixen_json}" tests ${_vixen_index} command)
            set(_vixen_command_missing FALSE)
            set(_vixen_command_display "<executable not found>")
            if(_vixen_command_error OR NOT _vixen_command_type STREQUAL "ARRAY")
                set(_vixen_command_missing TRUE)
            else()
                string(JSON _vixen_command_count LENGTH "${_vixen_json}" tests ${_vixen_index} command)
                if(_vixen_command_count LESS 1)
                    set(_vixen_command_missing TRUE)
                else()
                    string(JSON _vixen_command_display GET "${_vixen_json}" tests ${_vixen_index} command 0)
                    if(IS_ABSOLUTE "${_vixen_command_display}" AND NOT EXISTS "${_vixen_command_display}")
                        set(_vixen_command_missing TRUE)
                    endif()
                endif()
            endif()
            if(_vixen_command_missing)
                list(APPEND _vixen_missing "${_vixen_name} -> ${_vixen_command_display}")
            endif()
        endif()
    endforeach()
endif()

list(REMOVE_DUPLICATES _vixen_targets)
list(SORT _vixen_targets)
if(_vixen_targets)
    string(JOIN "\n" _vixen_target_text ${_vixen_targets})
    file(WRITE "${VIXEN_TARGETS_FILE}" "${_vixen_target_text}\n")
else()
    file(WRITE "${VIXEN_TARGETS_FILE}" "")
endif()

if(_vixen_not_built)
    string(JOIN "\n" _vixen_not_built_text ${_vixen_not_built})
    file(WRITE "${VIXEN_NOT_BUILT_FILE}" "${_vixen_not_built_text}\n")
else()
    file(WRITE "${VIXEN_NOT_BUILT_FILE}" "")
endif()

if(_vixen_missing)
    list(REMOVE_DUPLICATES _vixen_missing)
    list(SORT _vixen_missing)
    string(JOIN "\n" _vixen_missing_text ${_vixen_missing})
    file(WRITE "${VIXEN_MISSING_FILE}" "${_vixen_missing_text}\n")
else()
    file(WRITE "${VIXEN_MISSING_FILE}" "")
endif()
