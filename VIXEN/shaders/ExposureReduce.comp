#version 460
#extension GL_GOOGLE_include_directive : require
#include "Generated/LightingConfig.glsl"
#include "ExposureHistogram.glsl"

// Turns ExposureMeter.comp's frame histogram into the adapted exposure:
// percentile-window log-average metering, middle-grey target, EV100 clamp and
// frame-rate independent adaptation (separate brighten/darken rates). Then it
// clears the histogram for the next frame.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 1) buffer ExposureMeterResult {
    ExposureMeterState meterState;
    uint histogram[];
} result;
layout(std430, binding = 2) readonly buffer LightingConfigSSBO { LightingConfig lightingConfig; };

shared uint binCount[kExposureHistogramBins];

// Reflected-light meter calibration K = 12.5: EV100 = log2(L * 100 / K).
const float kLog2HundredOverK = 3.0;

void main() {
#ifdef VIXEN_HDR_EXPOSURE_FIXED
    // The default meter's settled reading for look-dev midday, angle 0 (round-2 measure run).
    if (gl_LocalInvocationIndex == 0u) result.meterState.log2Exposure = 1.508;
#else
    uint lane = gl_LocalInvocationIndex;
    binCount[lane] = result.histogram[lane];
    barrier();

    if (lane == 0u) {
        uint total = 0u;
        for (uint b = 0u; b < kExposureHistogramBins; ++b) total += binCount[b];

        float previous = result.meterState.log2Exposure;
        bool adapted = result.meterState.state == kExposureStateAdapted && !isnan(previous) && !isinf(previous);
        float target = adapted ? result.meterState.targetLog2Exposure : 0.0;
        if (total != 0u) {
            float lowPercent = clamp(lightingConfig.exposureLowPercent, 0.0, 100.0);
            float highPercent = clamp(lightingConfig.exposureHighPercent, lowPercent, 100.0);
            float lowCount = float(total) * lowPercent * 0.01;
            float highCount = float(total) * highPercent * 0.01;
            float below = 0.0;
            float weightedLog = 0.0;
            float weight = 0.0;
            float lastBinLog = kExposureHistogramLog2Min;
            for (uint b = 0u; b < kExposureHistogramBins; ++b) {
                float count = float(binCount[b]);
                float binLog = kExposureHistogramLog2Min + (float(b) + 0.5) / kExposureHistogramBinsPerEV;
                float taken = clamp(min(below + count, highCount) - max(below, lowCount), 0.0, count);
                weightedLog += taken * binLog;
                weight += taken;
                if (count > 0.0 && below < highCount) lastBinLog = binLog;
                below += count;
            }
            // An empty window (low == high) meters the bin holding that percentile.
            float meteredLog2 = weight > 0.0 ? weightedLog / weight : lastBinLog;
            float metered = meteredLog2 + kLog2HundredOverK;
            float minEV100 = lightingConfig.exposureMinEV100;
            float maxEV100 = max(lightingConfig.exposureMaxEV100, minEV100);
            float clampedEV100 = clamp(metered, minEV100, maxEV100);
            float key = max(lightingConfig.exposureKeyValue, 1.0e-4);
            target = log2(key) - (clampedEV100 - kLog2HundredOverK);
            result.meterState.meteredEV100 = metered;
        }

        float next = target;
        if (adapted) {
            // Exponential approach in log2 space: the remaining error decays as
            // exp(-rate * t), so N steps of dt/N equal one step of dt.
            float rate = target < previous ? lightingConfig.exposureSpeedUp
                                           : lightingConfig.exposureSpeedDown;
            float step = max(lightingConfig.exposureDeltaSeconds, 0.0) * max(rate, 0.0);
            next = step > 0.0 ? previous + (target - previous) * (1.0 - exp(-step)) : target;
        }
        result.meterState.log2Exposure = next;
        result.meterState.targetLog2Exposure = target;
        result.meterState.state = kExposureStateAdapted;
    }
    barrier();
    result.histogram[lane] = 0u;
#endif
}
