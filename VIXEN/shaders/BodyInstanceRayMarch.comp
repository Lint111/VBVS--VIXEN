#version 460
#extension GL_GOOGLE_include_directive : require

// ============================================================================
// BodyInstanceRayMarch.comp - Instanced Multi-Octree Ray Marching
// ============================================================================
// Tasks 6 + 7: For each ray, loop all body instances, transform the ray into
// each instance's octree-local space, run ESVO traversal against the
// appropriate per-body octree (identified by BodyInstance.octreeIndex), keep
// the nearest world-space hit across all instances, and shade by instance color.
//
// The ≤3 octree node/brick arrays are concatenated in the shared SSBOs (bindings
// 1 and 2).  Per-octree base offsets live in OctreeConfig.nodeArrayBase /
// brickArrayBase (new fields added in SP2 Task 5a).  A global-int macro trick
// lets the unchanged ESVOTraversal.glsl / ESVOCoefficients.glsl /
// CoordinateTransforms.glsl includes resolve against the active config element
// without any modification to those shared include files.
//
// Screen-space LOD (Task 7): before descending into any non-leaf node the
// traversal checks whether the voxel's projected footprint already covers ≥1
// pixel; if so it terminates early and returns a coarse hit.  Enabled here
// (not in the dense VoxelRayMarch.comp path) via #define LOD_ENABLED.
//
// Dense-path safety: VoxelRayMarch.comp, ESVOTraversal.glsl, and all other
// include files are NOT modified.  The only additive change to shared includes
// is a fetchESVONode override via #define below that is only active inside this
// translation unit.
// ============================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ============================================================================
// BUFFER BINDINGS
// ============================================================================
// Bindings 0 and 9 stay HERE: binding 0 (outputImage) is kept only for its
// imageSize() call (this pass no longer writes it — see MAIN below); binding 9
// (idOutputImage) is still written here, the only pass that ever does. Everything
// else (scene SSBOs, traversal machinery, TraceWorld/TraceWorldShadow) moved to
// SceneBindings.glsl (Sampled Lighting Inc3 M1, KI-018) so DirectLighting.comp
// can #include the SAME declarations instead of a hand-synced copy.

layout(binding = 0) uniform writeonly image2D outputImage;

// Per-pixel hit identity: packed (brickIndex<<10)|voxelLinearIdx, 0xFFFFFFFF on miss
layout(binding = 9) uniform writeonly uimage2D idOutputImage;

// ============================================================================
// PROCEDURAL RECIPE OCCUPANCY GRID (Lazy-Procedural-Delta-Baseline Inc0 M6 Task 13 — binding 16)
// ============================================================================
// One concatenated blob of dim^3 conservative min-|sd| floats per registered procedural
// recipe that had a derivable grid (RecipeOccupancy.h::DeriveOccupancyGrid), laid out
// x-fastest within each recipe's own [gridOffset, gridOffset+dim^3) slice — offsets/dims/
// AABB per recipe come from the SPLICED getRecipeOccupancyGrid(...) switch (see the splice
// marker below), not from any per-element metadata here. Bound as a 1-byte placeholder when
// no recipe in the scene has a grid (occupancyGrid_ empty CPU-side); traceUberRecipeBody
// only samples this when getRecipeOccupancyGrid reports gridDim>0 for the current recipeId,
// and bounds-checks the computed flat index against occupancyGrid.length() before reading —
// exactly like TierRefTableBuffer/MipPoolBuffer. NOT moved into the shared SceneBindings.glsl
// (Sampled Lighting Inc3 M1, KI-018) — this binding is specific to the procedural ray-march
// path here, not shared with DirectLighting.comp.
//
// ORDERING (Inc0 M6 × KI-018 reconciliation): this binding, the SdfCoreKernels include, and
// the VIXEN_UBER_RECIPE_SPLICE_MARKER below ALL precede #include "SceneBindings.glsl" on
// purpose. SceneBindings.glsl #includes SdfRecipes.glsl AND TraceWorld.glsl, both of which
// reference occupancyGrid[], evalRecipeField/getRecipeBoundSphere/getRecipeOccupancyGrid, and
// the VIXEN_UBER_RECIPE_SPLICED macro — every such reference is #ifdef VIXEN_UBER_RECIPE_SPLICED
// guarded, so the macro (defined by the splice at the marker) MUST already be set, and the
// occupancyGrid symbol MUST already be declared, by the time SceneBindings.glsl processes those
// includes. Placing SceneBindings.glsl before the splice would silently compile the uber-recipe
// path OUT (macro undefined at that point) — the feature would vanish at runtime, not fail loudly.
layout(std430, binding = 16) readonly buffer OccupancyGridBuffer { float occupancyGrid[]; };

// ============================================================================
// UBER-SHADER RECIPE SPLICE POINT (Lazy-Procedural-Delta-Baseline Inc0 M5 Task 11)
// ============================================================================
// UberShaderSplice.h::SpliceProceduralRecipesIntoSource injects the registered recipes'
// emitted sdfRecipe_<id>(vec3) field functions + an evalRecipeField(uint recipeId, vec3 p)
// switch dispatcher (plus getRecipeBoundSphere / getRecipeOccupancyGrid and the
// VIXEN_UBER_RECIPE_SPLICED define) HERE (textually, right after this marker line) at
// shader-build time — registration forces a recompile of this whole .comp anyway (v1: no
// metadata SSBO), so the splice happens once per Compile(), not per frame. When NO recipes are
// registered (the zero-registration case, e.g. a build that never calls RegisterProceduralRecipe)
// the marker is left in place with nothing appended after it — evalRecipeField then doesn't exist,
// and neither does anything reachable that would call it (the recipeId>=2 branch in TraceWorld.glsl
// / SdfRecipes.glsl is #ifdef VIXEN_UBER_RECIPE_SPLICED-guarded, and PROVIDER_PROCEDURAL otherwise
// falls through to the legacy traceProceduralBody path at v1's two hardcoded ids), so an unspliced
// source with zero registrations still compiles clean.
//
// MUST precede the "#include SceneBindings.glsl" line below: SceneBindings.glsl pulls in
// SdfRecipes.glsl (traceUberRecipeBody) and TraceWorld.glsl (the recipeId>=2 dispatch), both of
// which reference evalRecipeField/getRecipeBoundSphere/getRecipeOccupancyGrid — so the spliced
// symbols (and the VIXEN_UBER_RECIPE_SPLICED define) must already be declared (GLSL has no
// forward declaration/hoisting) by the time SceneBindings.glsl is processed.
//
// recipe/SdfCoreKernels.glsl (the SdfCore_* kernel set EmitProceduralFieldFunctionGlsl's output
// calls — Sphere/Box/Union/Round/... ) is included here too, for the SAME before-first-use
// reason: the spliced sdfRecipe_<id> bodies call SdfCore_* helpers, so they must already exist.
#include "recipe/SdfCoreKernels.glsl"
// VIXEN_UBER_RECIPE_SPLICE_MARKER

#include "SceneBindings.glsl"   // Sampled Lighting Inc3 M1: scene SSBOs + traversal (KI-018)

// ============================================================================
// LIGHTING CONFIG (Sampled Lighting Inc0 M3 — binding 17)
// ============================================================================
// Single LightingConfig record (kernel-codegen-generated struct, std430 —
// see Generated/LightingConfig.glsl / LightingConfig.g.h). Bound as an SSBO
// (not a UBO) because the framework emits std430 only; a std140 UBO would
// restride Light's nested array and desync from the generated C++ layout
// (see test_lightingconfig_sdi_parity.cpp). Uploaded per-frame from a ring
// buffer (LightingConfigNode). Declared here (plumbing-only) because
// BuildRenderGraph.cpp wires it into this pass's descriptor gatherer at
// binding 17 — this traversal pass no longer READS it (shading, which consumed
// it, moved to DirectLighting.comp per KI-018); a declared-but-unread SSBO
// keeps the shader's reflected binding set aligned with the CPU wiring.
#include "Generated/LightingConfig.glsl"

layout(std430, binding = 17) readonly buffer LightingConfigSSBO {
    LightingConfig lightingConfig;
};

// ============================================================================
// HIT RECORD BUFFER (Sampled Lighting Inc1 M3 — binding 18)
// ============================================================================
// Per-pixel G-buffer-equivalent, one HitRecord per dispatched pixel, indexed
// by the same flat row-major (y*width+x) addressing every full-screen compute
// pass in this codebase uses. This shader WRITES it (the march's whole output,
// as of Sampled Lighting Inc3 M1/KI-018) and reads it back once to prove the
// pack/unpack round-trips losslessly through the real SSBO; DirectLighting.comp
// re-reads this SAME buffer in its own dispatch to shade. Sized by the
// dispatch's own imageSize(outputImage) at record time — C++ allocates it to
// match (see BuildRenderGraph.cpp M3).
#include "HitRecord.glsl"

layout(std430, binding = 18) buffer HitRecordBuffer {
    HitRecord hitRecords[];
};

// ============================================================================
// SHADOW CONFIG (Sampled Lighting Inc1 M4 — binding 19)
// ============================================================================
// Single ShadowConfig record (kernel-codegen-generated struct, std430 — see
// Generated/ShadowConfig.glsl / ShadowConfig.g.h). Bound as an SSBO, mirroring
// LightingConfigSSBO's own std430-not-std140 rationale (the framework emits
// std430 only). Uploaded per-frame from a ring buffer (ShadowConfigNode).
// Declared here (plumbing-only, unread) to keep this pass's reflected binding
// set aligned with BuildRenderGraph.cpp's descriptor wiring at binding 19 — the
// shadow test it fed moved to DirectLighting.comp with the rest of shading (KI-018).
#include "Generated/ShadowConfig.glsl"

layout(std430, binding = 19) readonly buffer ShadowConfigSSBO {
    ShadowConfig shadowConfig;
};

// ============================================================================
// TEMPORAL ACCUMULATION (Sampled Lighting Inc2 M1/M2/M4 — bindings 20/21)
// ============================================================================
// Single AccumulationConfig record (kernel-codegen-generated struct, std430 — see
// Generated/AccumulationConfig.glsl / AccumulationConfig.g.h) plus the persistent
// history storage image (AccumulationHistoryNode — NOT the RenderTargetNode ring,
// which rotates every frame per KI-009; this image survives across frames by
// design). Declared here (plumbing-only, unread) to keep this pass's reflected
// binding set aligned with BuildRenderGraph.cpp's descriptor wiring at bindings
// 20/21 — the accumulate seam that consumed them moved to DirectLighting.comp (KI-018).
#include "Generated/AccumulationConfig.glsl"

layout(std430, binding = 20) readonly buffer AccumulationConfigSSBO {
    AccumulationConfig accumulationConfig;
};

// Format matches outputImage (R8G8B8A8_UNORM — AccumulationHistoryNode's own default,
// confirmed from RenderTargetNode's format). Declared but not read/written here.
layout(rgba8, binding = 21) uniform image2D historyImage;

// ============================================================================
// PREV-FRAME CAMERA MATRIX (Sampled Lighting Inc2 M3 — binding 22)
// ============================================================================
// Single PrevCameraConfig record (kernel-codegen-generated struct, std430 —
// see Generated/PrevCameraConfig.glsl / PrevCameraConfig.g.h): LAST frame's
// view*projection matrix (world -> prev-frame clip space), retained by
// CameraNode and uploaded per-frame from a ring buffer (PrevCameraConfigNode).
// Declared here (plumbing-only, unread) to keep this pass's reflected binding
// set aligned with BuildRenderGraph.cpp's descriptor wiring at binding 22 — the
// reprojection that consumes it lives in DirectLighting.comp (KI-018).
#include "Generated/PrevCameraConfig.glsl"

layout(std430, binding = 22) readonly buffer PrevCameraConfigSSBO {
    PrevCameraConfig prevCameraConfig;
};

// ============================================================================
// MAIN (Sampled Lighting Inc3 M1, KI-018: TRAVERSAL ONLY)
// ============================================================================
// Shading (computeLightingWithShadows), the temporal-accumulation blend, and
// the outputImage/historyImage writes moved to the new DirectLighting.comp
// pass — this shader now writes ONLY HitRecord (the G-buffer boundary) and
// the pick-ID image, plus its own trace-metrics. DirectLighting.comp reads
// HitRecord back and owns everything downstream of "what did the ray hit."
// LightingConfig/ShadowConfig/AccumulationConfig/historyImage/PrevCameraConfig
// (bindings 17/19/20/21/22) are still DECLARED here (plumbing-only, unread) so
// this pass's reflected binding set stays aligned with BuildRenderGraph.cpp's
// descriptor wiring — but this pass never reads them for anything but shading,
// which now lives in DirectLighting.comp (see BuildRenderGraph.cpp: those
// bindings are ALSO gathered into DirectLighting's own descriptor gatherer).
// outputImage (binding 0) stays declared — still used for imageSize(outputImage)
// to derive the dispatch's pixel bounds — but is no longer written here.

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize     = imageSize(outputImage);

    if (pixelCoords.x >= imgSize.x || pixelCoords.y >= imgSize.y) return;

    vec2 uv = (vec2(pixelCoords) + 0.5) / vec2(imgSize);
    vec3 rayOrigin = pc.cameraPos;
    vec3 rayDir    = getRayDir(uv);

    // -----------------------------------------------------------------------
    // Record metrics once for the dominant hit
    // -----------------------------------------------------------------------
    recordRayStart();

    // -----------------------------------------------------------------------
    // Single traversal seam (Sampled Lighting Inc1 M1): procedural + ESVO
    // instance loop, nearest-hit across all body instances.
    // -----------------------------------------------------------------------
    WorldHit worldHit;
    bool anyHit = TraceWorld(rayOrigin, rayDir, 0.0, 1e30, worldHit);

    // -----------------------------------------------------------------------
    // Baked-Perf M5 Task 5.4 (far-hit rejection) -- IMPLEMENTED BUT DISABLED,
    // NOT SHIPPED THIS MILESTONE. Using the winning instance's TIGHT trace
    // bounds (Task 5.1), the design discards hits whose reconstructed worldPos
    // falls outside the body's own allocated-brick AABB (+eps): backWall's
    // (octreeIndex 2) live diagnostic hits show worldPos.z far outside the
    // wall's true surface (e.g. z=-27 instead of the true z=4-6) across NEARLY
    // ITS ENTIRE VISIBLE REGION, not just grazing/silhouette edges -- i.e. the
    // underlying traversal corruption this task targets is severe enough for
    // backWall specifically that rejecting every corrupted hit also rejects
    // effectively the whole body (verified live: enabling this block drops
    // backWall to 0 visible pixels; every OTHER body's far-hit corruption
    // (~1% residual OOB) is fixed correctly by the SAME logic below with a
    // one-brick-footprint epsilon -- see the retained implementation's own
    // comment for that derivation). A per-body/per-axis exemption or epsilon
    // special-case would be a band-aid on top of a real, deeper problem: this
    // needs the traversal-level fix (Task 5.2's cull genuinely CONSTRAINING
    // the march, not just fast-rejecting before it -- blocked this milestone
    // by a separate ESVO ray-setup coordinate-frame issue, see Task 5.2's own
    // comment) or the Phase-2 per-axis box bake grids already on the backlog.
    // Disabled (not deleted) so the correct logic ships pre-validated for
    // whoever picks up the real fix -- flip this back to `if (anyHit ...)`
    // once backWall's corruption is fixed at the traversal level, and this
    // block will then finish the OOB cleanup for the whole scene.
    if (false && anyHit && worldHit.instIdx != 0xFFFFFFFFu) {
        BodyInstance winner = bodyInstances[worldHit.instIdx];
        if (winner.providerKind == PROVIDER_STORED) {
            uint winnerOi = winner.octreeIndex;
            vec3 tbMin, tbMax;
            bool tight = getOctreeTraceBounds(winnerOi, tbMin, tbMax);
            if (tight) {
                // World-space AABB of the winning instance's tight bounds: same
                // worldPos + (localToWorld * local) * renderScale mapping
                // TraceWorld's de-instancing (and InstanceSort.h's
                // traceBoundsWorldCenterOf, Task 5.3) already use. mat3(...) takes
                // just the linear part (SerializeSdf's localToWorld is a pure
                // uniform scale, no rotation, but this form is correct even if
                // that ever changes, matching TraceWorld's own mat3(...) usage).
                mat3 l2wLinear = mat3(configs[winnerOi].localToWorld);
                vec3 worldBoundsMin = winner.worldPos + (l2wLinear * tbMin) * winner.renderScale;
                vec3 worldBoundsMax = winner.worldPos + (l2wLinear * tbMax) * winner.renderScale;

                // A fixed 1e-3-world epsilon is many orders of magnitude smaller than ONE
                // BRICK's own world footprint -- traceBoundsMin/Max (Task 5.1) is quantized
                // to whole allocated BRICK cells (brickCellMin/bpa), not the true sub-brick
                // surface position, so a real surface can legitimately sit up to one brick's
                // world-size inside the tight-bounds boundary. The dimensionally-principled
                // margin is exactly one brick's own world footprint: (1/bricksPerAxis) of the
                // local [0,1]^3 cube, scaled to world units the SAME way tbMin/tbMax
                // themselves are (kWorldGridSize * renderScale) -- undoes exactly the one
                // brick of quantization traceBoundsMin/Max's own derivation introduces, no
                // more. Verified live: this margin correctly stops rejecting leftWall/
                // rightWall/floor/ceiling's genuine near-boundary hits while still catching
                // ~99% of the pre-existing far-hit OOB corruption on those bodies.
                float bpa = float(configs[winnerOi].bricksPerAxis);
                float worldGridSize = l2wLinear[0][0];  // uniform scale factor (kWorldGridSize)
                float brickWorldEps = (bpa > 0.0) ? (worldGridSize * winner.renderScale / bpa) : 0.0;
                vec3 hitWorldPos = rayOrigin + rayDir * worldHit.t;
                bool inBounds =
                    all(greaterThanEqual(hitWorldPos, worldBoundsMin - vec3(brickWorldEps))) &&
                    all(lessThanEqual(hitWorldPos, worldBoundsMax + vec3(brickWorldEps)));
                if (!inBounds) {
                    anyHit = false;  // reject: treat as a miss, not a clamped/corrupted hit
                }
            }
        }
    }

    // -----------------------------------------------------------------------
    // HitRecord round-trip (Sampled Lighting Inc1 M3): pack WorldHit into the
    // per-pixel HitRecord layout, write it to the real SSBO, then read it back
    // and unpack — DirectLighting.comp's shade path consumes ONLY the
    // unpacked copy (its own re-read of this SSBO), so a lossy pack/unpack or
    // a broken SSBO write shows up as a visible regression against the
    // byte-identity baseline, not just a passing in-register value. worldPos
    // is reconstructed the same way the shade path needs it:
    // rayOrigin + rayDir*t (TraceWorld returns t, not a world position — see
    // WorldHit's field list).
    // -----------------------------------------------------------------------
    HitRecord rec;
    rec.albedo      = worldHit.color;
    rec.roughness   = worldHit.roughness;
    rec.worldNormal = worldHit.normal;
    rec.hitT        = worldHit.t;
    rec.worldPos    = rayOrigin + rayDir * worldHit.t;
    rec.flags       = anyHit ? HITRECORD_FLAG_HIT : 0u;
    // M3 round 3 (2026-07-14): stash the winning instance index in HitRecord's own spare
    // padding (a real, always-64-byte field, test_hitrecord_sdi_parity.cpp's own layout
    // assert is unaffected) -- a Cornell-demo diagnostic aid for localizing a stray
    // out-of-bounds hit, cheap enough (one extra uint write, no new binding) to leave
    // permanently available rather than scaffolding it in/out per round the way M1
    // round 4's own g_cornellDiagWinnerInstIdx was.
    rec._pad0       = uint[3](worldHit.instIdx, 0u, 0u);

    uint hitRecordIdx = uint(pixelCoords.y) * uint(imgSize.x) + uint(pixelCoords.x);
    hitRecords[hitRecordIdx] = rec;

    HitRecord recReadback = hitRecords[hitRecordIdx];

    // anyHitRT (not the original anyHit) drives everything below, so a lossy
    // pack/unpack would visibly break the byte-identity gate rather than
    // being silently masked by using the pre-round-trip locals.
    bool  anyHitRT       = (recReadback.flags & HITRECORD_FLAG_HIT) != 0u;
    uint  bestBrickIndex = worldHit.brickIndex;  // not carried by HitRecord (brick/voxel ID stays out-of-band via idOutputImage)
    uint  bestVoxelIdx   = worldHit.voxelIdx;

    // ID buffer: encode absolute brick + voxel (same packing as VoxelRayMarch).
    // Needs only anyHitRT + brick/voxel identity — no shading dependency — so
    // this pass keeps owning the write (DirectLighting.comp never touches it).
    uint pickID = anyHitRT
        ? ((bestBrickIndex << 10u) | (bestVoxelIdx & 0x3FFu))
        : 0xFFFFFFFFu;
    imageStore(idOutputImage, pixelCoords, uvec4(pickID, 0u, 0u, 0u));

    // Metrics
    bool earlyTerm = false; // no single iteration count with multiple instances
    recordRayEnd(anyHitRT, earlyTerm);
}
