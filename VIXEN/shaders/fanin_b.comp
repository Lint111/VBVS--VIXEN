// fanin_b.comp — auto-sync FrameGraph P5b M2 fan-in demo (producer B).
// Independent producer: writes a distinct pattern into storage buffer bufB. Its OWN
// submit / OWN SubmitGroup; NO binary handoff to the consumer — the consumer waits
// its completion SOLELY via the baked timeline edge (the 2nd fan-in edge).
#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Binding 0: bufB (one vec4 per pixel). WRITE-ONLY (producer).
layout(std430, binding = 0) writeonly buffer BufB {
    vec4 data[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) {
        return;
    }
    uint idx = y * pc.width + x;
    // Pattern B: a blue gradient (blue ramps left→right, green ramps with y) — visually
    // distinct from pattern A so the two halves of the screen read differently.
    data[idx] = vec4(
        0.0,
        float(y) / float(pc.height),  // G ramps top→bottom
        float(x) / float(pc.width),   // B ramps left→right
        1.0
    );
}
