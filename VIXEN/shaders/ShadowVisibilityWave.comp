#version 460
#extension GL_GOOGLE_include_directive : require

// ============================================================================
// ShadowVisibilityWave.comp - the DERIVED-REQUEST shadow wave (wavefront W1b)
// ============================================================================
// (undertow docs/plans/2026-08-04-wavefront-recipe-shading.md § W1b — authoritative)
//
// Answers the production direct-lighting shadow question for every pixel in
// ONE traversal-only pass, so SpatialReuseShade's default variant never
// traces. No request buffer exists — the analytic-light rays are FULLY
// DERIVABLE from data this wave reads itself (the user bandwidth ruling:
// derivable rays ship ANSWERS, not questions): origin/normal from the pixel's
// HitRecord, direction from LightingConfig's lights[], tmax from ShadowConfig.
// The answer is a per-pixel VISIBILITY BITMASK written into the HitRecord's
// own spare word, riding the 64-B record the shade pass already fetches —
// zero new buffers, zero extra read streams.
//
// HitRecord._pad0 ledger (the shared-slot contract — HitRecord.glsl is the
// master copy of this ledger):
//   [0] = WorldHit.instIdx (written by the march, M3 round 3 — NEVER touched
//         here; the Cornell diagnostics read it back, and W2's recipe-bucketed
//         shade resolves pixel→instance→recipe through it).
//   [1] = WorldHit.emission (written by the march — NEVER touched here).
//   [2] = THIS WAVE's visibility answers; the wave read-modify-writes ONLY
//         this word. Bits 0..3 = analytic-light visibility (bit i = light i
//         unoccluded; all-ones for miss pixels / disabled shadows / lights
//         past lightCount — exact-math-safe: the shade pass only consumes a
//         bit when NdotL>0 for that light, mirroring the merged shader's own
//         NdotL-before-trace gate). Bit 4 = reserved for the ReSTIR
//         reservoir-ray answer (opt-in path; unwritten until W2's seam).
//   Under VIXEN_SHADOW_DBG the M10 diagnostic stashes over all three for its
//   ONE diagnosed pixel — ordering-safe: that stash happens in the shade pass
//   AFTER the light loop consumed [2], and the march + this wave rewrite the
//   record next frame.
//
// Dispatch: 1D over hitRecords.length() (slot = linear pixel index — no
// extent plumbing; the buffer is already sized width×height by the march's
// own extent-driven node). Runs between the march (record producer) and
// SpatialReuseShade (record consumer): march→wave RAW, wave→shade RAW on the
// SAME buffer resource.
//
// Includes the FULL scene set: TraceWorldShadow walks the same resident scene
// every traversal pass walks (SceneBindings.glsl is the single traversal
// seam). The shared push block rides along — the ProbeUpdate-family
// precedent: pc.instanceCount (field 10) bounds the instance loop (an
// unconnected/zero value makes EVERY ray a guaranteed miss), and
// pc.raySizeCoef/raySizeBias (fields 8/9) feed the any-hit LOD gate.
// ============================================================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "SceneBindings.glsl"

#include "Generated/LightingConfig.glsl"

layout(std430, binding = 16) readonly buffer LightingConfigSSBO {
    LightingConfig lightingConfig;
};

#include "HitRecord.glsl"

// NON-readonly by design: this wave is the bitmask writer (RMW of _pad0[2]
// only — every other field is the march's, preserved untouched).
layout(std430, binding = 17) buffer HitRecordBuffer {
    HitRecord hitRecords[];
};

#include "Generated/ShadowConfig.glsl"

layout(std430, binding = 18) readonly buffer ShadowConfigSSBO {
    ShadowConfig shadowConfig;
};

#ifdef VIXEN_HIT_ACCUM_FUSED
// ============================================================================
// FUSED HIT ACCUMULATION (wavefront W3c-1) — the (recipeId, cell@mip) tail
// rides THIS pass because it already reads every hit record: the standalone
// accumulate stage paid ~2 ms (Dozen) just to re-read 16 MB of records (the
// dispatch-pattern readout's fix #1). Same protocol as the retired
// HitAccumulate.comp: epoch-stamped entries, transient-handshake reclaim,
// double-hashed probing — totals verified EXACT by the shutdown diag.
// bodyInstances rides SceneBindings (binding 10, already included). Per-frame
// params ride ONE host-written SSBO (NEVER push constants — they bake at
// command-record time per ring slot; the W3b finding).
// ============================================================================
#include "HitAccumulationCommon.glsl"

layout(std430, binding = 21) buffer HitAccumTable {
    HitAccumEntryGpu accumEntries[];
};

struct HitAccumParams {
    uint  frameEpoch;
    float primaryCoef;   // the PRIMARY cone coefficient (RaySizeCoefNode's value — NOT pc.raySizeCoef, which carries the SECONDARY constant on this stage)
    float primaryBias;
    float detailSize0;
    vec4  camPos;        // xyz used
    vec4  camForward;    // xyz used
};
layout(std430, binding = 22) readonly buffer HitAccumParamsSSBO {
    HitAccumParams hitAccumParams;
};

void FusedHitAccumulate(uint slot, HitRecord rec) {
    if (hitAccumParams.primaryCoef <= 0.0) return;
    float footprint = rec.hitT * hitAccumParams.primaryCoef + hitAccumParams.primaryBias;
    uint mip = HitAccumSelectMip(footprint, hitAccumParams.detailSize0);
    if (mip == 0u) return;  // per-ray exact — the fail-soft path

    uint instIdx = rec._pad0[0];
    if (instIdx >= bodyInstances.length()) return;
    uint recipeId = bodyInstances[instIdx].recipeId;

    float cellSize = HitAccumCellSize(mip, hitAccumParams.detailSize0);
    ivec3 cell   = HitAccumCellCoord(rec.worldPos, cellSize);
    ivec3 anchor = HitAccumAnchorCell(hitAccumParams.camPos.xyz, hitAccumParams.camForward.xyz,
                                      hitAccumParams.primaryCoef, hitAccumParams.detailSize0, mip);
    uint keyLo = HitAccumPackCellKeyLo(cell, anchor);
    if (keyLo == 0u) return;
    uint keyHiBase = HitAccumPackCellKeyHi(recipeId, mip);
    if (keyHiBase == 0u) return;

    uint myEpoch = hitAccumParams.frameEpoch & 0xFFFFFu;
    if (myEpoch == 0xFFFFFu) myEpoch = 0u;
    uint keyHi = keyHiBase | myEpoch;
    uint kTransient = keyHiBase | 0xFFFFFu;

    uint baseSlot = HitAccumSlotOf(keyLo, keyHiBase);
    uint stride = HitAccumProbeStride(keyLo);
    bool claimed = false;
    uint tableSlot = 0u;
    for (uint probe = 0u; probe < kHitAccumProbeLimit; ++probe) {
        uint s = (baseSlot + probe * stride) % kHitAccumTableCapacity;
        uint oldLo = atomicCompSwap(accumEntries[s].keyLo, 0u, keyLo);
        if (oldLo != 0u && oldLo != keyLo) continue;
        if (oldLo == 0u) {
            atomicExchange(accumEntries[s].keyHi, keyHi);
            tableSlot = s; claimed = true; break;
        }
        uint hiRead = atomicAdd(accumEntries[s].keyHi, 0u);
        if ((hiRead & 0xFFF00000u) != keyHiBase) continue;
        if ((hiRead & 0xFFFFFu) == myEpoch) { tableSlot = s; claimed = true; break; }
        if (hiRead == kTransient) continue;
        if (atomicCompSwap(accumEntries[s].keyHi, hiRead, kTransient) == hiRead) {
            atomicExchange(accumEntries[s].count, 0u);
            atomicExchange(accumEntries[s].sumPosQX, 0); atomicExchange(accumEntries[s].sumPosQY, 0); atomicExchange(accumEntries[s].sumPosQZ, 0);
            atomicExchange(accumEntries[s].sumDirQX, 0); atomicExchange(accumEntries[s].sumDirQY, 0); atomicExchange(accumEntries[s].sumDirQZ, 0);
            atomicExchange(accumEntries[s].sumDistQ, 0);
            atomicExchange(accumEntries[s].sumTpQX, 0); atomicExchange(accumEntries[s].sumTpQY, 0); atomicExchange(accumEntries[s].sumTpQZ, 0);
            atomicExchange(accumEntries[s].keyHi, keyHi);
            tableSlot = s; claimed = true; break;
        }
    }
    if (!claimed) return;

    vec3 cellOrigin = vec3(cell) * cellSize;
    vec3 local = (rec.worldPos - cellOrigin) / cellSize;
    vec3 dir = normalize(rec.worldPos - hitAccumParams.camPos.xyz);
    atomicAdd(accumEntries[tableSlot].sumPosQX, int(round(local.x * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumPosQY, int(round(local.y * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumPosQZ, int(round(local.z * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQX, int(round(dir.x * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQY, int(round(dir.y * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQZ, int(round(dir.z * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDistQ, int(round(rec.hitT * kHitAccumPosScale / cellSize)));
    atomicAdd(accumEntries[tableSlot].sumTpQX, int(kHitAccumThroughputScale));
    atomicAdd(accumEntries[tableSlot].sumTpQY, int(kHitAccumThroughputScale));
    atomicAdd(accumEntries[tableSlot].sumTpQZ, int(kHitAccumThroughputScale));
    atomicAdd(accumEntries[tableSlot].count, 1u);
}
#endif  // VIXEN_HIT_ACCUM_FUSED

#ifdef VIXEN_WAVE_RESERVOIR_PHASE
// ============================================================================
// RESERVOIR PHASE (wavefront W2a) — a SECOND dispatch of this program, as its
// own compiled variant, running post-SpatialReuseGather: derives the combined
// reservoir's chosen-sample shadow ray from (combined reservoir + HitRecord),
// traces it, and answers _pad0[2] BIT 4 — the analytic phase (the default
// variant, bits 0..3) already ran earlier in the frame and is preserved by
// RMW here. Dispatched ONLY when the reservoir path is enabled (same CPU gate
// as the gather). Trace formula is VERBATIM the pre-split inline shade's
// (origin + biasEpsilon along the normal, tmax = the actual light distance —
// NOT maxShadowDistance) so the answer is bit-equal to what the merged shader
// computed.
// ============================================================================
#include "Generated/ReservoirRecord.glsl"

layout(std430, binding = 19) readonly buffer SpatialReservoirDebugBuffer {
    ReservoirRecord combinedReservoirs[];
};

#include "Generated/LightTreeBuffer.glsl"

layout(std430, binding = 20) readonly buffer LightTreeBufferSSBO {
    LightTreeBuffer lightTreeBuffer;
};

// reservoirUnbiasedWeight for the W>0 gate (mirrors the apply's own gate so a
// zero-weight reservoir skips the trace exactly as the merged shader did).
#include "ReservoirCombine.glsl"

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= hitRecords.length()) return;

    uint flags = hitRecords[slot].flags;
    if ((flags & HITRECORD_FLAG_HIT) == 0u) return;

    ReservoirRecord current = combinedReservoirs[slot];
    if (current.y == 0xFFFFFFFFu || current.y >= lightTreeBuffer.nodeCount) return;

    vec3 worldPos    = hitRecords[slot].worldPos;
    vec3 worldNormal = hitRecords[slot].worldNormal;

    LightTreeGpuNode chosen = lightTreeBuffer.nodes[current.y];
    vec3 toLight = chosen.worldPos - worldPos;
    float dist2 = max(dot(toLight, toLight), 1e-4);
    vec3 lightDir = toLight * inversesqrt(dist2);

    // NdotL/W gate BEFORE the trace (audit C3, verbatim from the merged
    // shader): either factor zero makes the term provably zero — bit 4 stays 0
    // and the apply's own identical gates never consume it.
    float NdotL = max(dot(worldNormal, lightDir), 0.0);
    float W = reservoirUnbiasedWeight(current);
    if (NdotL <= 0.0 || W <= 0.0) return;

    bool visible = true;
    if (shadowConfig.enabled != 0u) {
        vec3 shadowOrigin = worldPos + worldNormal * shadowConfig.biasEpsilon;
        float lightDist = sqrt(dist2);
        visible = !TraceWorldShadow(shadowOrigin, lightDir, 0.0, lightDist);
    }

    if (visible) {
        // RMW: preserve the analytic phase's bits 0..3, set only bit 4.
        hitRecords[slot]._pad0[2] = (hitRecords[slot]._pad0[2] & 0xFu) | 0x10u;
    }
}

#else  // the ANALYTIC phase (default variant) — bits 0..3


void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= hitRecords.length()) return;

    // Default answer: every light visible. Covers miss pixels (no surface to
    // shadow), shadowConfig.enabled==0 (the merged shader's shadowFactor=1.0
    // no-trace path), lights past lightCount, and NdotL<=0 lights (whose bit
    // is never consumed — the shade pass gates on NdotL first, exactly as the
    // merged shader gated before tracing).
    uint visBits = 0xFFFFFFFFu;

    uint flags = hitRecords[slot].flags;
    if ((flags & HITRECORD_FLAG_HIT) != 0u && shadowConfig.enabled != 0u) {
        vec3 worldPos    = hitRecords[slot].worldPos;
        vec3 worldNormal = hitRecords[slot].worldNormal;
        vec3 shadowOrigin = worldPos + worldNormal * shadowConfig.biasEpsilon;

        for (uint i = 0u; i < lightingConfig.lightCount; ++i) {
            Light light = lightingConfig.lights[i];
            vec3 lightDir = normalize(light.direction_or_position);

            // Same NdotL-before-trace gate as the merged shader (audit C3):
            // a light the surface faces away from contributes provably zero,
            // so its trace is skipped and its bit stays 1 (never consumed).
            float NdotL = max(dot(worldNormal, lightDir), 0.0);
            if (NdotL <= 0.0) continue;

            bool occluded = TraceWorldShadow(shadowOrigin, lightDir,
                                             0.0,
                                             shadowConfig.maxShadowDistance);
            if (occluded) visBits &= ~(1u << i);
        }
    }

    // Mask to the analytic bits this phase owns — bit 4 (the ReSTIR answer)
    // belongs to the reservoir phase's post-gather dispatch (an unmasked
    // all-ones init would silently flip the opt-in from zero-contribution to
    // UNSHADOWED-contribution). This phase runs FIRST, so a plain store (not
    // RMW) is correct: it re-baselines the word each frame; the reservoir
    // phase RMWs bit 4 in afterwards.
    hitRecords[slot]._pad0[2] = visBits & 0xFu;

#ifdef VIXEN_HIT_ACCUM_FUSED
    // W3c-1: the accumulate tail rides the record this pass already holds —
    // zero extra record traffic (the retired standalone pass's whole cost).
    if ((flags & HITRECORD_FLAG_HIT) != 0u) {
        FusedHitAccumulate(slot, hitRecords[slot]);
    }
#endif
}

#endif  // VIXEN_WAVE_RESERVOIR_PHASE
