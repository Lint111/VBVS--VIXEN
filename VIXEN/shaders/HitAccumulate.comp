#version 460
#extension GL_GOOGLE_include_directive : require

// ============================================================================
// HitAccumulate.comp — Wavefront W3b: the (recipeId, cell@mip) accumulate pass
// (undertow docs/plans/2026-08-04-wavefront-recipe-shading.md § "W3 design")
// ============================================================================
// NO CLEAR PASS EXISTS (the Dozen readout's fix #2, forced early by the diag's
// exit-boundary race finding): entries are EPOCH-STAMPED — keyHi[19:0] carries
// the frame epoch, and a slot whose epoch differs from the current frame's is
// STALE and reclaimed in place (keyHi CAS arbitrates; the winner zeroes sums).
// This kills the 1.3 ms clear dispatch, the clear→accumulate hazard, AND the
// trailing-clear-at-exit race that zeroed every readback (waterfall-diagnosed:
// mode-1 ran at full tilt — 36.5K hits/frame accumulating — while the exit
// boundary's final clear wiped the table before every shutdown map).
//
// Per record: hit-gate, footprint = hitT·raySizeCoef + raySizeBias
// (TraceWorld.glsl:232's own primary cone formula, twinned), mip select; mip 0
// or an out-of-range pack -> FAIL-SOFT (the record stays per-ray, today's
// path); else claim/find the cell's slot and atomicAdd the fixed-point sums.
//
// Standalone binding namespace (the SpatialReuseGather precedent) — no scene
// traversal, no images. Own push block (the gather's shape): extents + camera
// position (per-frame constant) + the primary cone fields + detailSize0 + mode.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "HitAccumulationCommon.glsl"
#include "HitRecord.glsl"

layout(std430, binding = 0) readonly buffer HitRecordBuffer {
    HitRecord hitRecords[];
};

// Byte-identical to the shared BodyInstanceGpu layout (SceneBindings binding 10),
// declared standalone (the specialized-kernel precedent).
struct BodyInstance {
    vec3  worldPos;
    float renderScale;
    vec3  color;
    uint  octreeIndex;
    uint  providerKind;
    uint  recipeId;
    float recipeParams[6];
};
layout(std430, binding = 1) readonly buffer BodyInstanceBuffer { BodyInstance bodyInstances[]; };

layout(std430, binding = 2) buffer HitAccumTable {
    HitAccumEntryGpu accumEntries[];
};

// Per-frame epoch — a HOST-WRITTEN buffer, NOT a push constant: push values
// bake at command-record time per flight-ring slot (found live: the epoch
// froze at two alternating values and entries folded ~60 frames together).
layout(std430, binding = 3) readonly buffer HitAccumEpochSSBO {
    uint frameEpochValue;
};

layout(push_constant) uniform Push {
    uint  imgWidth;
    uint  imgHeight;
    float raySizeCoef;   // the PRIMARY cone's coefficient (pc field 8's source)
    float raySizeBias;
    float detailSize0;   // engagement threshold (world units at mip 0)
    vec3  camPos;        // current camera position (per-frame constant node)
    vec3  camForward;    // current camera forward (per-frame constant node — anchor centering)
} pc;

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= hitRecords.length()) return;
    HitRecord rec = hitRecords[slot];
    if ((rec.flags & HITRECORD_FLAG_HIT) == 0u) return;

    // LOD-disabled builds (raySizeCoef == 0, TraceWorld's own gate) never engage.
    if (pc.raySizeCoef <= 0.0) return;
    float footprint = rec.hitT * pc.raySizeCoef + pc.raySizeBias;
    uint mip = HitAccumSelectMip(footprint, pc.detailSize0);
    if (mip == 0u) return;  // per-ray exact — the fail-soft path

    uint instIdx = rec._pad0[0];
    if (instIdx >= bodyInstances.length()) return;
    uint recipeId = bodyInstances[instIdx].recipeId;

    float cellSize = HitAccumCellSize(mip, pc.detailSize0);
    ivec3 cell   = HitAccumCellCoord(rec.worldPos, cellSize);
    ivec3 anchor = HitAccumAnchorCell(pc.camPos, pc.camForward, pc.raySizeCoef, pc.detailSize0, mip);
    uint keyLo = HitAccumPackCellKeyLo(cell, anchor);
    if (keyLo == 0u) return;  // out of anchored range — fail-soft, never aliased
    uint keyHiBase = HitAccumPackCellKeyHi(recipeId, mip);
    if (keyHiBase == 0u) return;
    // keyHi[19:0] carries the frame EPOCH — NO clear pass exists: a slot whose
    // epoch differs is STALE and reclaimed in place (the keyHi CAS arbitrates;
    // the winner zeroes the sums via exchange — racers between the CAS and the
    // zeroing can lose their adds, a bounded first-touch-of-cell loss in an
    // optimization layer, documented in the W3 design's clear-elimination fix).
    uint myEpoch = frameEpochValue & 0xFFFFFu;
    if (myEpoch == 0xFFFFFu) myEpoch = 0u;  // 0xFFFFF is the TRANSIENT marker
    uint keyHi = keyHiBase | myEpoch;
    uint kTransient = keyHiBase | 0xFFFFFu;

    uint baseSlot = HitAccumSlotOf(keyLo, keyHiBase);
    uint stride = HitAccumProbeStride(keyLo);
    bool claimed = false;
    uint tableSlot = 0u;
    for (uint probe = 0u; probe < kHitAccumProbeLimit; ++probe) {
        uint s = (baseSlot + probe * stride) % kHitAccumTableCapacity;
        uint oldLo = atomicCompSwap(accumEntries[s].keyLo, 0u, keyLo);
        if (oldLo != 0u && oldLo != keyLo) continue;   // different cell — probe on
        if (oldLo == 0u) {
            // Fresh slot (zeros since boot): publish hi and go.
            atomicExchange(accumEntries[s].keyHi, keyHi);
            tableSlot = s; claimed = true; break;
        }
        uint hiRead = atomicAdd(accumEntries[s].keyHi, 0u);
        if ((hiRead & 0xFFF00000u) != keyHiBase) continue;  // recipe/mip collision — duplicate path
        if ((hiRead & 0xFFFFFu) == myEpoch) {
            tableSlot = s; claimed = true; break;           // current-frame entry — join
        }
        if (hiRead == kTransient) continue;  // mid-reclaim zeroing — take a DUPLICATE slot, never a lost add
        // Stale epoch: reclaim via the TRANSIENT handshake — the winner zeroes
        // BEFORE publishing the new epoch, so no racer can add into the zeroing
        // window (the diag measured that loss at ~0.3 rays/cell/frame; the
        // handshake converts it into benign duplicates instead).
        if (atomicCompSwap(accumEntries[s].keyHi, hiRead, kTransient) == hiRead) {
            atomicExchange(accumEntries[s].count, 0u);
            atomicExchange(accumEntries[s].sumPosQX, 0); atomicExchange(accumEntries[s].sumPosQY, 0); atomicExchange(accumEntries[s].sumPosQZ, 0);
            atomicExchange(accumEntries[s].sumDirQX, 0); atomicExchange(accumEntries[s].sumDirQY, 0); atomicExchange(accumEntries[s].sumDirQZ, 0);
            atomicExchange(accumEntries[s].sumDistQ, 0);
            atomicExchange(accumEntries[s].sumTpQX, 0); atomicExchange(accumEntries[s].sumTpQY, 0); atomicExchange(accumEntries[s].sumTpQZ, 0);
            atomicExchange(accumEntries[s].keyHi, keyHi);   // publish LAST
            tableSlot = s; claimed = true; break;
        }
        // Lost the reclaim CAS — probe on (duplicate path).
    }
    if (!claimed) return;  // table pressure — fail-soft drop (per-ray path covers)

    // Quantize ONCE (float round — the CPU spec's double llround twin; counts
    // are rounding-immune), then pure int atomics.
    vec3 cellOrigin = vec3(cell) * cellSize;
    vec3 local = (rec.worldPos - cellOrigin) / cellSize;   // [0,1)
    vec3 dir = normalize(rec.worldPos - pc.camPos);        // the primary ray, derived
    atomicAdd(accumEntries[tableSlot].sumPosQX, int(round(local.x * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumPosQY, int(round(local.y * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumPosQZ, int(round(local.z * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQX, int(round(dir.x * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQY, int(round(dir.y * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQZ, int(round(dir.z * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDistQ, int(round(rec.hitT * kHitAccumPosScale / cellSize)));
    // Primary throughput = 1 per channel.
    atomicAdd(accumEntries[tableSlot].sumTpQX, int(kHitAccumThroughputScale));
    atomicAdd(accumEntries[tableSlot].sumTpQY, int(kHitAccumThroughputScale));
    atomicAdd(accumEntries[tableSlot].sumTpQZ, int(kHitAccumThroughputScale));
    atomicAdd(accumEntries[tableSlot].count, 1u);
}
