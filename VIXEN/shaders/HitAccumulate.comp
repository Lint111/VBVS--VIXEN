#version 460
#extension GL_GOOGLE_include_directive : require

// ============================================================================
// HitAccumulate.comp - the RE-SPLIT (recipeId, cell@mip) hit-accumulation pass
// ============================================================================
// (undertow docs/plans/2026-08-04-wavefront-recipe-shading.md § W-SPLIT)
//
// W3c-1 fused the accumulate tail into ShadowVisibilityWave.comp on the
// argument that the standalone pass paid ~2 ms just to re-read every hit
// record the wave already held. Measured on real hardware, the fusion cost
// MORE than it saved: the wave's own traversal+claim machinery in one kernel
// added +7-8 ms structurally (occupancy/register pressure from carrying both
// jobs), dwarfing the ~2 ms re-read the fusion was meant to avoid. This pass
// undoes the fusion — the accumulate tail moves back to its OWN dispatch, but
// LEAN this time: no SceneBindings, no traversal, nothing but the hit-record
// walk and the table claim. STANDALONE bindings only, mirroring
// SpatialReuseShade.comp's own gated standalone BodyInstance declaration
// (binding 39) rather than pulling in the full scene set.
//
// Dispatch: 1D over hitRecords.length() (the wave's own dispatch shape —
// waveDispatchX = (pixels+63)/64 — this pass runs over the SAME slot count).
// Runs BEFORE the wave in the frame (topology, not hazard, orders it): this
// pass RMWs each record's flags word (the W-LEAN L1 classification, moved
// here from the wave) and writes the accumulation table; the wave's analytic
// phase then only READS the flag bit to decide whether to skip its trace
// loop — no more footprint math, no more params access, in the wave itself.
// ============================================================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "HitRecord.glsl"

// NON-readonly: this pass RMWs the record's flags word (the W-LEAN L1 stamp,
// moved here from the wave — see main()'s classification block below) and
// reads every other field to accumulate. Binding numbers are per-shader (no
// SceneBindings namespace to collide with here).
layout(std430, binding = 0) buffer HitRecordBuffer {
    HitRecord hitRecords[];
};

// Standalone instance declaration — SpatialReuseShade.comp's own gated
// standalone-BodyInstance shape (binding 39 there), copied here since this
// pass needs ONLY recipeId and traversal-agnostic leanness is the point.
// std430, 64 B — byte-for-byte the SceneBindings.glsl BodyInstance layout.
struct BodyInstance {
    vec3  worldPos;
    float renderScale;
    vec3  color;
    uint  octreeIndex;
    uint  providerKind;
    uint  recipeId;
    float recipeParams[6];
};
layout(std430, binding = 1) readonly buffer BodyInstanceBuffer {
    BodyInstance bodyInstances[];
};

#include "HitAccumulationCommon.glsl"

layout(std430, binding = 2) buffer HitAccumTable {
    HitAccumEntryGpu accumEntries[];
};

// HitAccumParams struct: HitAccumulationCommon.glsl (camPos.w = temporal EMA
// alpha, camForward.w = W-LEAN switch — the same per-frame block the wave,
// the cell shade, and the resolve already share).
layout(std430, binding = 3) readonly buffer HitAccumParamsSSBO {
    HitAccumParams hitAccumParams;
};

// ============================================================================
// FusedHitAccumulate (moved verbatim from ShadowVisibilityWave.comp's
// VIXEN_HIT_ACCUM_FUSED block) — the sync-contract comments below are the
// original W3c-1/W3c-2/W3c-3 findings, unchanged: epoch-stamped entries,
// transient-handshake reclaim, double-hashed probing. Totals still verified
// EXACT by the shutdown diag (RunHitAccumDiagReadback).
// ============================================================================
// ClaimAccumSlot returns the claimed table slot, or ~0u (INVALID) if the
// record doesn't engage the table or every probe failed (fail-soft drop).
// Split from the numeric accumulation so B2 (VIXEN_HIT_ACCUM_PREMERGE) can
// pre-merge the sums in shared memory BEFORE the atomics below — claiming
// itself is untouched (a CAS chain over global memory; nothing to pre-merge,
// since different threads' keys can resolve to different table slots and the
// claim must pick the true slot before any sum has a destination).
uint ClaimAccumSlot(HitRecord rec, uint instIdx, uint recipeId, uint mip,
                     ivec3 cell, float cellSize) {
    ivec3 anchor = HitAccumAnchorCell(hitAccumParams.camPos.xyz, hitAccumParams.camForward.xyz,
                                      hitAccumParams.primaryCoef, hitAccumParams.detailSize0, mip);
    uint keyLo = HitAccumPackCellKeyLo(cell, anchor);
    if (keyLo == 0u) return ~0u;
    uint keyHiBase = HitAccumPackCellKeyHi(recipeId, mip);
    if (keyHiBase == 0u) return ~0u;

    uint myEpoch = hitAccumParams.frameEpoch & 0xFFFFFu;
    if (myEpoch == 0xFFFFFu) myEpoch = 0u;
    uint keyHi = keyHiBase | myEpoch;
    uint kTransient = keyHiBase | 0xFFFFFu;

    uint baseSlot = HitAccumSlotOf(keyLo, keyHiBase);
    uint stride = HitAccumProbeStride(keyLo);
    for (uint probe = 0u; probe < kHitAccumProbeLimit; ++probe) {
        uint s = (baseSlot + probe * stride) % kHitAccumTableCapacity;
        uint oldLo = atomicCompSwap(accumEntries[s].keyLo, 0u, keyLo);
        if (oldLo != 0u && oldLo != keyLo) continue;
        if (oldLo == 0u) {
            // W3c-2: the representative instance rides the claim — written
            // BEFORE the keyHi publish, so a published keyHi implies a valid
            // repInstIdx (the publish-last protocol's own ordering).
            atomicExchange(accumEntries[s].repInstIdx, instIdx);
            atomicExchange(accumEntries[s].keyHi, keyHi);
            return s;
        }
        uint hiRead = atomicAdd(accumEntries[s].keyHi, 0u);
        if ((hiRead & 0xFFF00000u) != keyHiBase) continue;
        if ((hiRead & 0xFFFFFu) == myEpoch) return s;
        if (hiRead == kTransient) {
            // W3c-3: BOUNDED wait on the reclaim winner's zeroing window
            // (~13 atomic stores) instead of probing on immediately — the
            // probe-on rule MINTED ~3 fresh duplicate slots per frame
            // (measured occupancy creep 32,029→32,282 over 80 frames), and
            // every mint can flip the resolve's duplicate selection (the
            // frame-hash instability's root). Still fail-soft: a spin that
            // never sees the publish probes on exactly as before.
            for (uint spin = 0u; spin < 16u; ++spin) {
                hiRead = atomicAdd(accumEntries[s].keyHi, 0u);
                if (hiRead == keyHi) return s;
                if (hiRead != kTransient) break;  // published, but not our epoch
            }
            continue;
        }
        if (atomicCompSwap(accumEntries[s].keyHi, hiRead, kTransient) == hiRead) {
            atomicExchange(accumEntries[s].count, 0u);
            atomicExchange(accumEntries[s].sumPosQX, 0); atomicExchange(accumEntries[s].sumPosQY, 0); atomicExchange(accumEntries[s].sumPosQZ, 0);
            atomicExchange(accumEntries[s].sumDirQX, 0); atomicExchange(accumEntries[s].sumDirQY, 0); atomicExchange(accumEntries[s].sumDirQZ, 0);
            atomicExchange(accumEntries[s].sumDistQ, 0);
            atomicExchange(accumEntries[s].sumTpQX, 0); atomicExchange(accumEntries[s].sumTpQY, 0); atomicExchange(accumEntries[s].sumTpQZ, 0);
            atomicExchange(accumEntries[s].repInstIdx, instIdx);  // W3c-2: before the publish
            atomicExchange(accumEntries[s].keyHi, keyHi);
            return s;
        }
    }
    return ~0u;
}

#ifdef VIXEN_HIT_ACCUM_PREMERGE
// ============================================================================
// B2: shared-memory same-key pre-merge (docs/plans/2026-08-04-wavefront-
// recipe-shading.md § B2). The nine accumulated fields are ALL plain integer
// atomics (quantized fixed-point sums + a uint count — see
// HitAccumulationCommon.glsl's header comment), so integer addition is
// order-free: summing in shared memory first and issuing ONE global atomicAdd
// per distinct tableSlot per workgroup produces the IDENTICAL total the
// per-thread atomics would, just with fewer L2 round-trips. Claiming
// (ClaimAccumSlot) is untouched — only the numeric adds below are batched.
//
// Reduction shape: each of the 64 threads (gl_WorkGroupSize.x) publishes its
// resolved tableSlot + quantized contribution to shared arrays, barriers,
// then does an O(n) leader scan: the lowest-index thread that owns a given
// tableSlot sums every later thread sharing that slot and issues the group's
// one atomic per field for it. 64 threads -> <=64*64 shared-mem compares,
// trivial next to the global atomics it replaces.
// ============================================================================
const uint kAccumWorkgroupSize = 64u;
const uint kAccumInvalidSlot = ~0u;

shared uint  sh_tableSlot[kAccumWorkgroupSize];
shared int   sh_sumPosQX[kAccumWorkgroupSize];
shared int   sh_sumPosQY[kAccumWorkgroupSize];
shared int   sh_sumPosQZ[kAccumWorkgroupSize];
shared int   sh_sumDirQX[kAccumWorkgroupSize];
shared int   sh_sumDirQY[kAccumWorkgroupSize];
shared int   sh_sumDirQZ[kAccumWorkgroupSize];
shared int   sh_sumDistQ[kAccumWorkgroupSize];
shared int   sh_sumTpQX[kAccumWorkgroupSize];
shared int   sh_sumTpQY[kAccumWorkgroupSize];
shared int   sh_sumTpQZ[kAccumWorkgroupSize];

// Called by every thread in the workgroup (uniform control flow — required
// for the barrier below); tableSlot/valid carry this thread's own claim.
void PreMergeAndAccumulate(uint localIdx, uint tableSlot, bool valid,
                            int posQX, int posQY, int posQZ,
                            int dirQX, int dirQY, int dirQZ,
                            int distQ, int tpQX, int tpQY, int tpQZ) {
    sh_tableSlot[localIdx] = valid ? tableSlot : kAccumInvalidSlot;
    sh_sumPosQX[localIdx] = posQX; sh_sumPosQY[localIdx] = posQY; sh_sumPosQZ[localIdx] = posQZ;
    sh_sumDirQX[localIdx] = dirQX; sh_sumDirQY[localIdx] = dirQY; sh_sumDirQZ[localIdx] = dirQZ;
    sh_sumDistQ[localIdx] = distQ;
    sh_sumTpQX[localIdx] = tpQX; sh_sumTpQY[localIdx] = tpQY; sh_sumTpQZ[localIdx] = tpQZ;
    memoryBarrierShared();
    barrier();

    if (!valid) return;
    // Leader rule: the lowest local index claiming this tableSlot reduces
    // and fires the group atomics; every later same-key thread contributes
    // nothing further (already folded into the leader's sum).
    for (uint i = 0u; i < localIdx; ++i) {
        if (sh_tableSlot[i] == tableSlot) return;  // an earlier leader owns this key
    }

    // int/uint check (batch-3 major, HitAccumulationCommon.glsl:46-56): count
    // is uint and mCount is uint (fine); the ten sum fields are int and are
    // reduced into plain int locals here. The header's i32 headroom argument
    // (|per-sample quantum| <= 2^16, safe to 2^15 samples/cell) was sized for
    // the GLOBAL per-entry total; local-accumulating <=64 lanes first before
    // ONE atomicAdd cannot overflow any earlier than that same-scale global
    // sum would (strictly fewer terms, same per-term bound) — headroom holds.
    int mPosQX = posQX, mPosQY = posQY, mPosQZ = posQZ;
    int mDirQX = dirQX, mDirQY = dirQY, mDirQZ = dirQZ;
    int mDistQ = distQ;
    int mTpQX = tpQX, mTpQY = tpQY, mTpQZ = tpQZ;
    uint mCount = 1u;
    for (uint j = localIdx + 1u; j < kAccumWorkgroupSize; ++j) {
        if (sh_tableSlot[j] != tableSlot) continue;
        mPosQX += sh_sumPosQX[j]; mPosQY += sh_sumPosQY[j]; mPosQZ += sh_sumPosQZ[j];
        mDirQX += sh_sumDirQX[j]; mDirQY += sh_sumDirQY[j]; mDirQZ += sh_sumDirQZ[j];
        mDistQ += sh_sumDistQ[j];
        mTpQX += sh_sumTpQX[j]; mTpQY += sh_sumTpQY[j]; mTpQZ += sh_sumTpQZ[j];
        ++mCount;
    }

    // Batch-3 blocker #3: the leader defers ALL of the workgroup's adds until
    // after the O(n) scan, widening the window against ClaimAccumSlot's own
    // reclaim branch (which zeroes sum fields and republishes keyHi under a
    // NEW epoch/transient marker) — a concurrent reclaim from another
    // workgroup could zero the entry in between, silently discarding up to
    // 64 lanes' contributions instead of one. Re-verify the slot is still
    // OURS (same frame epoch, not transient) immediately before the atomic
    // batch; a reclaim in the window means DROP (fail-soft, same as a claim
    // that never landed) rather than corrupt a reclaimed entry.
    uint myEpoch = hitAccumParams.frameEpoch & 0xFFFFFu;
    if (myEpoch == 0xFFFFFu) myEpoch = 0u;
    uint hiNow = atomicAdd(accumEntries[tableSlot].keyHi, 0u);
    if ((hiNow & 0xFFFFFu) != myEpoch) return;  // reclaimed out from under us — drop

    atomicAdd(accumEntries[tableSlot].sumPosQX, mPosQX);
    atomicAdd(accumEntries[tableSlot].sumPosQY, mPosQY);
    atomicAdd(accumEntries[tableSlot].sumPosQZ, mPosQZ);
    atomicAdd(accumEntries[tableSlot].sumDirQX, mDirQX);
    atomicAdd(accumEntries[tableSlot].sumDirQY, mDirQY);
    atomicAdd(accumEntries[tableSlot].sumDirQZ, mDirQZ);
    atomicAdd(accumEntries[tableSlot].sumDistQ, mDistQ);
    atomicAdd(accumEntries[tableSlot].sumTpQX, mTpQX);
    atomicAdd(accumEntries[tableSlot].sumTpQY, mTpQY);
    atomicAdd(accumEntries[tableSlot].sumTpQZ, mTpQZ);
    atomicAdd(accumEntries[tableSlot].count, mCount);
}
#endif // VIXEN_HIT_ACCUM_PREMERGE

// AccumulateHit stays byte-identical when VIXEN_HIT_ACCUM_PREMERGE is off —
// same claim, same per-thread atomics, same call shape as before the split.
// hasHit: false means this thread has nothing to contribute this dispatch
// (out-of-bounds slot or a miss record) — under premerge it still MUST call
// through to the barrier below with valid=false; rec is unused in that case.
void AccumulateHit(uint localIdx, uint slot, HitRecord rec, bool hasHit) {
#ifdef VIXEN_HIT_ACCUM_PREMERGE
    bool valid = false;
    uint tableSlot = kAccumInvalidSlot;
    int posQX = 0, posQY = 0, posQZ = 0;
    int dirQX = 0, dirQY = 0, dirQZ = 0;
    int distQ = 0, tpQX = 0, tpQY = 0, tpQZ = 0;

    if (hasHit && hitAccumParams.primaryCoef > 0.0) {
        float footprint = rec.hitT * hitAccumParams.primaryCoef + hitAccumParams.primaryBias;
        uint mip = HitAccumSelectMip(footprint, hitAccumParams.detailSize0);
        uint instIdx = rec._pad0[0];
        if (mip != 0u && instIdx < bodyInstances.length()) {
            uint recipeId = bodyInstances[instIdx].recipeId;
            float cellSize = HitAccumCellSize(mip, hitAccumParams.detailSize0);
            ivec3 cell = HitAccumCellCoord(rec.worldPos, cellSize);
            uint claimed = ClaimAccumSlot(rec, instIdx, recipeId, mip, cell, cellSize);
            if (claimed != kAccumInvalidSlot) {
                tableSlot = claimed;
                valid = true;
                vec3 cellOrigin = vec3(cell) * cellSize;
                vec3 local = (rec.worldPos - cellOrigin) / cellSize;
                posQX = int(round(local.x * kHitAccumPosScale));
                posQY = int(round(local.y * kHitAccumPosScale));
                posQZ = int(round(local.z * kHitAccumPosScale));
                dirQX = int(round(rec.worldNormal.x * kHitAccumDirScale));
                dirQY = int(round(rec.worldNormal.y * kHitAccumDirScale));
                dirQZ = int(round(rec.worldNormal.z * kHitAccumDirScale));
                distQ = int(round(rec.hitT * kHitAccumPosScale / cellSize));
                tpQX = int(round(rec.albedo.x * kHitAccumThroughputScale));
                tpQY = int(round(rec.albedo.y * kHitAccumThroughputScale));
                tpQZ = int(round(rec.albedo.z * kHitAccumThroughputScale));
            }
        }
    }
    // Every thread in the workgroup MUST reach this call (it barriers) even
    // when it has nothing to contribute (out-of-range slot, early-outs
    // above) — valid=false threads still publish an INVALID marker so the
    // leader scan sees a stable shared array.
    PreMergeAndAccumulate(localIdx, tableSlot, valid,
                          posQX, posQY, posQZ, dirQX, dirQY, dirQZ,
                          distQ, tpQX, tpQY, tpQZ);
#else
    if (hitAccumParams.primaryCoef <= 0.0) return;
    float footprint = rec.hitT * hitAccumParams.primaryCoef + hitAccumParams.primaryBias;
    uint mip = HitAccumSelectMip(footprint, hitAccumParams.detailSize0);
    if (mip == 0u) return;  // per-ray exact — the fail-soft path

    uint instIdx = rec._pad0[0];
    if (instIdx >= bodyInstances.length()) return;
    uint recipeId = bodyInstances[instIdx].recipeId;

    float cellSize = HitAccumCellSize(mip, hitAccumParams.detailSize0);
    ivec3 cell = HitAccumCellCoord(rec.worldPos, cellSize);
    uint tableSlot = ClaimAccumSlot(rec, instIdx, recipeId, mip, cell, cellSize);
    if (tableSlot == ~0u) return;

    vec3 cellOrigin = vec3(cell) * cellSize;
    vec3 local = (rec.worldPos - cellOrigin) / cellSize;
    // W3c-2: the summed vector is the record's NORMAL (|avg| shortens as the
    // cell's surface orientations disagree — the classic Toksvig factor; a
    // cell's RAY directions are near-parallel by construction, so W3b's
    // view-direction sum carried no widening signal). Throughput sums the
    // record's actual albedo (W3b summed a placeholder white).
    atomicAdd(accumEntries[tableSlot].sumPosQX, int(round(local.x * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumPosQY, int(round(local.y * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumPosQZ, int(round(local.z * kHitAccumPosScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQX, int(round(rec.worldNormal.x * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQY, int(round(rec.worldNormal.y * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDirQZ, int(round(rec.worldNormal.z * kHitAccumDirScale)));
    atomicAdd(accumEntries[tableSlot].sumDistQ, int(round(rec.hitT * kHitAccumPosScale / cellSize)));
    atomicAdd(accumEntries[tableSlot].sumTpQX, int(round(rec.albedo.x * kHitAccumThroughputScale)));
    atomicAdd(accumEntries[tableSlot].sumTpQY, int(round(rec.albedo.y * kHitAccumThroughputScale)));
    atomicAdd(accumEntries[tableSlot].sumTpQZ, int(round(rec.albedo.z * kHitAccumThroughputScale)));
    atomicAdd(accumEntries[tableSlot].count, 1u);
#endif // VIXEN_HIT_ACCUM_PREMERGE
}

void main() {
    uint slot = gl_GlobalInvocationID.x;
    uint localIdx = gl_LocalInvocationID.x;
    bool inBounds = slot < hitRecords.length();

    // W-LEAN L1 classification (moved here from ShadowVisibilityWave.comp):
    // a pixel whose blend weight saturates (footprint >= 2*detailSize0, the
    // resolve's w == 1) has its ENTIRE per-pixel color replaced by the
    // composite. This pass now OWNS the stamp — one thread per record, plain
    // non-atomic write is fine (no other pass touches this record's flags
    // this frame before the wave reads it back).
    // Zero-init: under VIXEN_HIT_ACCUM_PREMERGE every lane (including
    // out-of-bounds ones) falls through to AccumulateHit and passes rec BY
    // VALUE — an uninitialized struct copy is UB in GLSL/SPIR-V even though
    // the hasHit=false guard prevents any field READ (batch-3 validator).
    HitRecord rec = HitRecord(vec3(0.0), 0.0, vec3(0.0), 0.0, vec3(0.0), 0u, uint[3](0u, 0u, 0u));
    bool hasHit = false;
    if (inBounds) {
        uint flags = hitRecords[slot].flags;
        hasHit = (flags & HITRECORD_FLAG_HIT) != 0u;
        if (hasHit) {
            if (hitAccumParams.camForward.w > 0.0 && hitAccumParams.primaryCoef > 0.0) {
                float footprint = hitRecords[slot].hitT * hitAccumParams.primaryCoef
                                 + hitAccumParams.primaryBias;
                if (footprint >= 2.0 * hitAccumParams.detailSize0) {
                    hitRecords[slot].flags = flags | HITRECORD_FLAG_CELL_RESOLVED;
                }
            }
            rec = hitRecords[slot];
        }
    }

#ifndef VIXEN_HIT_ACCUM_PREMERGE
    // Flag-off path: no barrier below AccumulateHit, so non-participating
    // threads can return early exactly as before the split.
    if (!hasHit) return;
#endif
    // Premerge path: EVERY thread in the workgroup must reach AccumulateHit
    // (it barriers internally) regardless of hasHit/inBounds — rec is unused
    // when hasHit is false.
    AccumulateHit(localIdx, slot, rec, hasHit);
}
