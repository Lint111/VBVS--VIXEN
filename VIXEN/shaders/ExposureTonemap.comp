#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly uniform image2D sceneRadianceHistory;
layout(binding = 1, rgba8) writeonly uniform image2D outputImage;
layout(std430, binding = 2) readonly buffer ExposureMeterResult { float ev100; } meter;

// Slice 1 witness transform: pinned EV100=0, with no adaptive state or unordered
// reduction. The shader intentionally owns the only HDR->UNORM conversion.
vec3 acesFitted(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec3 linearToSrgb(vec3 x) {
    bvec3 lo = lessThanEqual(x, vec3(0.0031308));
    vec3 encoded = 1.055 * pow(max(x, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return mix(encoded, 12.92 * x, vec3(lo));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(outputImage)))) return;
    vec3 radiance = max(imageLoad(sceneRadianceHistory, p).rgb * exp2(meter.ev100), vec3(0.0));
    imageStore(outputImage, p, vec4(linearToSrgb(acesFitted(radiance)), 1.0));
}
