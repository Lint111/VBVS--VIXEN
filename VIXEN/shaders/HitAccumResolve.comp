#version 460
#extension GL_GOOGLE_include_directive : require

// ============================================================================
// HitAccumResolve.comp — wavefront W3c-2: the resolve composite. Runs AFTER
// SpatialReuseShade's outputImage write, BEFORE the presentation blit.
// ============================================================================
// Per pixel: re-derive the SAME (recipeId, cell@mip) key the fused wave packed
// for this pixel's hit record (identical math, identical inputs — the params
// SSBO), probe the table read-only, and blend the pre-shaded cell radiance
// over the per-pixel result. Un-engaged pixels (miss / mip 0 / key
// out-of-range / probe miss / zero count) return without touching the image —
// the FAIL-SOFT invariant: every degradation path lands on the full per-pixel
// result.
//
// Seam handling (the design's count-weighted blend): the blend weight ramps
// with footprint past the engagement threshold (pixels just past mip-0 keep
// mostly their per-pixel color) and with the entry's count (a 1-ray cell is a
// weak average). historyImage is NOT touched — temporal accumulation stays
// per-pixel-pure; this composite is a display-side overlay.
// ============================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Read-write (no `writeonly`): the seam blend imageLoads the same texel this
// invocation stores — well-defined within one invocation.
layout(rgba8, binding = 0) uniform image2D outputImage;

#include "HitRecord.glsl"
#include "HitAccumulationCommon.glsl"

layout(std430, binding = 1) readonly buffer HitRecordBuffer {
    HitRecord hitRecords[];
};

// Standalone BodyInstance declaration (the specialized-kernel precedent —
// SpecializedRecipeShaderGlsl.h's own copy): this pass needs ONLY recipeId
// for the key re-derivation, no traversal machinery, so pulling the full
// SceneBindings chain in would be 10+ dead bindings. std430, 64 B —
// byte-for-byte the SceneBindings.glsl binding-10 layout.
struct BodyInstance {
    vec3  worldPos;
    float renderScale;
    vec3  color;
    uint  octreeIndex;
    uint  providerKind;
    uint  recipeId;
    float recipeParams[6];
};
layout(std430, binding = 2) readonly buffer BodyInstanceBuffer {
    BodyInstance bodyInstances[];
};

layout(std430, binding = 3) readonly buffer HitAccumTable {
    HitAccumEntryGpu accumEntries[];
};

layout(std430, binding = 4) readonly buffer HitAccumParamsSSBO {
    HitAccumParams hitAccumParams;
};

layout(std430, binding = 5) readonly buffer HitAccumCellRadiance {
    vec4 cellRadiance[];
};

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(outputImage);
    if (px.x >= sz.x || px.y >= sz.y) return;

    uint idx = uint(px.y) * uint(sz.x) + uint(px.x);
    HitRecord rec = hitRecords[idx];
    if ((rec.flags & HITRECORD_FLAG_HIT) == 0u) return;
    if (hitAccumParams.primaryCoef <= 0.0) return;

    // The fused wave's own derivation, verbatim.
    float footprint = rec.hitT * hitAccumParams.primaryCoef + hitAccumParams.primaryBias;
    uint mip = HitAccumSelectMip(footprint, hitAccumParams.detailSize0);
    if (mip == 0u) return;  // un-engaged: the per-pixel result stands

    uint instIdx = rec._pad0[0];
    if (instIdx >= bodyInstances.length()) return;
    uint recipeId = bodyInstances[instIdx].recipeId;

    float cellSize = HitAccumCellSize(mip, hitAccumParams.detailSize0);
    ivec3 cell   = HitAccumCellCoord(rec.worldPos, cellSize);
    ivec3 anchor = HitAccumAnchorCell(hitAccumParams.camPos.xyz, hitAccumParams.camForward.xyz,
                                      hitAccumParams.primaryCoef, hitAccumParams.detailSize0, mip);
    uint keyLo = HitAccumPackCellKeyLo(cell, anchor);
    if (keyLo == 0u) return;
    uint keyHiBase = HitAccumPackCellKeyHi(recipeId, mip);
    if (keyHiBase == 0u) return;
    uint epoch = hitAccumParams.frameEpoch & 0xFFFFFu;
    if (epoch == 0xFFFFFu) epoch = 0u;
    uint keyHi = keyHiBase | epoch;

    // W3c-3: SELECTION-INDEPENDENT resolve — walk the WHOLE probe chain and
    // count-weighted-average every live duplicate of this key, instead of
    // taking the first match. Which duplicate holds which ray partition (and
    // whether a given duplicate got rays at all this frame) races per frame;
    // first-match selection turned that into discrete per-pixel color flips
    // (the measured frame-hash instability). The count-weighted mean over all
    // duplicates is the OVERALL cell mean — partition-invariant.
    uint baseSlot = HitAccumSlotOf(keyLo, keyHiBase);
    uint stride = HitAccumProbeStride(keyLo);
    vec3 acc = vec3(0.0);
    float accCount = 0.0;
    for (uint probe = 0u; probe < kHitAccumProbeLimit; ++probe) {
        uint s = (baseSlot + probe * stride) % kHitAccumTableCapacity;
        uint lo = accumEntries[s].keyLo;
        // Empty slot ⇒ no further entries for this key can exist (an insert
        // would have claimed it before any later slot).
        if (lo == 0u) break;
        if (lo != keyLo) continue;
        if (accumEntries[s].keyHi != keyHi) continue;  // stale/transient/other recipe|mip
        uint count = accumEntries[s].count;
        if (count == 0u) continue;
        acc += cellRadiance[s].rgb * float(count);
        accCount += float(count);
    }
    if (accCount <= 0.0) return;  // fail-soft: the per-pixel result stands

    // Engagement-boundary ramp: pixels just past the mip-0 threshold keep
    // mostly their per-pixel color; deep engagement takes the cell fully.
    // NO count factor — cells at shallow engagement average ~1.2 rays as
    // the NORM (found live: a count/4 confidence term was a permanent
    // global damp to w≈0.3, not a boundary smoother; the ramp already
    // owns the seam).
    float w = clamp(footprint / hitAccumParams.detailSize0 - 1.0, 0.0, 1.0);
    vec4 cur = imageLoad(outputImage, px);
    imageStore(outputImage, px, vec4(mix(cur.rgb, acc / accCount, w), cur.a));
}
