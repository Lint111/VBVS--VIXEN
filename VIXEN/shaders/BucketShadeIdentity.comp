#version 450

// ============================================================================
// BucketShadeIdentity.comp - the W2b bucket-shade SKELETON (wavefront epoch)
// (undertow docs/plans/2026-08-04-wavefront-recipe-shading.md § "W2 design")
// ============================================================================
// One FIXED shader (not per-recipe emitted): dispatched INDIRECTLY once per
// hot recipeId over that bucket's screen-coverage rect — the same
// vkCmdDispatchIndirect + BucketMeta + push-selector shape as the specialized
// march (SpecializedRecipeShaderGlsl.h), queued on the SAME MultiDispatchNode
// AFTER the march passes (autoBarriers_ serializes same-HitRecord passes, so
// march→shade ordering is inherited, zero graph changes).
//
// WHAT IT DOES: the W2 boundary contract's structural proof. Per rect pixel:
// resolve ownership (HitRecord._pad0[0] instIdx → bodyInstances[].recipeId ==
// pc.recipeId — the slot the W2a-era ledger fix protects), then IDENTITY-
// rewrite exactly the MATERIAL fields a real W2c kernel will own (albedo,
// roughness, worldNormal, _pad0[1] emission) with the values the march
// already wrote. The frame-hash gate then proves the dispatch chain, the
// ownership resolution, and the pass ordering do no damage — BEFORE any
// per-recipe specialization exists (the W1a split-then-verify discipline).
// Traversal products (hitT, worldPos, flags, _pad0[0]) are NEVER touched:
// they are the march's, not the shade's — the contract line drawn in code.
//
// Bindings + push are DELIBERATELY IDENTICAL to the specialized march's
// (bucketMembers is declared-unused here): one descriptor-write shape, one
// CPU push struct (SpecializedPushCpu), no second convention to maintain.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct BodyInstance {
    vec3  worldPos;          // 0
    float renderScale;       // 12
    vec3  color;             // 16
    uint  octreeIndex;       // 28
    uint  providerKind;      // 32
    uint  recipeId;          // 36
    float recipeParams[6];   // 40..63
};
layout(std430, binding = 0) readonly buffer BodyInstanceBuffer { BodyInstance bodyInstances[]; };

// Declared for binding-set parity with the specialized march (unused here —
// pixel ownership resolves through the hit record's instIdx, not the member
// list; a W2c material kernel may consume it).
layout(std430, binding = 1) readonly buffer BucketMembersBuffer { uint bucketMembers[]; };

struct HitRecord {
    vec3  albedo;
    float roughness;
    vec3  worldNormal;
    float hitT;
    vec3  worldPos;
    uint  flags;
    uint  _pad0[3];
};
#define HITRECORD_FLAG_HIT 0x1u
layout(std430, binding = 2) buffer HitRecordBuffer { HitRecord hitRecords[]; };

struct BucketMeta {
    uint  memberCount;
    uint  rectMinX;
    uint  rectMinY;
    float boundRadius;
    float stepRelaxation;
    uint  _pad[3];
};
layout(std430, binding = 3) readonly buffer BucketMetaBuffer { BucketMeta bucketMeta[]; };

layout(push_constant) uniform Push {
    vec3  cameraPos;
    float _p0;
    vec3  cameraDir;
    float fov;
    vec3  cameraUp;
    float aspect;
    vec3  cameraRight;
    float _p1;
    uint  screenWidth;
    uint  screenHeight;
    uint  maxMembersPerBucket;
    uint  recipeId;
} pc;

void main() {
    BucketMeta meta = bucketMeta[pc.recipeId];
    ivec2 rectCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 pixelCoords = rectCoord + ivec2(int(meta.rectMinX), int(meta.rectMinY));
    if (pixelCoords.x >= int(pc.screenWidth) || pixelCoords.y >= int(pc.screenHeight)) return;
    if (pixelCoords.x < 0 || pixelCoords.y < 0) return;

    uint hitIdx = uint(pixelCoords.y) * pc.screenWidth + uint(pixelCoords.x);
    HitRecord rec = hitRecords[hitIdx];
    if ((rec.flags & HITRECORD_FLAG_HIT) == 0u) return;

    // Ownership: this pixel's winning instance must belong to THIS bucket's
    // recipe. _pad0[0] = the march's instIdx (HitRecord.glsl's master ledger).
    uint instIdx = rec._pad0[0];
    if (instIdx >= bodyInstances.length()) return;
    if (bodyInstances[instIdx].recipeId != pc.recipeId) return;

    // IDENTITY material rewrite — the four fields the W2c kernel will own,
    // written back with the march's own values (real stores, not elided:
    // SSBO writes are side effects). Everything else stays untouched.
    hitRecords[hitIdx].albedo      = rec.albedo;
    hitRecords[hitIdx].roughness   = rec.roughness;
    hitRecords[hitIdx].worldNormal = rec.worldNormal;
    hitRecords[hitIdx]._pad0[1]    = rec._pad0[1];  // emission
}
