#version 460
#extension GL_GOOGLE_include_directive : require
#include "ExposureHistogram.glsl"

// Luminance histogram meter. Each 16x16 workgroup bins its pixels into a
// shared histogram and adds the non-empty bins to the frame histogram.
// Integer addition is order-independent, so the result is deterministic;
// ExposureReduce.comp consumes and clears the frame histogram.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba16f) readonly uniform image2D sceneRadianceHistoryOutput;

layout(std430, binding = 1) buffer ExposureMeterResult { uint words[]; } result;
#define VIXEN_SOA_ExposureMeterState_BUFFER result
#include "Generated/ExposureMeterState.glsl"

shared uint tileHistogram[kExposureHistogramBins];

void main() {
    uint i = gl_LocalInvocationIndex;
    if (i < kExposureHistogramBins) tileHistogram[i] = 0u;
    barrier();

    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(p, imageSize(sceneRadianceHistoryOutput)))) {
        vec3 c = max(imageLoad(sceneRadianceHistoryOutput, p).rgb, vec3(0.0));
        float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
        if (!isnan(lum) && !isinf(lum)) {
            uint bin = 0u;
            if (lum > 1.0e-6) {
                float scaled = (log2(lum) - kExposureHistogramLog2Min) * kExposureHistogramBinsPerEV;
                bin = uint(clamp(scaled, 0.0, float(kExposureHistogramBins - 1u)));
            }
            atomicAdd(tileHistogram[bin], 1u);
        }
    }
    barrier();

    if (i < kExposureHistogramBins && tileHistogram[i] != 0u)
        atomicAdd(result.words[ExposureMeterState_histogram_Word(0u, i)], tileHistogram[i]);
}
