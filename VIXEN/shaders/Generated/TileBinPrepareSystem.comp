        return;
    }
    int instance = i % view.instanceCount;
    float q = LodQ(bounds.values[instance].centerX, bounds.values[instance].centerY, bounds.values[instance].centerZ, bounds.values[instance].radius, view);
    int bandRow = int(recipes.values[instance].lodSlot) * 4;
    uint band = SelectLodBand(q, lodBands.values[bandRow].maxQ, lodBands.values[bandRow + 1].maxQ, lodBands.values[bandRow + 2].maxQ, uint(4));
    uint variant = lodBands.values[bandRow + int(band)].variantRecipeId;
    bands.values[instance].band = band;
    bands.values[instance].variantRecipeId = (variant == 4294967295u ? recipes.values[instance].recipeId : variant);
    if (view.instanceCount > view.wordCapacity * 32)
    {
        return;
    }
    if (imageLoad(viewDepth_previous, ivec2(int(0) % imageSize(viewDepth_previous).x, int(0) / imageSize(viewDepth_previous).x)).x < -3.402823e38)
    {
        return;
    }
    float depth = RankDepth(bounds.values[i].centerX, bounds.values[i].centerY, bounds.values[i].centerZ, bounds.values[i].radius, view);
    int rank = 0;
    for (int other = 0; other < view.instanceCount; other++)
    {
        float otherDepth = RankDepth(bounds.values[other].centerX, bounds.values[other].centerY, bounds.values[other].centerZ, bounds.values[other].radius, view);
        if (CandidateBefore(otherDepth, uint(other), depth, uint(i)))
        {
            rank++;
        }
    }
    order.values[rank].instance = uint(i);
    order.values[rank].depth = depth;
    order.values[i].rank = uint(rank);
}
