    }
    if (last == 2u || safeQ < maxQ2 || maxQ2 > 3.4028235E+38)
    {
        return 2u;
    }
    return 3u;
}

float RankDepth(float centerX, float centerY, float centerZ, float radius, TileBinView view) {
    float vz = view.viewZx * centerX + view.viewZy * centerY + view.viewZz * centerZ + view.viewZw;
    float nearDepth = vz - radius;
    if (vz + radius <= view.nearPlane)
    {
        return 3.402823e38;
    }
    return (nearDepth <= view.nearPlane ? view.nearPlane : nearDepth);
}

bool CandidateBefore(float depth, uint instance, float otherDepth, uint otherInstance) {
    return depth < otherDepth || (depth == otherDepth && instance < otherInstance);
