layout(rgba16f, set = 0, binding = 0) uniform readonly image2D sceneRadianceHistoryOutput_current;
layout(rgba8, set = 0, binding = 1) uniform writeonly image2D outputImage_current;
layout(push_constant, std430) uniform ExposureTonemapSystemPushConstants
{
    uint _ExtentX;
    uint _ExtentY;
    uint _Frame;
} pc;

void ExposureTonemapSystem_Body(in ExposureMeterState meter, in SceneLookSettings sceneLook, uint _Frame, int i) {
    vec4 source = imageLoad(sceneRadianceHistoryOutput_current, ivec2(int(i) % imageSize(sceneRadianceHistoryOutput_current).x, int(i) / imageSize(sceneRadianceHistoryOutput_current).x));
    float exposure = pow(2.0, meter.log2Exposure + sceneLook.exposureCompensationEV);
    float red = max(source.x * exposure, 0.0);
    float green = max(source.y * exposure, 0.0);
    float blue = max(source.z * exposure, 0.0);
    float saturation = sceneLook.lookSaturation;
    bool neutral = saturation == 1.0;
    float luma = 0.2126 * red + 0.7152 * green + 0.0722 * blue;
    red = (neutral ? red : max(red * saturation + luma * (1.0 - saturation), 0.0));
    green = (neutral ? green : max(green * saturation + luma * (1.0 - saturation), 0.0));
    blue = (neutral ? blue : max(blue * saturation + luma * (1.0 - saturation), 0.0));
    red = clamp((red * (2.51 * red + 0.03)) / (red * (2.43 * red + 0.59) + 0.14), 0.0, 1.0);
    float redLinear = 12.92 * red;
    float redEncoded = 1.055 * pow(max(red, 0.0), 1.0 / 2.4) - 0.055;
    red = (red <= 0.0031308 ? redLinear : redEncoded);
    green = clamp((green * (2.51 * green + 0.03)) / (green * (2.43 * green + 0.59) + 0.14), 0.0, 1.0);
    float greenLinear = 12.92 * green;
    float greenEncoded = 1.055 * pow(max(green, 0.0), 1.0 / 2.4) - 0.055;
    green = (green <= 0.0031308 ? greenLinear : greenEncoded);
    blue = clamp((blue * (2.51 * blue + 0.03)) / (blue * (2.43 * blue + 0.59) + 0.14), 0.0, 1.0);
    float blueLinear = 12.92 * blue;
    float blueEncoded = 1.055 * pow(max(blue, 0.0), 1.0 / 2.4) - 0.055;
    blue = (blue <= 0.0031308 ? blueLinear : blueEncoded);
    uint pixelSeed = uint(i) ^ (_Frame * 0x9e3779b9u);
    pixelSeed ^= pixelSeed >> 16;
    pixelSeed *= 0x85ebca6bu;
    pixelSeed ^= pixelSeed >> 13;
    pixelSeed *= 0xc2b2ae35u;
    pixelSeed ^= pixelSeed >> 16;
    float ditherStep = (sceneLook.presentationMode == 1u ? 8.0 / 255.0 : 0.0);
    red += (float((pixelSeed & 0xffu)) / 255.0 - 0.5) * ditherStep;
    green += (float(((pixelSeed >> 8) & 0xffu)) / 255.0 - 0.5) * ditherStep;
    blue += (float(((pixelSeed >> 16) & 0xffu)) / 255.0 - 0.5) * ditherStep;
    imageStore(outputImage_current, ivec2(int(i) % imageSize(outputImage_current).x, int(i) / imageSize(outputImage_current).x), vec4(red, green, blue, 1.0));
}
void main()
{
    uint axisX = gl_GlobalInvocationID.x;
    uint axisY = gl_GlobalInvocationID.y;
    if (axisX >= pc._ExtentX) return;
    if (axisY >= pc._ExtentY) return;
    uint linearId = (axisX + axisY * pc._ExtentX);
    ExposureMeterState _value_meter = meter_Load(0u);
    SceneLookSettings _value_sceneLook = sceneLook_Load(0u);
    ExposureTonemapSystem_Body(_value_meter, _value_sceneLook, pc._Frame, int(linearId));
}
