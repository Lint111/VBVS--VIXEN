SceneLookSettings sceneLook_Load(uint index)
{
    SceneLookSettings value;
    value.exposureCompensationEV = uintBitsToFloat(sceneLook.words[(((sceneLook.words[0u] >> 2u) + index * 1u)) + 0u]);
    value.exposureKeyValue = uintBitsToFloat(sceneLook.words[(((sceneLook.words[1u] >> 2u) + index * 1u)) + 0u]);
    value.exposureMinEV100 = uintBitsToFloat(sceneLook.words[(((sceneLook.words[2u] >> 2u) + index * 1u)) + 0u]);
    value.exposureMaxEV100 = uintBitsToFloat(sceneLook.words[(((sceneLook.words[3u] >> 2u) + index * 1u)) + 0u]);
    value.exposureLowPercent = uintBitsToFloat(sceneLook.words[(((sceneLook.words[4u] >> 2u) + index * 1u)) + 0u]);
    value.exposureHighPercent = uintBitsToFloat(sceneLook.words[(((sceneLook.words[5u] >> 2u) + index * 1u)) + 0u]);
    value.exposureSpeedUp = uintBitsToFloat(sceneLook.words[(((sceneLook.words[6u] >> 2u) + index * 1u)) + 0u]);
    value.exposureSpeedDown = uintBitsToFloat(sceneLook.words[(((sceneLook.words[7u] >> 2u) + index * 1u)) + 0u]);
    value.exposureDeltaSeconds = uintBitsToFloat(sceneLook.words[(((sceneLook.words[8u] >> 2u) + index * 1u)) + 0u]);
    value.lookSaturation = uintBitsToFloat(sceneLook.words[(((sceneLook.words[9u] >> 2u) + index * 1u)) + 0u]);
