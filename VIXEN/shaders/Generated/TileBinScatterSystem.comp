            if (IsBehindTileDepth(rect.nearDepth, imageLoad(tileFarDepth_previous, ivec2(int(tile) % imageSize(tileFarDepth_previous).x, int(tile) / imageSize(tileFarDepth_previous).x)).x))
            {
