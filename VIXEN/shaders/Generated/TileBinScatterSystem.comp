int ScatterLanes(TileBinView view) {
    int available = (view.tilesX - 1) * (view.tilesY - 1) * 64;
    if (view.instanceCount <= 0)
    {
        return 256;
    }
    int lanes = available / view.instanceCount;
    if (lanes > 256)
    {
        return 256;
    }
    return (lanes < 1 ? 1 : lanes);
}

TileRect ProjectBound(float centerX, float centerY, float centerZ, float radius, TileBinView view) {
    float vx = view.viewXx * centerX + view.viewXy * centerY + view.viewXz * centerZ + view.viewXw;
    float vy = view.viewYx * centerX + view.viewYy * centerY + view.viewYz * centerZ + view.viewYw;
    float vz = view.viewZx * centerX + view.viewZy * centerY + view.viewZz * centerZ + view.viewZw;
    float nearDepth = vz - radius;
    float farDepth = vz + radius;
    int lastX = view.tilesX - 1;
    int lastY = view.tilesY - 1;
    if (farDepth <= view.nearPlane)
    {
        return TileRect(0, 0, -1, -1, 0.0, 1);
    }
    if (nearDepth <= view.nearPlane)
    {
        return TileRect(0, 0, lastX, lastY, view.nearPlane, 0);
    }
    float left = vx - radius;
    float right = vx + radius;
    float bottom = vy - radius;
    float top = vy + radius;
    float leftDepth = (left < 0.0 ? nearDepth : farDepth);
    float rightDepth = (right > 0.0 ? nearDepth : farDepth);
    float bottomDepth = (bottom < 0.0 ? nearDepth : farDepth);
    float topDepth = (top > 0.0 ? nearDepth : farDepth);
    float minPixelX = view.centerX + view.focalX * (left / leftDepth) - 0.5;
    float maxPixelX = view.centerX + view.focalX * (right / rightDepth) + 0.5;
    float minPixelY = view.centerY + view.focalY * (bottom / bottomDepth) - 0.5;
    float maxPixelY = view.centerY + view.focalY * (top / topDepth) + 0.5;
    float width = view.tileSize * float(view.tilesX);
    float height = view.tileSize * float(view.tilesY);
    if (maxPixelX < 0.0 || maxPixelY < 0.0 || minPixelX >= width || minPixelY >= height)
    {
        return TileRect(0, 0, -1, -1, nearDepth, 2);
    }
    int minX = max(int(floor(minPixelX / view.tileSize)), 0);
    int minY = max(int(floor(minPixelY / view.tileSize)), 0);
    int maxX = min(int(floor(maxPixelX / view.tileSize)), lastX);
    int maxY = min(int(floor(maxPixelY / view.tileSize)), lastY);
    return TileRect(minX, minY, maxX, maxY, nearDepth, 0);
}

int TileWords(TileBinView view) {
    int words = (view.instanceCount + 32 - 1) / 32;
    return (words < view.wordCapacity ? words : view.wordCapacity);
}

bool IsBehindTileDepth(float nearDepth, float tileFarDepth) {
    return tileFarDepth > 0.0 && nearDepth > tileFarDepth;
}


void TileBinScatterSystem_Body(in TileBinView view, int i) {
    int lanes = ScatterLanes(view);
    if (i >= view.instanceCount * lanes)
    {
        return;
    }
    int instance = i / lanes;
    int lane = i - instance * lanes;
    TileRect rect = ProjectBound(bounds.values[instance].centerX, bounds.values[instance].centerY, bounds.values[instance].centerZ, bounds.values[instance].radius, view);
    if (rect.cull == 1)
    {
        if (lane == 0)
        {
            atomicAdd(stats.values[0].behindCamera, 1u);
        }
        return;
    }
    if (rect.cull == 2)
    {
        if (lane == 0)
        {
            atomicAdd(stats.values[0].offScreen, 1u);
        }
        return;
    }
    if (view.instanceCount > view.wordCapacity * 32)
    {
        if (lane == 0)
        {
            atomicAdd(stats.values[0].overflowed, 1u);
        }
        return;
    }
    uint rank = order.values[instance].rank;
    int rankWord = int((rank / 32u));
    if (rankWord >= TileWords(view))
    {
        if (lane == 0)
        {
            atomicAdd(stats.values[0].overflowed, 1u);
        }
        return;
    }
    uint rankBit = 1u << int((rank % 32u));
    int tileCount = view.tilesX * view.tilesY;
    int wordBase = rankWord * tileCount;
    int width = rect.maxX - rect.minX + 1;
    int area = width * (rect.maxY - rect.minY + 1);
    uint visible = 0u;
    for (int offset = lane; offset < area; offset += lanes)
    {
        int row = offset / width;
        int tileY = rect.minY + row;
        int tileX = rect.minX + (offset - row * width);
        int tile = tileY * view.tilesX + tileX;
        if (IsBehindTileDepth(rect.nearDepth, imageLoad(viewDepth_previous, ivec2(int(tile) % imageSize(viewDepth_previous).x, int(tile) / imageSize(viewDepth_previous).x)).x))
        {
            continue;
        }
        visible++;
        atomicOr(words.values[wordBase + tile].bits, rankBit);
    }
    if (lane < area && visible == 0u)
    {
        atomicAdd(stats.values[0].occludedSlices, 1u);
    }
    if (visible > 0u)
    {
        atomicAdd(stats.values[0].listed, visible);
    }
}
