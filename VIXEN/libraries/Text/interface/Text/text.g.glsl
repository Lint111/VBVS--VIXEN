float TextAnimationAlpha(SpanAnim anim, uint cluster, float now) {
    float age = max(now - anim.t0, 0.0);
    switch (anim.kind) {
        case TEXT_ANIMATION_FADE: return 1.0 - smoothstep(0.0, max(anim.duration, 0.001), age);
