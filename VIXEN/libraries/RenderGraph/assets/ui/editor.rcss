/* R766: content and style of the editor's panel documents (layers, outliner, inspector, status). The
   dock owns where each document's body sits (left/top/width/height); nothing here positions a panel on
   the page. */
body {
    font-family: LatoLatin;
    font-size: 15px;
    color: #d0d0d0;
    /* Default stretch so a document mounted before the dock places it has a non-degenerate layout. */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #161b29;
    overflow: auto;
    pointer-events: auto;  /* the panel owns its pointer: wheel scrolls it, a click or drag on it is not a world pick or camera drag */
}

.subtitle {
    display: block;
    color: #90c0ff;
    font-size: 13px;
    margin-top: 6px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 3px;
}

.kv {
    display: block;
    color: #a0b0d0;
    font-size: 13px;
}

.title {
    display: block;
    color: #90c0ff;
    font-size: 14px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 4px;
}

.col-op {
    display: inline-block;
    color: #90c0ff;
    font-size: 13px;
}

/* sn-editorpicker1: the Layers panel pins its toolbar above scrolling rows (the body does not scroll). */
body.layers {
    overflow: hidden;
}

/* The two document summaries are pinned, single-line rows. Their detail is available while the
   row has focus (or is hovered) without turning the layer list into an eight-row material menu. */
body.layers .inputs-pinned,
body.layers .outputs-pinned {
    flex: none;
    max-height: 24px;
    overflow: hidden;
    border-bottom-width: 1px;
    border-color: #303050;
    padding: 2px 0;
}
body.layers .inputs-pinned:hover,
body.layers .inputs-pinned:focus-within,
body.layers .outputs-pinned:hover,
body.layers .outputs-pinned:focus-within {
    max-height: 180px;
    overflow-y: auto;
}
body.layers .outputs-pinned {
    max-height: 112px;
    overflow-y: auto;
}
.section-summary {
    display: block;
    min-height: 18px;
    color: #90c0ff;
    font-size: 13px;
    line-height: 18px;
}
.section-count, .section-detail { color: #a0b0d0; font-size: 12px; }
.material-coverage, .default-material-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    color: #a0b0d0;
    font-size: 12px;
}
.material-chip, .node-material-chip {
    display: inline-block;
    flex: 1 1 auto;
    min-width: 0;
    margin-right: 6px;
    padding: 1px 5px;
    color: #f0f2ff;
    background-color: var(--material-color, #506090);
    border-width: 1px;
    border-color: #7f90c0;
}
.material-chip { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.material-coverage-percent { flex: 0 0 auto; min-width: 32px; text-align: right; }
.material-coverage { white-space: nowrap; }
.col-op { display: inline-block; min-width: 72px; max-width: 96px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.node-material-chip { flex: 0 0 auto; margin-top: 4px; font-size: 11px; }

/* The Add flyout: a filter field above the matching catalogue primitives (R872.1 rows, ranked by match). */
body.picker {
    overflow: hidden;
}

.picker-hint {
    flex: none;
    margin-top: 4px;
    padding-top: 4px;
}

.program-controls {
    display: block;
    margin-left: 24px;
    color: #a0a0c0;
    font-size: 12px;
}

.hint {
    display: block;
    margin-top: 10px;
    color: #707090;
    font-size: 12px;
    border-top-width: 1px;
    border-color: #303050;
    padding-top: 6px;
}

.node-entry {
    display: block;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-color: #252b40;
    padding-bottom: 3px;
}

.node-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    min-width: 0;
}

.node-toggle {
    flex: 1 1 180px;
    min-width: 0;
    margin-right: 6px;
}

.node-summary {
    flex: 1 1 auto;
    min-width: 0;
    margin: 5px 4px 0 0;
    overflow: hidden;
    color: #a0b0d0;
    font-size: 12px;
    white-space: nowrap;
}

.node-action {
    flex: 0 0 auto;
    margin-top: 2px;
    margin-left: 3px;
}

.node-actions {
    display: flex;
    flex: 0 0 100%;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    margin-top: 1px;
}

/* A refused remove is reported by the editor status line and remains available as the button
   title. Keep the generated reason part out of the resting row: an empty reason span must not
   become a disabled text-box-looking column beside every node. */
.node-actions ut-button .ut-reason { display: none; }

.node-actions .node-action:last-child {
    flex: 0 0 auto;
    min-width: 0;
}

.node-actions .node-remove {
    flex: 0 0 18px;
    width: 18px;
    min-width: 18px;
    margin-left: 3px;
    padding: 1px 2px;
    text-align: center;
}

.node-fields {
    display: block;
    margin: 0 0 3px 20px;
    padding: 2px 6px 4px;
    border-left-width: 1px;
    border-color: #506090;
}

.node-warning,
.layer-diagnostic {
    color: #f0bd68;
    white-space: normal;
}

.node-port {
    display: block;
    margin: 2px 0 3px 20px;
}

.node-port-choices {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 3px;
}

.node-port-selected {
    color: #b8d7ff;
    padding: 2px 4px;
}

.node-port-clear {
    flex: 0 0 auto;
}

/* R765: pack recipe list -- one button per layered document; the open one is highlighted. */
.recipe-row {
    display: block;
    margin-bottom: 2dp;
}

/* The panel documents scroll (body overflow: auto). Without a declared scrollbar size RmlUi gives the vertical
   scrollbar the whole width, collapsing the panel's content to 20 px once the rows outgrow the panel. */
scrollbarvertical {
    width: 12px;
    pointer-events: auto;
}

scrollbarvertical slidertrack {
    width: 12px;
    background-color: #202840;
}

scrollbarvertical sliderbar {
    width: 12px;
    min-height: 24px;
    background-color: #50609a;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}

.value {
    display: inline-block;
    color: #a0b0d0;
    font-size: 12px;
}

body.layers .ut-row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    min-height: 30px;
    margin-top: 3px;
    overflow: hidden;
}
body.layers .ut-row > ut-toggle { flex: 0 0 auto; }
body.layers .ut-row > ut-button.name { flex: 1 1 auto; width: auto; min-width: 34px; overflow: hidden; white-space: nowrap; }
body.layers .ut-row > .col-op {
    flex: 0 0 62px;
    width: 62px;
    min-width: 62px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 1px 3px;
    color: #90c0ff;
    background-color: #252b40;
    border-width: 1px;
    border-color: #3d4d75;
    font-size: 11px;
}
body.layers .dependency-mark { flex: 0 0 24px; width: 24px; min-width: 24px; overflow: hidden; color: #9fb0d0; white-space: nowrap; }
body.layers .layer-icon-button {
    flex: 0 0 18px;
    width: 18px;
    min-width: 18px;
    margin-left: 2px;
    padding: 1px 0;
}
body.layers .layer-diagnostic { flex: 0 1 auto; overflow: hidden; white-space: nowrap; }

/* The wrap picker stays reachable below the node list without pushing the layer transform and
   material rows below the viewport. Hover/focus expands the same control in place. */
.wrap-picker {
    max-height: 24px;
    overflow: hidden;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 2px;
}
.wrap-picker:hover, .wrap-picker:focus-within {
    max-height: 180px;
    overflow-y: auto;
}
