/* R766: content and style of the editor's panel documents (layers, outliner, inspector, status). The
   dock owns where each document's body sits (left/top/width/height); nothing here positions a panel on
   the page. */
body {
    font-family: LatoLatin;
    font-size: 15px;
    color: #d0d0d0;
    /* Default stretch so a document mounted before the dock places it has a non-degenerate layout. */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #161b29;
    overflow: auto;
    pointer-events: auto;  /* the panel owns its pointer: wheel scrolls it, a click or drag on it is not a world pick or camera drag */
}

.panel {
    display: block;
    padding: 8px 10px;
    pointer-events: none;
}

.subtitle {
    display: block;
    color: #90c0ff;
    font-size: 13px;
    margin-top: 6px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 3px;
}

.kv {
    display: block;
    color: #a0b0d0;
    font-size: 13px;
}

.panel.status {
    padding: 3px 10px;
    font-size: 13px;
    white-space: nowrap;
}

.status-doc {
    color: #e0d0b0;
}

.status-sep {
    color: #505878;
    margin-left: 6px;
    margin-right: 6px;
}

.status-message {
    color: #a0b0d0;
}

.title {
    display: block;
    color: #90c0ff;
    font-size: 14px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 4px;
}

.row {
    display: block;
    margin-top: 6px;
}

.checkbox {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-right: 8px;
    vertical-align: middle;
    background-color: #303050;
    border-width: 1px;
    border-color: #6080c0;
    pointer-events: auto;  /* interactive — clicks reach UISelectionProviderNode's hit-test */
}

.checkbox.checked {
    background-color: #60a0ff;
}

.col-name {
    display: inline-block;
    width: 70px;
    color: #e0d0b0;
}

.col-name.selected {
    color: #ffffff;
    text-decoration: underline;
}

.col-op {
    display: inline-block;
    color: #90c0ff;
    font-size: 13px;
}

.button {
    display: inline-block;
    min-width: 16px;
    margin-left: 3px;
    padding: 1px 4px;
    color: #d0e0ff;
    text-align: center;
    background-color: #303050;
    border-width: 1px;
    border-color: #6080c0;
    pointer-events: auto;
}

.button.selected {
    color: #ffffff;
    background-color: #50609a;
    border-color: #a0c0ff;
}

.op-choices {
    display: block;
    margin-top: 3px;
}

/* R872.1: the primitive picker is a compact scrolling list; each row is one catalogue primitive. */
.primitive-list {
    display: block;
    height: 76px;
    margin-top: 3px;
    overflow-y: auto;
}

.primitive-list .button {
    display: block;
    margin-left: 0;
    margin-bottom: 2px;
    text-align: left;
}

.program-controls {
    display: block;
    margin-left: 24px;
    color: #a0a0c0;
    font-size: 12px;
}

.value, .parameter-value, .parameter-range {
    display: inline-block;
    color: #a0b0d0;
    font-size: 12px;
}

.parameter-value.scrub {
    padding: 1px 4px;
    color: #c0d8ff;
    cursor: ew-resize;
    pointer-events: auto;  /* press-drag on the value label scrubs the parameter */
}

/* Typed value fields (the id is an AppFlow selector with a value slot; see UiInputForwarder.h). */
input.value-field, input.name-field {
    display: inline-block;
    width: 58px;
    height: 18px;
    padding: 1px 4px;
    color: #e8f0ff;
    font-size: 12px;
    background-color: #20263c;
    border-width: 1px;
    border-color: #50609a;
    pointer-events: auto;
    cursor: text;
}

input.name-field {
    width: 150px;
}

input.value-field:focus, input.name-field:focus {
    background-color: #2a3350;
    border-color: #a0c0ff;
}

input.value-field selection, input.name-field selection {
    background-color: #50609a;
}

.toolbar {
    display: block;
    margin-top: 8px;
}

.parameter-row {
    display: block;
    margin-top: 5px;
}

.parameter-name {
    display: inline-block;
    width: 110px;
    color: #e0d0b0;
}

.parameter-range {
    display: block;
    margin-left: 110px;
    color: #707090;
}

.hint {
    display: block;
    margin-top: 10px;
    color: #707090;
    font-size: 12px;
    border-top-width: 1px;
    border-color: #303050;
    padding-top: 6px;
}

/* R765: pack recipe list -- one button per layered document; the open one is highlighted. */
.recipe-row {
    display: block;
    margin-bottom: 2dp;
}

.recipe-row .button.open {
    background-color: #3a6ea5;
}

/* The panel documents scroll (body overflow: auto). Without a declared scrollbar size RmlUi gives the vertical
   scrollbar the whole width, collapsing the panel's content to 20 px once the rows outgrow the panel. */
scrollbarvertical {
    width: 12px;
    pointer-events: auto;
}

scrollbarvertical slidertrack {
    width: 12px;
    background-color: #202840;
}

scrollbarvertical sliderbar {
    width: 12px;
    min-height: 24px;
    background-color: #50609a;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}
