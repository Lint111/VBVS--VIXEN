/* R766: content and style of the editor's panel documents (layers, outliner, inspector, status). The
   dock owns where each document's body sits (left/top/width/height); nothing here positions a panel on
   the page. */
body {
    font-family: LatoLatin;
    font-size: 15px;
    color: #d0d0d0;
    /* Default stretch so a document mounted before the dock places it has a non-degenerate layout. */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #161b29;
    overflow: auto;
    pointer-events: auto;  /* the panel owns its pointer: wheel scrolls it, a click or drag on it is not a world pick or camera drag */
}

.panel {
    display: block;
    padding: 8px 10px;
    pointer-events: none;
}

.subtitle {
    display: block;
    color: #90c0ff;
    font-size: 13px;
    margin-top: 6px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 3px;
}

.kv {
    display: block;
    color: #a0b0d0;
    font-size: 13px;
}

.title {
    display: block;
    color: #90c0ff;
    font-size: 14px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 4px;
}

.col-op {
    display: inline-block;
    color: #90c0ff;
    font-size: 13px;
}

.button {
    display: inline-block;
    min-width: 16px;
    margin-left: 3px;
    padding: 1px 4px;
    color: #d0e0ff;
    text-align: center;
    background-color: #303050;
    border-width: 1px;
    border-color: #6080c0;
    pointer-events: auto;
}

.button.selected {
    color: #ffffff;
    background-color: #50609a;
    border-color: #a0c0ff;
}

/* sn-editorpicker1: the Layers panel pins its toolbar above scrolling rows (the body does not scroll). */
body.layers {
    overflow: hidden;
}

/* The Add flyout: a filter field above the matching catalogue primitives (R872.1 rows, ranked by match). */
body.picker {
    overflow: hidden;
}

.picker-hint {
    flex: none;
    margin-top: 4px;
    padding-top: 4px;
}

.program-controls {
    display: block;
    margin-left: 24px;
    color: #a0a0c0;
    font-size: 12px;
}

.hint {
    display: block;
    margin-top: 10px;
    color: #707090;
    font-size: 12px;
    border-top-width: 1px;
    border-color: #303050;
    padding-top: 6px;
}

/* R765: pack recipe list -- one button per layered document; the open one is highlighted. */
.recipe-row {
    display: block;
    margin-bottom: 2dp;
}

/* The panel documents scroll (body overflow: auto). Without a declared scrollbar size RmlUi gives the vertical
   scrollbar the whole width, collapsing the panel's content to 20 px once the rows outgrow the panel. */
scrollbarvertical {
    width: 12px;
    pointer-events: auto;
}

scrollbarvertical slidertrack {
    width: 12px;
    background-color: #202840;
}

scrollbarvertical sliderbar {
    width: 12px;
    min-height: 24px;
    background-color: #50609a;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}

.value {
    display: inline-block;
    color: #a0b0d0;
    font-size: 12px;
}
