/* R874 UI kit: the ONE look of the foundation elements (assets/ui/kit/*.rml are their structure, UiKit.cpp their
   behaviour). Editing this file on a running app restyles every instance in every panel. */

/* ---- button ---- */
ut-button, ut-number-field .ut-step, ut-number-field .ut-reset {
    display: inline-block;
    min-width: 16px;
    margin-left: 3px;
    padding: 1px 4px;
    color: #d0e0ff;
    text-align: center;
    background-color: #303050;
    border-width: 1px;
    border-color: #6080c0;
    pointer-events: auto;
}
ut-button .ut-label { pointer-events: none; }
ut-button.selected, ut-button.open { color: #ffffff; background-color: #50609a; border-color: #a0c0ff; }
ut-button.open { background-color: #3a6ea5; }
ut-button.row { display: block; margin-left: 0; margin-bottom: 2px; text-align: left; }
ut-button.name { display: inline-block; width: 70px; margin-left: 0; padding: 0; border-width: 0; background-color: transparent; color: #e0d0b0; text-align: left; }
ut-button.name.selected { color: #ffffff; text-decoration: underline; }
/* dock chrome variants */
ut-button.tool { min-width: 12px; margin-left: 3px; padding: 0px 2px; color: #9fb0d0; background-color: transparent; border-width: 0; }
ut-button.tool:hover { color: #ffffff; background-color: #3a4a6c; }
ut-button.tool.close { color: #c09090; }
ut-button.tab { display: block; position: absolute; margin-left: 0; padding: 4px 6px 0px 8px; text-align: left; color: #c8d0e0; background-color: #1c2334; border-width: 0; border-right-width: 1px; border-color: #34405a; overflow: hidden; white-space: nowrap; }
ut-button.tab.active { background-color: #26324c; color: #e8eeff; border-top-width: 2px; border-top-color: #5a8ae0; }
/* the round variant (HUD): hit-mask ellipse is forced by the element; the HUD's document owns placement */
ut-button.round {
    width: 48px;
    height: 48px;
    padding: 0;
    margin-left: 0;
    color: #e0f0ff;
    font-size: 28px;
    text-align: center;
    background-color: #4060a0cc;
    border-color: #80a0e0;
    border-radius: 24px;
    line-height: 48px;
}

/* ---- toggle ---- */
ut-toggle {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-right: 8px;
    vertical-align: middle;
    background-color: #303050;
    border-width: 1px;
    border-color: #6080c0;
    pointer-events: auto;
}
ut-toggle.checked { background-color: #60a0ff; }
ut-toggle .ut-mark { pointer-events: none; }

/* ---- text / number fields: the ONE input look ---- */
ut-text-field, ut-number-field .ut-input {
    display: inline-block;
    padding: 1px 4px;
    color: #e8f0ff;
    font-size: 12px;
    background-color: #20263c;
    border-width: 1px;
    border-color: #50609a;
    pointer-events: auto;
    cursor: text;
}
ut-text-field:focus, ut-number-field .ut-input:focus { background-color: #2a3350; border-color: #a0c0ff; }
ut-text-field selection, ut-number-field .ut-input selection { background-color: #50609a; }
ut-text-field { display: block; width: 100%; box-sizing: border-box; height: 24px; padding: 3px 6px; font-size: 14px; flex: none; }
ut-number-field .ut-input { width: 58px; height: 18px; }
ut-text-field.wide { width: 150px; display: inline-block; height: 18px; padding: 1px 4px; font-size: 12px; }

/* ---- number field ---- */
ut-number-field { display: block; margin-top: 5px; }
ut-number-field .ut-label { display: inline-block; color: #e0d0b0; margin-right: 8px; cursor: ew-resize; pointer-events: auto; }
ut-number-field .ut-controls { display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; margin-top: 2px; }
ut-number-field .ut-controls .ut-input, ut-number-field .ut-step, ut-number-field .ut-reset { flex: none; }
ut-number-field .ut-range { flex: 0 1 auto; min-width: 0; margin-left: 6px; overflow: hidden; white-space: nowrap; color: #707090; font-size: 11px; }
ut-number-field.inline { display: flex; flex-direction: row; align-items: center; }
ut-number-field.inline .ut-label { width: 110px; margin-right: 0; }
ut-number-field.inline .ut-controls { margin-top: 0; }

/* ---- choice group / list / toolbar / panel / flyout / status line ---- */
ut-choice-group { display: block; margin-top: 3px; }
ut-choice-group > .ut-label { display: inline-block; width: 110px; color: #e0d0b0; }
ut-list { display: block; overflow-y: auto; pointer-events: auto; }
ut-list.fill { flex: 1 1 0; min-height: 0; }
.ut-row { display: block; margin-top: 6px; }
ut-toolbar { display: block; margin-top: 8px; flex: none; }
ut-panel { display: block; padding: 8px 10px; pointer-events: none; }
ut-panel.fill, ut-flyout { display: flex; flex-direction: column; height: 100%; box-sizing: border-box; }
ut-flyout { padding: 8px 10px; pointer-events: none; }
ut-status-line { display: block; padding: 3px 10px; font-size: 13px; white-space: nowrap; pointer-events: none; }
ut-status-line .ut-status-doc { color: #e0d0b0; }
ut-status-line .ut-status-sep { color: #505878; margin-left: 6px; margin-right: 6px; }
ut-status-line .ut-status-message { color: #a0b0d0; }

/* a plain label beside a text field (the layer name row) */
.ut-field-label { display: inline-block; width: 110px; color: #e0d0b0; }

ut-panel.fill > ut-toolbar { margin-top: 0; margin-bottom: 4px; }
.picker-rows { margin-top: 6px; }

/* ---- HUD panel and key/value rows ---- */
body.building-inspector {
    font-family: LatoLatin;
    font-size: 14px;
    color: #d0d0d0;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

ut-panel.hud,
body.building-inspector > #building {
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 240px;
    padding: 8px 12px;
    color: #d0d0d0;
    font-family: LatoLatin;
    font-size: 14px;
    background-color: #101c2edd;
    border-width: 1px;
    border-color: #4080a0;
    border-radius: 4px;
    pointer-events: none;
}
body.building-inspector > #building > ut-panel.hud {
    position: static;
    left: auto;
    bottom: auto;
    width: auto;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}
body.building-inspector > #building .ut-hud-title { color: #80c0ff; font-size: 15px; margin-bottom: 4px; }
body.building-inspector > #building .ut-hud-group-label {
    display: block;
    color: #607090;
    font-size: 11px;
    margin-top: 6px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-color: #283048;
    padding-bottom: 1px;
}
body.building-inspector > #building .ut-row { display: block; margin-top: 1px; }
body.building-inspector > #building .ut-field-label { display: inline-block; width: 96px; color: #8090a8; }
body.building-inspector > #building .ut-field-value { display: inline-block; color: #d8e0f0; }
body.building-inspector > #building .ut-hud-owned { display: block; margin-top: 6px; color: #80e0a0; }
body.building-inspector > #building .impact-ok { color: #80e0a0; }
body.building-inspector > #building .impact-throttled { color: #f0c060; }
body.building-inspector > #building .impact-halted { color: #f07060; }
