<rml>
<head>
    <link type="text/rcss" href="kit/kit.rcss"/>
</head>
<body class="building-inspector">
    <!-- Isolated "building" data model — its variable names must not collide with the HUD's "hud"
         model. Bound by BuildingInspectorView::Register (BuildingInspectorBridge.cpp). All display
         transforms (impact label, unit formatting, "you own this") are computed host-side and pushed
         as pre-formatted strings — no game logic in the fragment (spec §7.10 / §4). -->
    <div data-model="building" id="building">
        <!-- Ownership affordance line — shown only to the owning viewer (IsOwnerViewer, spec §5).
             It stays in the model wrapper so host-side selector queries see it across the kit boundary. -->
        <div class="owned ut-hud-owned">You own this.</div>

        <ut-panel variant="hud">
        <!-- Identity -->
        <div class="ut-hud-title">{{defId}}</div>
        <div class="ut-row"><span class="ut-field-label">Owner</span><span class="ut-field-value">{{ownerName}}</span></div>

        <!-- Power contribution (independently-authored region, spec §4) -->
        <div class="ut-hud-group-label">Power</div>
        <div class="ut-row"><span class="ut-field-label">Demand</span><span class="ut-field-value">{{powerDemand}}</span></div>
        <div class="ut-row"><span class="ut-field-label">Generated</span><span class="ut-field-value">{{powerGenerated}}</span></div>
        <div class="ut-row"><span class="ut-field-label">Stored</span><span class="ut-field-value">{{powerStored}}</span></div>
        <div class="ut-row"><span class="ut-field-label">Net</span><span class="ut-field-value">{{powerNet}}</span></div>
        <div class="ut-row"><span class="ut-field-label">Connected</span><span class="ut-field-value">{{powerConnected}}</span></div>
        <div class="ut-row"><span class="ut-field-label">Status</span><span class="ut-field-value" data-class-impact-ok="impactOk" data-class-impact-throttled="impactThrottled" data-class-impact-halted="impactHalted">{{powerImpact}}</span></div>

        <!-- Labor contribution (independently-authored region) -->
        <div class="ut-hud-group-label">Labor</div>
        <div class="ut-row"><span class="ut-field-label">Supply</span><span class="ut-field-value">{{laborSupply}}</span></div>
        <div class="ut-row"><span class="ut-field-label">Need</span><span class="ut-field-value">{{laborNeed}}</span></div>
        <div class="ut-row"><span class="ut-field-label">Met</span><span class="ut-field-value">{{laborNeedMet}}</span></div>
        </ut-panel>
    </div>
</body>
</rml>
