/* R766 dock chrome: frames and tab strips only. Transparent everywhere else so the panels (drawn below
   this document) and the viewport show through; only the tab buttons take clicks. */
body {
    font-family: LatoLatin;
    font-size: 13px;
    color: #c8d0e0;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

#dock {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.stack {
    position: absolute;
    border-width: 1px;
    border-color: #34405a;
    pointer-events: none;
}

.header {
    display: block;
    pointer-events: auto;   /* the header strip is UI (a floating panel's drag handle), not the world behind it */
    background-color: #141a28;
    border-bottom-width: 1px;
    border-color: #34405a;
}

