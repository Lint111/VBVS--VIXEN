<rml>
<head>
    <title>Status</title>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="kit/kit.rcss"/>
</head>
<body>
    <!-- R766 "status" panel (bottom region, no tab strip): the open document, the AppFlow state, the undo
         depth and the last message, drawn by the kit's one status-line element. -->
    <ut-status-line data-model="editor_layers" data-attr-doc="statusDocument" data-attr-state="flowState"
                    data-attr-undo="undoDepth" data-attr-redo="redoDepth" data-attr-message="statusMessage"/>
</body>
</rml>
