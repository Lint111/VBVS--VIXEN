<rml>
<head>
    <title>Add primitive</title>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="kit/kit.rcss"/>
</head>
<body class="picker">
    <!-- sn-editorpicker1: the Add flyout (a declared Floating panel). The filter field takes focus when the panel
         opens (autofocus); typing writes the View's pickerFilter through the data binding and the rows below are the
         catalogue primitives that match, best match first. Enter commits the field: its id is the ChoosePrimitive
         selector with a value slot ("picker-filter-{filter}"), which adds the first match and closes the flyout.
         Clicking a row adds that primitive (CreatePrimitiveLayer, selector "primitive-<name>-add"); Escape closes. -->
    <ut-flyout data-model="editor_layers">
        <ut-text-field autofocus="autofocus" id="picker-filter-{filter}" data-value="pickerFilter"/>
        <div class="picker-section" data-if="nodePickerActive">
            <div class="picker-section-title">Read from layer</div>
            <div class="hint picker-hint" data-if="readPortChoices.size == 0">{{readPortEmptyReason}}</div>
            <ut-list class="picker-rows">
                <ut-button variant="row" data-for="item : readPortChoices" data-attr-id="item.elementId"
                           data-attr-label="item.label"> </ut-button>
            </ut-list>
        </div>
        <div class="picker-section" data-if="nodePickerActive">
            <div class="picker-section-title">Insert after node</div>
            <div class="hint picker-hint" data-if="nodeChoices.size == 0">No compatible operations match "{{pickerFilter}}".</div>
            <ut-list class="fill picker-rows">
                <ut-button variant="row" data-for="item : nodeChoices" data-attr-id="item.elementId"
                           data-attr-label="item.display"> </ut-button>
            </ut-list>
        </div>
        <div data-if="!nodePickerActive">
            <div class="hint picker-hint" data-if="primitives.size == 0">No primitive matches "{{pickerFilter}}".</div>
            <ut-list class="fill picker-rows">
                <ut-button variant="row" data-for="item : primitives" data-attr-id="item.elementId" data-attr-label="item.display"> </ut-button>
            </ut-list>
        </div>
        <div class="picker-section" data-if="!nodePickerActive">
            <div class="picker-section-title">Materials</div>
            <div class="hint picker-hint" data-if="materials.size == 0">No pack materials match "{{pickerFilter}}".</div>
            <div class="picker-rows">
                <ut-button variant="row" data-for="item : materials" data-attr-id="item.elementId" data-attr-label="item.name"
                            data-attr-style="'--material-color: ' + item.color + '; --material-text-color: ' + item.textColor"> </ut-button>
            </div>
            <div class="hint picker-hint">From input: no material-typed parameters in this document.</div>
        </div>
        <!-- R872.6: the same filter drives the second, pack-recipe section. Each row dispatches
             InsertRecipeReference and is omitted for the open recipe by the editor publisher. -->
        <div class="picker-section" data-if="!nodePickerActive">
            <div class="picker-section-title">Pack recipes</div>
            <div class="hint picker-hint" data-if="packRecipes.size == 0">No pack recipes match "{{pickerFilter}}".</div>
            <div class="picker-rows">
                <ut-button variant="row" data-for="item : packRecipes" data-attr-id="item.elementId" data-attr-label="item.id"> </ut-button>
            </div>
        </div>
        <div class="hint picker-hint">Type to filter, Enter adds the first match, Esc closes.</div>
    </ut-flyout>
</body>
</rml>
