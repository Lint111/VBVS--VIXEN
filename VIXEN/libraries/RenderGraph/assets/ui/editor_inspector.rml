<rml>
<head>
    <title>Inspector</title>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="kit/kit.rcss"/>
</head>
<body>
    <!-- R766 "inspector" panel (right region): the open document's recipe parameters, the selected layer and its
         shape and placement. Every numeric row is the kit's ut-number-field: value-id is the declared set selector with
         its value slot ("parameter-<index>-set-{value}"), reset-id an action selector; nudge, scrub, range text and the
         refusal snap-back are the element's (UiKit.cpp), not this document's. -->
    <ut-panel data-model="editor_layers">
        <div class="subtitle">Recipe parameters</div>
        <ut-number-field data-for="param : parameters" data-attr-label="param.name" data-attr-unit="param.unit"
                         data-attr-value="param.value" data-attr-value-id="param.setId"
                         data-attr-reset-id="'parameter-' + it_index + '-reset'"
                         data-attr-min="param.minimum" data-attr-max="param.maximum"> </ut-number-field>
        <div class="hint" data-if="parameters.size == 0">This document declares no parameters.</div>
        <div class="subtitle">Layer {{selectedLayer}}</div>
        <div class="ut-row"><span class="ut-field-label">name</span>
            <ut-text-field class="wide" data-attr-id="'layer-' + selectedLayer + '-name-{name}'" data-attr-value="selectedLayerName"/></div>
        <ut-number-field variant="inline" data-for="row : layers" data-if="row.isSelected" label="blend radius"
                         data-attr-value="row.blendRadius" data-attr-value-id="row.blendValueId"> </ut-number-field>
        <div class="subtitle">Shape of {{selectedLayerName}}<span data-if="selectedShape != ''"> ({{selectedShape}})</span></div>
        <div class="hint" data-if="selectedShape == ''">{{shapeNote}}</div>
        <!-- R872.1: the combine op of the selected layer; rows come from the generated layer-op table. -->
        <ut-choice-group label="combine op">
            <ut-button data-for="choice : opChoices" data-attr-id="choice.elementId" data-attr-label="choice.name"
                       data-class-selected="choice.isCurrent"> </ut-button>
        </ut-choice-group>
        <ut-number-field data-for="field : shape" data-attr-label="field.label" data-attr-value="field.value"
                         data-attr-value-id="field.valueId" data-attr-reset-id="field.resetId"
                         data-attr-default="field.defaultValue"
                         data-attr-min="field.hasRange ? field.minimum : ''" data-attr-max="field.hasRange ? field.maximum : ''"> </ut-number-field>
        <div class="subtitle">Placement of {{selectedLayerName}} (layer {{selectedLayer}})</div>
        <ut-number-field variant="inline" data-for="field : transform" data-attr-label="field.label"
                         data-attr-value="field.value" data-attr-value-id="field.valueId"> </ut-number-field>
        <div class="subtitle">Layers</div>
        <div class="kv">{{activeLayerCount}} of {{layers.size}} rule layers enabled</div>
    </ut-panel>
</body>
</rml>
