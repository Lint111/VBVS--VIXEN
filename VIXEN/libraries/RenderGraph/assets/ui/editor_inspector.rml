<rml>
<head>
    <title>Inspector</title>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="kit/kit.rcss"/>
</head>
<body>
    <!-- R766 inspector: layer-level controls stay here; node fields have one home in the outline. -->
    <ut-panel data-model="editor_layers">
        <div class="subtitle">Recipe parameters</div>
        <ut-number-field data-for="param : parameters" data-attr-label="param.name" data-attr-unit="param.unit"
                         data-attr-value="param.value" data-attr-value-id="param.setId"
                         data-attr-reset-id="'parameter-' + it_index + '-reset'"
                         data-attr-min="param.minimum" data-attr-max="param.maximum"> </ut-number-field>
        <div class="hint" data-if="parameters.size == 0">This document declares no parameters.</div>
        <div class="subtitle">Layer {{selectedLayer}}</div>
        <div class="ut-row"><span class="ut-field-label">name</span>
            <ut-text-field class="wide" data-attr-id="'layer-' + selectedLayer + '-name-{name}'" data-attr-value="selectedLayerName"/></div>
        <ut-number-field variant="inline" data-for="row : layers" data-if="row.isSelected" label="blend radius"
                         data-attr-value="row.blendRadius" data-attr-value-id="row.blendValueId"> </ut-number-field>
        <!-- R872.1: the combine op is layer-level; primitive values live only in the selected node row. -->
        <ut-choice-group label="combine op">
            <ut-button data-for="choice : opChoices" data-attr-id="choice.elementId" data-attr-label="choice.name"
                       data-class-selected="choice.isCurrent"> </ut-button>
        </ut-choice-group>
        <div class="subtitle">Nodes</div>
        <div class="hint" data-if="rawProgram">raw program: {{rawProgramDiagnostic}}</div>
        <ut-list class="node-outline" data-if="!rawProgram">
            <div class="node-entry" data-for="node : nodes"
                 data-attr-style="'padding-left: ' + (node.indent * 14) + 'px'">
                <div class="node-row">
                    <ut-disclosure class="node-toggle" variant="row" data-attr-id="node.toggleId"
                                   data-attr-label="node.nodeIndex + '  ' + node.name + '  (' + node.category + ')'"
                                   data-attr-open="node.isExpanded" data-attr-title="node.summary" tabindex="0"> </ut-disclosure>
                    <div class="node-summary">{{node.summary}}</div>
                    <div class="node-actions">
                        <ut-button class="node-action" data-attr-id="node.addId" label="+ node"
                                   data-attr-disabled="node.addOp == ''"
                                   data-attr-title="node.addReason == '' ? 'add ' + node.addOp : node.addReason"
                                   data-attr-reason="node.addReason"> </ut-button>
                        <ut-button class="node-action" data-attr-id="node.removeId" label="remove"
                                   data-attr-disabled="!node.canRemove" data-attr-title="node.removeTitle"
                                   data-attr-reason="node.removeReason"> </ut-button>
                    </div>
                </div>
                <div class="node-fields" data-if="node.isExpanded">
                    <ut-number-field data-for="field : nodeArguments" data-if="field.nodeIndex == node.nodeIndex"
                                     data-attr-label="field.label" data-attr-value="field.value"
                                     data-attr-value-id="field.valueId" data-attr-reset-id="field.resetId"
                                     data-attr-default="field.defaultValue"
                                     data-attr-min="field.hasRange ? field.minimum : ''"
                                     data-attr-max="field.hasRange ? field.maximum : ''"> </ut-number-field>
                </div>
            </div>
        </ut-list>
        <ut-choice-group label="wrap in…" data-if="!rawProgram">
            <ut-button data-for="choice : nodeWrapChoices" data-attr-id="choice.elementId"
                       data-attr-label="choice.label" data-attr-title="'wrap nodes in ' + choice.label"> </ut-button>
        </ut-choice-group>
        <!-- Placement is the one layer-level transform shortcut. Transform node arguments are summarized above,
             not repeated here, so position/rotation/scale have one editable representation. -->
        <div class="subtitle">Placement of {{selectedLayerName}} (layer {{selectedLayer}})</div>
        <ut-number-field variant="inline" data-for="field : transform" data-attr-label="field.label"
                         data-attr-value="field.value" data-attr-value-id="field.valueId"> </ut-number-field>
        <div class="subtitle">Layers</div>
        <div class="kv">{{activeLayerCount}} of {{layers.size}} rule layers enabled</div>
    </ut-panel>
</body>
</rml>
