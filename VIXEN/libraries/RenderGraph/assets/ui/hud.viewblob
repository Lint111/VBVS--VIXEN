# viewblob v1
model hud
version 0xAB357DCD
elem HudFaction
  name string
  grievance float
  focused bool
  known bool
  inLens bool
  recentChanged bool
  recentEventAge int
elem HudEvent
  kind string
  tick int
field tick int
field bodyCount int
field activeLensName string
field activeLensCount int
field factions array HudFaction
field events array HudEvent
field inspectSelected int
field inspectName string
field inspectCause string
field inspectMaxGrievance float
field inspectStrength float
field inspectTopRelName string
field inspectTopRelSig float
