<rml>
<head>
    <title>Layers</title>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="kit/kit.rcss"/>
</head>
<body class="layers">
    <!-- R766 "layers" panel (left region): the rule layers of the open document, bound to the generated
         EditorLayers View. Each row's ids are AppFlow selectors ("layer-<index>-toggle", "-select", ...), resolved
         by AppFlowRuntime::DispatchBySelector; the panel names no action itself. The dock places this
         document; this file styles only its content, and every control is a kit element. -->
    <ut-panel class="fill" data-model="editor_layers">
        <!-- sn-editorpicker1: the toolbar is pinned above the scrolling rows, so it never clips however many layers
             there are. Add opens the declared "picker" flyout panel (OpenPanel, selector "panel-picker-open"). -->
        <ut-toolbar>
            <ut-button id="panel-picker-open" label="Add"/>
            <ut-button id="undo-button" label="Undo"/>
            <ut-button id="redo-button" label="Redo"/>
        <ut-button id="save-button" label="Save"/>
        <ut-button id="reopen-button" label="Reopen saved"/>
        </ut-toolbar>
        <div class="inputs-pinned">
            <div class="subtitle">Inputs</div>
            <ut-number-field data-for="param : parameters" data-attr-label="param.name" data-attr-unit="param.unit"
                             data-attr-value="param.value" data-attr-value-id="param.setId"
                             data-attr-reset-id="'parameter-' + it_index + '-reset'"
                             data-attr-min="param.minimum" data-attr-max="param.maximum"> </ut-number-field>
            <div class="hint" data-if="parameters.size == 0">This document declares no inputs.</div>
        </div>
        <div class="outputs-pinned">
            <div class="subtitle">Outputs</div>
            <div class="kv"><span>Distance</span><span>surface distance</span></div>
            <div class="kv"><span>MaterialId</span><span>stored per output sample</span></div>
            <div class="subtitle">Document default material</div>
            <div class="hint" data-if="materials.size == 0">Loose document: neutral default (no pack material table).</div>
            <div class="material-defaults" data-for="material : materials">
                <ut-button variant="row" data-attr-id="material.defaultId" data-attr-label="material.name"
                            data-attr-style="'--material-color: ' + material.color"> </ut-button>
            </div>
        </div>
        <ut-list class="fill">
            <div class="ut-row" data-for="row : layers">
                <ut-toggle data-attr-id="row.elementId" data-attr-checked="row.isChecked"> </ut-toggle>
                <ut-button variant="name" data-attr-id="row.selectId" data-attr-label="row.name" data-class-selected="row.isSelected"> </ut-button>
                <span class="col-op">{{row.op}}</span>
                <span class="dependency-mark" data-attr-title="row.dependencyTitle + (row.warningTitle == '' ? '' : ' — ' + row.warningTitle)">{{row.providesMark}} {{row.readsMark}} {{row.readByMark}} {{row.warningMark}}</span>
                <ut-button class="layer-provide" data-attr-id="row.provideId" label="provide"> </ut-button>
                <ut-button class="layer-solo" data-attr-id="row.soloId" label="solo" data-class-selected="row.isSolo"> </ut-button>
                <ut-button data-attr-id="row.moveUpId" label="ˆ"> </ut-button>
                <ut-button data-attr-id="row.moveDownId" label="ˇ"> </ut-button>
                <ut-button data-attr-id="row.deleteId" label="×"> </ut-button>
                <div class="program-controls">
                    <span class="value">blend radius: {{row.blendRadius}}</span>
                    <ut-button data-attr-id="row.blendDownId" label="−"> </ut-button>
                    <ut-button data-attr-id="row.blendUpId" label="+"> </ut-button>
                </div>
                <div class="material-row">
                    <span class="ut-field-label">material</span>
                    <span data-attr-style="row.materialColor == '' ? '' : '--material-color: ' + row.materialColor">{{row.materialName}}</span>
                    <ut-button data-if="row.materialClearId != ''" data-attr-id="row.materialClearId" label="clear"> </ut-button>
                </div>
                <div class="layer-diagnostic" data-if="row.diagnostic != ''">{{row.diagnostic}}</div>
            </div>
        </ut-list>
    </ut-panel>
</body>
</rml>
