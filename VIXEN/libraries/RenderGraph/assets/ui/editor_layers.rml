<rml>
<head>
    <title>Layers</title>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="kit/kit.rcss"/>
</head>
<body class="layers">
    <!-- R766 "layers" panel (left region): the rule layers of the open document, bound to the generated
         EditorLayers View. Each row's ids are AppFlow selectors ("layer-<index>-toggle", "-select", ...), resolved
         by AppFlowRuntime::DispatchBySelector; the panel names no action itself. The dock places this
         document; this file styles only its content, and every control is a kit element. -->
    <ut-panel class="fill" data-model="editor_layers">
        <!-- sn-editorpicker1: the toolbar is pinned above the scrolling rows, so it never clips however many layers
             there are. Add opens the declared "picker" flyout panel (OpenPanel, selector "panel-picker-open"). -->
        <ut-toolbar>
            <ut-button id="panel-picker-open" label="Add"/>
            <ut-button id="undo-button" label="Undo"/>
            <ut-button id="redo-button" label="Redo"/>
        <ut-button id="save-button" label="Save"/>
        <ut-button id="reopen-button" label="Reopen saved"/>
        </ut-toolbar>
        <div class="layer-action-legend" title="P provide | S solo | ^/v move | x remove">P provide | S solo | ^/v move | x remove</div>
        <div class="inputs-pinned">
            <div class="section-summary">Inputs <span class="section-count">({{parameters.size}})</span></div>
            <ut-number-field data-for="param : parameters" data-attr-label="param.name" data-attr-unit="param.unit"
                             data-attr-value="param.value" data-attr-value-id="param.setId"
                             data-attr-reset-id="'parameter-' + it_index + '-reset'"
                             data-attr-min="param.minimum" data-attr-max="param.maximum"> </ut-number-field>
            <div class="hint" data-if="parameters.size == 0">This document declares no inputs.</div>
        </div>
        <div class="outputs-pinned">
            <div class="section-summary" title="Share of the surface per material">Outputs
                <span class="section-detail" data-if="materialCoverageCount == 0">Distance + MaterialId</span>
                <span class="section-detail" data-if="materialCoverageCount == 1">1 material</span>
                <span class="section-detail" data-if="materialCoverageCount > 1">{{materialCoverageCount}} materials</span>
            </div>
            <div class="material-coverage" data-for="material : materials" data-if="material.coverage != ''"
                 data-class-stale="material.coverageStale">
                <span class="material-chip" data-attr-style="'--material-color: ' + material.color + '; --material-text-color: ' + material.textColor">{{material.name}}</span>
                <span class="material-coverage-percent">{{material.coverage}}</span>
            </div>
            <div class="default-material-row" data-for="material : materials" data-if="material.defaultId != ''">
                <span class="ut-field-label">Default</span>
                <ut-button class="default-material-chip" variant="row" data-attr-id="material.defaultId" data-attr-label="material.name"
                            data-attr-style="'--material-color: ' + material.color + '; --material-text-color: ' + material.textColor"> </ut-button>
                <span class="default-material-unused" data-if="material.coverage == ''">not used: every surface has material</span>
            </div>
            <div class="hint" data-if="materialCoverageCount == 0">No sampled material coverage yet.</div>
            <div class="hint" data-if="materialCoverageCount != 0 && materialCoverageStale">Measuring current revision...</div>
        </div>
        <ut-list class="fill">
            <div class="ut-row" data-for="row : layers">
                <div class="layer-row-main">
                    <ut-toggle data-attr-id="row.elementId" data-attr-checked="row.isChecked"> </ut-toggle>
                    <ut-button variant="name" data-attr-id="row.selectId" data-attr-label="row.name" data-class-selected="row.isSelected"> </ut-button>
                    <span class="col-op" data-if="row.op != ''" data-attr-title="row.opTitle">{{row.op}}</span>
                    <ut-button class="layer-icon-button layer-provide" data-attr-id="row.provideId" icon="provide" data-attr-title="'provide ' + row.name"> </ut-button>
                    <ut-button class="layer-icon-button layer-solo" data-attr-id="row.soloId" icon="solo" data-class-selected="row.isSolo" data-attr-title="'solo ' + row.name"> </ut-button>
                    <ut-button class="layer-icon-button" data-attr-id="row.moveUpId" icon="up" data-attr-title="'move ' + row.name + ' up'"> </ut-button>
                    <ut-button class="layer-icon-button" data-attr-id="row.moveDownId" icon="down" data-attr-title="'move ' + row.name + ' down'"> </ut-button>
                    <ut-button class="layer-icon-button" data-attr-id="row.deleteId" icon="remove" data-attr-title="'remove ' + row.name"> </ut-button>
                </div>
                <div class="layer-row-meta" data-attr-title="row.dependencyTitle + (row.warningTitle == '' ? '' : ' - ' + row.warningTitle)">
                    <span class="layer-kind-chip" data-if="row.providesMark != ''">{{row.providesMark}}</span>
                    <span class="layer-dependency" data-if="row.readsMark != ''">{{row.readsMark}}</span>
                    <span class="layer-dependency" data-if="row.readByMark != ''">{{row.readByMark}}</span>
                    <span class="layer-warning" data-if="row.warningMark != ''">{{row.warningMark}}</span>
                    <span class="set-status" data-if="row.setStatus != ''" data-class-stale="row.setStatusStale">{{row.setStatus}}</span>
                </div>
                <div class="layer-diagnostic" data-if="row.diagnostic != ''">{{row.diagnostic}}</div>
            </div>
        </ut-list>
    </ut-panel>
</body>
</rml>
