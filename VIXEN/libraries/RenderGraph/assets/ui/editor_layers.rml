<rml>
<head>
    <title>Layers</title>
    <link type="text/rcss" href="editor.rcss"/>
</head>
<body>
    <!-- R766 "layers" panel (left region): the rule layers of the open document, bound to the generated
         EditorLayers View. Each row's ids are AppFlow selectors ("layer-<index>-toggle", "-select", "-nudge-blend-up", ...), resolved
         by AppFlowRuntime::DispatchBySelector; the panel names no action itself. The dock places this
         document; this file styles only its content. -->
    <div data-model="editor_layers" class="panel">
        <div class="row" data-for="row : layers">
            <div data-attr-id="row.elementId" class="checkbox" data-class-checked="row.isChecked" hit-mask="none"></div>
            <div class="col-name" data-attr-id="row.selectId" data-class-selected="row.isSelected" hit-mask="none">{{row.name}}</div>
            <span class="col-op">{{row.op}}</span>
            <div class="button" data-attr-id="row.moveUpId" hit-mask="none">ˆ</div>
            <div class="button" data-attr-id="row.moveDownId" hit-mask="none">ˇ</div>
            <div class="button" data-attr-id="row.deleteId" hit-mask="none">×</div>
            <div class="program-controls">
                <span class="value">blend radius: {{row.blendRadius}}</span>
                <div class="button" data-attr-id="row.blendDownId" hit-mask="none">−</div>
                <div class="button" data-attr-id="row.blendUpId" hit-mask="none">+</div>
            </div>
        </div>
        <!-- R872.1: the op of the selected layer (rows come from the generated layer-op table) and the
             primitive picker (rows come from the generated recipe-op catalogue; one click appends a layer). -->
        <div class="subtitle">Combine op of {{selectedLayerName}}</div>
        <div class="op-choices">
            <div class="button" data-for="choice : opChoices" data-attr-id="choice.elementId" data-class-selected="choice.isCurrent" hit-mask="none">{{choice.name}}</div>
        </div>
        <div class="subtitle">Add primitive</div>
        <div class="primitive-list">
            <div class="button" data-for="item : primitives" data-attr-id="item.elementId" hit-mask="none">{{item.name}}</div>
        </div>
        <div class="toolbar">
            <div class="button" id="undo-button" hit-mask="none">Undo</div>
            <div class="button" id="redo-button" hit-mask="none">Redo</div>
            <div class="button" id="save-button" hit-mask="none">Save</div>
            <div class="button" id="reopen-button" hit-mask="none">Reopen saved</div>
        </div>
    </div>
</body>
</rml>
