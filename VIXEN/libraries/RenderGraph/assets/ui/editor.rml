<rml>
<head>
    <title>VIXEN Editor</title>
    <link type="text/rcss" href="editor.rcss"/>
</head>
<body>
    <div id="panel">
        <div class="title">Layers</div>
        <!-- Inc1: layer rows are static (the golden document has exactly 3 layers: base/bulge/cut).
             Each row's checkbox div carries id="layer-<index>-toggle" and hit-mask="none" (plain
             rectangular hit test) so UISelectionProviderNode's click hit-test resolves it and
             EditorApplication::Update drains the id via DrainClickedElementId and dispatches it
             through AppFlowRuntime::DispatchBySelector (Inc-4 reframe R5 — the editor names no
             action verbs; the "layer-<index>-toggle" binding resolves to the ToggleLayer handler). -->
        <div class="row">
            <div id="layer-0-toggle" class="checkbox checked" hit-mask="none"></div>
            <span class="col-name">base</span>
            <span class="col-op">box</span>
        </div>
        <div class="row">
            <div id="layer-1-toggle" class="checkbox checked" hit-mask="none"></div>
            <span class="col-name">bulge</span>
            <span class="col-op">smooth_union</span>
        </div>
        <div class="row">
            <div id="layer-2-toggle" class="checkbox checked" hit-mask="none"></div>
            <span class="col-name">cut</span>
            <span class="col-op">subtract</span>
        </div>
        <div class="hint">Click a box to toggle a layer. Press S to save.</div>
    </div>
</body>
</rml>
