body {
    font-family: LatoLatin;
    font-size: 16px;
    color: #d0d0d0;
}

#hud {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 8px 12px;
    background-color: #1a1a2ecc;
    border-width: 1px;
    border-color: #4060a0;
}

#hud-tick {
    display: block;
    color: #90c0ff;
}

#hud-bodies {
    display: block;
    color: #a0e0a0;
    margin-top: 4px;
}
