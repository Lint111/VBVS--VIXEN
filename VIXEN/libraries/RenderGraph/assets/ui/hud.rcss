body {
    font-family: LatoLatin;
    font-size: 16px;
    color: #d0d0d0;
    /* Stretch the document to fill the whole context (viewport). Every HUD element is
       position:absolute and anchored to an edge (#hud → top/right, the buttons → bottom/left), so
       they resolve against this element as their containing block. Without an explicit size the body
       has only out-of-flow children and collapses to 0x0 — then `right`/`bottom` anchor against a
       zero-sized block and every element lands off-screen (negative offset). Anchoring all four edges
       (the RmlUi full-window idiom, cf. the RmlUi demo sample's `body { top/left/right/bottom: 0 }`)
       makes the body span the context so the HUD is positioned correctly. */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* Make the body transparent to picking so empty space and the read-only HUD pass click THROUGH to
       the voxel world (RmlUi's GetElementAtPoint skips pointer-events:none elements). Interactive
       widgets opt back in with pointer-events:auto. NOTE: pointer-events is inherited, so this
       cascades to #hud and its children by default. */
    pointer-events: none;
}

#hud {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 220px;
    padding: 8px 12px;
    background-color: #1a1a2ecc;
    border-width: 1px;
    border-color: #4060a0;
    pointer-events: none;  /* read-only panel — never occludes the voxel pick (explicit) */
}

/* ---- Demo interactive widget (S-step proof of hit-mask hit vs pass-through) ----
   A small round button with an ELLIPSE hit-mask: a click on the disc registers as a UI hit, while a
   click in the transparent square corners passes through to the voxel pick. Opts back into picking
   with pointer-events:auto (overriding the inherited none). No action wiring yet (later S4 step). */
#demo-btn {
    position: absolute;
    bottom: 16px;
    left: 16px;
    width: 48px;
    height: 48px;
    background-color: #4060a0cc;
    color: #e0f0ff;
    font-size: 28px;
    text-align: center;
    border-width: 1px;
    border-color: #80a0e0;
    border-radius: 24px;
    pointer-events: auto;  /* interactive — the provider then runs the hit-mask test */
}

/* ---- Focus button (view:focus) ---- */
/* Sits beside #demo-btn; same ellipse hit-mask / pointer-events:auto. Clicking it cycles the player's
   focused faction (the binding lives in hud.utdl). */
#focus-btn {
    position: absolute;
    bottom: 16px;
    left: 72px;
    width: 48px;
    height: 48px;
    background-color: #4060a0cc;
    color: #e0f0ff;
    font-size: 28px;
    text-align: center;
    border-width: 1px;
    border-color: #80a0e0;
    border-radius: 24px;
    pointer-events: auto;  /* interactive — the provider then runs the hit-mask test */
}

/* ---- Investigate button (player:investigate) ---- */
/* Sits beside #focus-btn; same ellipse hit-mask / pointer-events:auto. Clicking it investigates the
   focused faction, raising the player's knowledge of it to Known (the binding lives in hud.utdl). */
#investigate-btn {
    position: absolute;
    bottom: 16px;
    left: 128px;
    width: 48px;
    height: 48px;
    background-color: #4060a0cc;
    color: #e0f0ff;
    font-size: 28px;
    text-align: center;
    border-width: 1px;
    border-color: #80a0e0;
    border-radius: 24px;
    pointer-events: auto;  /* interactive — the provider then runs the hit-mask test */
}

/* ---- Lens button (view:lens) ---- */
/* Sits beside #investigate-btn; same ellipse hit-mask / pointer-events:auto. Clicking it cycles the
   active map lens None→Intel→Logistics→Threat (the binding lives in hud.utdl). */
#lens-btn {
    position: absolute;
    bottom: 16px;
    left: 184px;
    width: 48px;
    height: 48px;
    background-color: #4060a0cc;
    color: #e0f0ff;
    font-size: 28px;
    text-align: center;
    border-width: 1px;
    border-color: #80a0e0;
    border-radius: 24px;
    pointer-events: auto;  /* interactive — the provider then runs the hit-mask test */
}

/* ---- Clock row ---- */
.clock {
    display: block;
    color: #90c0ff;
    margin-bottom: 8px;
}

/* ---- Active-lens status (view:lens) ---- */
/* Shows "Lens: {name} ({count})" from the Hud ActiveLens/ActiveLensCount columns. */
.lens-status {
    display: block;
    color: #b090e0;
    font-size: 13px;
    margin-bottom: 8px;
}

/* ---- Section label ---- */
.section-label {
    display: block;
    color: #707090;
    font-size: 12px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-color: #303050;
    padding-bottom: 2px;
}

/* ---- Shared row layout ---- */
.factions,
.events {
    display: block;
    margin-top: 6px;
}

.row {
    display: block;
    margin-top: 3px;
    border-left-width: 2px;
    border-color: transparent;  /* default: no focus bar (the .focused rule lights it) */
    padding-left: 4px;
}

/* ---- Faction row state (driven by the HudFactions Focused/Known columns) ---- */
/* .focused: the player's focus cursor is on this faction → highlight bar + brighter background. */
.row.focused {
    background-color: #2a3a5ecc;
    border-color: #90c0ff;
}

/* .known: the player has investigated this faction (knowledge ≥ Known) → the row reads as "known"
   (the ✓ glyph in .col-known plus a confident name colour). Unknown rows stay dim. */
.row.known .col-name {
    color: #e0d0b0;
}

.row.known .col-known {
    color: #80e0a0;  /* green ✓ for a known faction */
}

/* .in-lens: this faction is in the active map lens's entity set (HudFactionInLens) → a lens accent on
   the row (a purple left bar tint), distinct from the .focused cursor highlight. */
.row.in-lens {
    border-color: #b090e0;
}

.row.in-lens .col-name {
    color: #d0b8f0;  /* lens-lit name tint */
}

/* ---- Faction columns ---- */
.col-known {
    display: inline-block;
    width: 14px;
    color: #505070;  /* dim '·' until the row is .known */
    font-size: 13px;
}

.col-name {
    display: inline-block;
    width: 116px;
    color: #908060;  /* unknown factions read dim; .row.known brightens the name */
}

.col-value {
    display: inline-block;
    color: #e08060;
}

/* ---- Event columns ---- */
.col-tick {
    display: inline-block;
    width: 50px;
    color: #707090;
    font-size: 13px;
}

.col-kind {
    display: inline-block;
    color: #c0e0ff;
    font-size: 13px;
}
