# Auto-provisioned Vulkan SDK cache (ProvisionVulkan.cmake)
.vulkan-sdk/

# Auto-provisioned X11 windowing dev cache (ProvisionWindowingDeps.cmake)
.windowing-deps/

# Auto-provisioned gdb cache (ProvisionGdb.cmake, VIXEN_AUTO_PROVISION_GDB=ON)
.gdb-deps/

# ponytail: ShaderCacheManagerTest writes a literal Windows-style path on WSL/Linux
# (no drive-letter semantics to reject it) instead of failing as it does on Windows.
# Regenerates every ctest run until that test is fixed to use a portable invalid path.
libraries/ShaderManagement/Z:/

# CMake GoogleTest discovery cache (regenerated per-configure, not authored)
cmake_test_discovery_*.json

