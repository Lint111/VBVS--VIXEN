foreach(_required IN ITEMS SCHEMA_ROOT SYSTEM_ROOT CONFIG_ROOT SUPPORT_ROOT OUTPUT_ROOT)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()

file(REMOVE_RECURSE "${OUTPUT_ROOT}")
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")

function(stage_gpu_schema_root source_root prefix)
    if(NOT IS_DIRECTORY "${source_root}")
        message(FATAL_ERROR "GPU schema source root is missing: ${source_root}")
    endif()
    file(GLOB_RECURSE _sources "${source_root}/*.cs")
    foreach(_source IN LISTS _sources)
        file(RELATIVE_PATH _relative "${source_root}" "${_source}")
        set(_destination "${OUTPUT_ROOT}/${prefix}/${_relative}")
        get_filename_component(_destination_dir "${_destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${_destination_dir}")
        configure_file("${_source}" "${_destination}" COPYONLY)
    endforeach()
endfunction()

stage_gpu_schema_root("${SCHEMA_ROOT}" "schema")
stage_gpu_schema_root("${SYSTEM_ROOT}" "systems")
stage_gpu_schema_root("${CONFIG_ROOT}" "config")
stage_gpu_schema_root("${SUPPORT_ROOT}" "support")
