# Native fixture producer for the editor file-assertion tests.
# execute_process provides the stdout/stderr capture that the Linux producer gets from
# its shell redirection, while remaining valid for a Windows CTest COMMAND (where a bare
# `>` would otherwise be parsed as a separate cmd.exe command).
set(_editor_exe "@VIXEN_EDITOR_TARGET_FILE@")
set(_editor_document "@VIXEN_EDITOR_TEST_DOCUMENT@")
set(_editor_capture_dir "@VIXEN_EDITOR_CAPTURE_DIR@")
if(DEFINED ENV{VIXEN_EDITOR_CAPTURE_DIR} AND NOT "$ENV{VIXEN_EDITOR_CAPTURE_DIR}" STREQUAL "")
    set(_editor_capture_dir "$ENV{VIXEN_EDITOR_CAPTURE_DIR}")
endif()
file(MAKE_DIRECTORY "${_editor_capture_dir}")
execute_process(
    COMMAND "${_editor_exe}" "${_editor_document}"
    WORKING_DIRECTORY "@VIXEN_BINARIES_DIR@"
    OUTPUT_FILE "${_editor_capture_dir}/run_editor_script.log"
    ERROR_FILE "${_editor_capture_dir}/run_editor_script.log"
    RESULT_VARIABLE _editor_result)
if(NOT _editor_result EQUAL 0)
    message(FATAL_ERROR "vixen_editor exited with code ${_editor_result}")
endif()
