# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.sln
*.vcxproj
VIXEN/gatherer_test.txt

# Build output (CMake / Visual Studio / Ninja) — one centralized parent covers every preset's
# binaryDir (build/wsl, build/ninja, build/wsl-debug, ...) so a NEW preset never needs a new
# gitignore entry. Legacy VIXEN/build/ kept for any pre-consolidation local build dirs.
/build/

# Live-gate capture PNGs (Sampled Lighting increments): the SHA256 hash of each capture is
# committed in gate-artifacts/*-hashes.txt as the durable proof; the PNGs themselves stay
# untracked (large, regenerable, one per milestone's before/after render). Gate artifacts
# are captured under VIXEN/gate-artifacts/ in practice, so both locations are covered.
/gate-artifacts/*.png
/VIXEN/gate-artifacts/*.png
/VIXEN/build/

# Local dev helper scripts (machine-specific absolute paths)
/_ninja_*.bat

# Runtime GPU calibration output (device-specific) — repo-root and legacy VIXEN/ locations
/calibration/
/VIXEN/calibration/

# Regenerated SDI headers (build artifacts; intentionally-tracked siblings stay tracked) — repo-root and legacy VIXEN/ locations
/generated/sdi/
/VIXEN/generated/sdi/*
# merged/ SDI headers are COMMITTED artifacts (the sdi_merged_drift_check ctest gates them);
# the blanket ignore above silently swallowed NEW programs' headers (W1a's split headers
# never landed in ec5d1367 — fresh-clone build break). Glob the parent, unignore merged/.
!/VIXEN/generated/sdi/merged/
# Compiled SPIR-V build copies under generated/ (content-addressed, regenerated by shader_tool).
# The source-referenced SDI *headers* (generated/sdi/*.h) and runtime shader assets
# (shaders/*.spv, loaded by path at runtime) are intentionally tracked and stay.
/generated/*.spv
/VIXEN/generated/*.spv

# Crash dumps (e.g. Cygwin/MSYS bash.exe.stackdump)
*.stackdump

# Python bytecode cache
__pycache__/
*.pyc

# Cache directories
.cache/
cache/

# Local settings
*.local.json

# Logs
*.log
log.txt
logs/

# Temporary files
NUL
*.tmp
*.bak
*~

# Agent worktrees (superpowers / EnterWorktree)
.claude/worktrees/

# CodeGraph local index (local tooling, regenerated; indexing is the user's choice)
/.codegraph/

# Codex CLI local config (contains plaintext API keys — never commit)
/.codex/
.codex/config.toml

# Windows-native capability bench rig: scripts tracked, outputs are not
temp_bench/*
!temp_bench/*.bat

# runtime log whose filename literally contains a backslash (Windows path separator bug)
*vulkan_app_log.txt
