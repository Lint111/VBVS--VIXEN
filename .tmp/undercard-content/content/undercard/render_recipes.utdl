// Provisional source rows for the Undercard render_recipe declaration.
//
// Bootstrap is expected to declare this kind with an AssetFilesAt facet that points
// PackRecipeSource at recipes/*.recipe.json (or the flattened .vrc output). These rows
// intentionally avoid core's celestial body_kind: Undercard owns its card/table shape
// vocabulary and must not add a core reference merely to satisfy the old declaration.
namespace undercard {
  type render_recipe

  { id: card-template, provider: procedural, blob: undercard:card-template }
  { id: card-wheat-field, provider: procedural, blob: undercard:card-wheat-field }
  { id: card-hand-mill, provider: procedural, blob: undercard:card-hand-mill }
  { id: card-order-flour-3, provider: procedural, blob: undercard:card-order-flour-3 }
  { id: icon-wheat, provider: procedural, blob: undercard:icon-wheat }
  { id: icon-flour, provider: procedural, blob: undercard:icon-flour }
  { id: table-slab, provider: procedural, blob: undercard:table-slab }
  { id: mat-felt, provider: procedural, blob: undercard:mat-felt }
}
